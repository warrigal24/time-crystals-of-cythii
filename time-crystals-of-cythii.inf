!========================================
! Entry point routines JumpOn
!========================================
[ Amusing;
  "^Have you tried:^* Examining everything in every room, including scenery and the rooms themselves.^* Waiting until the disaster occurs in each time zone, especially in the bakehouse at London and the control room on the Hindenburg.^* Using the magic word XYZZY.^* Putting one of the crystals on the wrong plinth.^^At London:^* Going up the stairs in the shop.^* Putting something in the oven.^* Asking the baker about anything he mentions, such as London, the Royal Navy and the Dutch.^* Taking the lantern, the flames or the smoke.^^On the Titanic:^* Looking through the binoculars on the deck of the Titanic.^* Opening the bottle of champagne.^* Breaking the ice with the axe.^* Climbing the ropes in the gymnasium.^* Jumping on the trampoline at the wrong place.^^At San Francisco:^* Reading all the headlines in the newspaper.^* Asking the little girl about herself and anything interesting she mentions, such as her mummy and daddy.^* Examining the heap of garbage a third time.^* Turning the wheel when you're holding it.^* Giving the banana and the bottle of champagne to the hobo.^* Asking the hobo about himself, the crystals and anything interesting he mentions, such as accountancy, grog, San Francisco and motsa.^* Breaking the crate with the axe or entering it once it's open.^* Eating a banana.^^At Krakatoa:^* Chopping down the palm tree before taking the coconut.^* Taking the bird's nest.^* Cutting the coconut with the axe.^* Sitting on the log before pushing it over the cliff.^* Giving the coconut to the monkey.^* Taking the monkey.";
];

[ ChooseObjects obj code;
  if (code == 2)
  {
    ! Stage 1: Disambiguation
    if (action_to_be == ##Drop && obj in player && obj hasnt worn)
      return 1; !Appropriate
    if (action_to_be == ##JumpOn or ##JumpOver && obj in location)
      return 1; !Appropriate
    if (action_to_be == ##Take && obj notin player)
      return 1; !Appropriate
    return 0; !Inappropriate
  }
  ! Stage 2: Processing an "all"
  if (obj has scenery or concealed or static or animate)
    return 2; !Force exclusion
!  if (action_to_be == ##Take && obj ~= player && obj notin player)
!    return 1; !Force inclusion
!  if (action_to_be == ##Drop && obj in player && obj hasnt worn)
!    return 1; !Force inclusion
  return 0; !Accept parser's decision
];

[ GamePreRoutine;
  #Ifdef OPTIONAL_FULL_DIRECTIONS;
  if (selected_direction == ne_to or nw_to or se_to or sw_to)
    "There are no diagonal directions in this game.";
  #Endif;
  if (selected_direction_index == DIRECTION_COUNT + 1)
  {
    print "Please use ";
    if (ship_directions_enabled)
      "nautical directions (F, A, P, S).";
    else
      "compass directions (N, S, E, W).";
  }
  rfalse;
];

[ InScope person i;
  if (person == player && location == thedark)
    objectloop(i in parent(player))
      if (i has moved)
        PlaceInScope(i);
  rfalse;
];

[ LibraryMessages p_msg p_arg_1 p_arg_2;
  switch (p_msg)
  {
    MSG_CLOSE_NOT_OPEN:
      print_ret (CTheyreOrIts)noun, " already closed.";
    MSG_LOCK_ALREADY_LOCKED:
      print_ret (CTheyreOrIts)noun, " already locked.";
    MSG_LOCK_CLOSE_FIRST:
      "You'll have to close ", (ItOrThem)noun, " first.";
    MSG_LOCK_KEY_DOESNT_FIT:
      print_ret (The)second, " ", (DoesntOrDont)second, " fit the lock.";
    MSG_UNLOCK_ALREADY_UNLOCKED:
      print_ret (CTheyreOrIts)noun, " already unlocked.";
    MSG_UNLOCK_KEY_DOESNT_FIT:
      print_ret (The)second, " ", (DoesntOrDont)second, " fit the lock.";
    MSG_INVENTORY_DEFAULT:
      p_arg_1 = "You're carrying ";
      if (inventory_style == 0)
      {
        p_arg_1 = "You're carrying:";
        p_arg_2 = NEWLINE_BIT;
      }
      if (PrintContents(p_arg_1, player, p_arg_2))
      {
        if (inventory_style)
          print ".^";
        ShowTutorial(TUT_EXAMINE_WATCH);
        rtrue;
      }
      rfalse;
    MSG_TAKE_NO_CAPACITY:
      print "Your hands are full.^";
      ShowTutorial(TUT_INVENTORY_FULL);
      rtrue;
    MSG_SMELL_DEFAULT:
      if (location has on_krakatoa)
        "When you smell the acrid smoke-filled air, it burns your throat.";
      "You smell nothing unexpected.";
    MSG_TAKE_BELONGS:
      ! p_arg_1 is the object held by p_arg_2
      print (The)p_arg_1, " seem";
      if (p_arg_1 hasnt pluralname)
        print "s";
      print_ret " to belong to ", (the) p_arg_2, ".";
    MSG_TAKE_PART_OF:
      ! p_arg_1 is the object that's part of p_arg_2
      print (The)p_arg_1, " seem";
      if (p_arg_1 hasnt pluralname)
        print "s";
      print_ret " to be part of ", (the) p_arg_2, ".";
  }
  p_arg_1 = p_arg_2;
];

[ LookRoutine;
  if (~~tutorial)
    return;
  if (location has visited)
    return;
  if (location == room01)
    ShowTutorial(TUT_LOOK);
  return;
];

[ NewRoom;
  if (monkey has general && monkey notin limbo)
  {
    if (location == room02)
    {
      print "The monkey stays behind.^^";
      rfalse;
    }
    if (location == room34 && monkey in location)
    {
      print "The monkey is here to greet you.^^";
      rfalse;
    }
    if (location has on_krakatoa)
    {
      move monkey to location;
      print "The monkey follows you.^^";
      rfalse;
    }
  }
];

Include "puny.h";

!========================================
! Initialisation
!========================================
[ Initialise;
  date = TIME_TOWER;
  Directions.parse_name = DirectionsParseName;
  location = room01;
  lookmode = 2;
  move watch to player;
  no_implicit_actions = true;
  player.description = "You're a slender, elf-like youth named Jelro. You're the son of Vemnev and Mairgol, and your family is responsible for protecting the Time Crystals of Cythii to maintain the stability of time.";
  ship_directions_enabled = false;
  SetTime(540, 1);
  StartDaemon(room01);
  print "For generations, your family have been the guardians of ", (string)THE_TIME_CRYSTALS_OF_CYTHII, ". It's a pretty cushy job. All you have to do is prevent the crystals from being stolen, but no one would be stupid enough to steal them or the stability of time would be torn to shreds.^^Unfortunately, the unthinkable has happened.^^While your parents were out doing the shopping, you were left in charge. You must have dozed off and someone snuck into the time tower and stole the crystals. This has resulted in time warps appearing all over time in the worst possible places. You can't even travel through the time tower without being warped to a different time period.^^It's your duty to find the crystals and return them to their rightful place before your parents get home, or you will be in big, big trouble!^^";
  print_ret (italic)"[You're about to embark on an adventure. You can move around, examine things and manipulate things by typing simple text commands of one or more words, usually starting with a verb. The tutorial will offer suggestions to get you started. Commands in the tutorial are shown in upper case, but you can enter them in lower case, if you prefer. You can turn the tutorial off by typing TUTORIAL OFF and turn it back on by typing TUTORIAL ON. Good luck.]^";
];

!========================================
! Classes
!========================================
Class OpenableContainer
with
  invent
  [;
    if (inventory_stage == 2 && (self hasnt open || child(self) == 0))
      rtrue;
  ],
has;

Class OpenContainer
with
  invent
  [;
    if (inventory_stage == 2 && child(self) == 0)
      rtrue;
  ],
has;

!========================================
! Inventory
!========================================
!----------------------------------------
! Watch
!----------------------------------------
Object watch "watch"
with
  name 'watch' 'grandfather^s',
  description
  [;
    tutorial_shown = 1;!Prevent next tutorial clue
    print "It's an unusual watch that was handed down to you by your grandfather. It tells both the date and the time. The current date is ";
    switch (date)
    {
      TIME_TOWER: print "Thursday, 1 May 2025";
      LONDON: print "Sunday, 2 September 1666";
      KRAKATOA: print "Monday, 27 August 1883";
      SAN_FRANCISCO: print "Wednesday, 18 April 1906";
      TITANIC: print "Monday, 15 April 1912";
      HINDENBURG: print "Thursday, 6 May 1937";
      }
    print " and the time is ", (TimeOfDay)self, "^";
    ShowTutorial(TUT_DATE);
    rtrue;
  ],
  before
  [;
    Disrobe:
      "You don't dare remove your grandfather's watch, as you'd be worried about losing it. Apart from which, you'll need it to work out the date during your travels through time.";
    Read:
      <<Examine self>>;
  ],
has clothing worn;


!========================================
! Room 1: Domed Room
!========================================
Object room01 "Domed Room"
with
  description "You're in a circular room with a domed ceiling and walls lined with pure white marble. You can't see any joins in the marble. This gives the impression that it was carved from a single piece of solid rock. The only thing to mar the surface is an inscription at waist height running around the circumference of the room. There are no signs of any exits, apart from a stairway leading down.",
  d_to room02,
  before
  [;
    Hint:
      if (~~tutorial)
        "Type TUTORIAL ON and follow the suggestions in the tutorial.";
      if (room02 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "down the stairs yet.";
      "Find all ", (string)THE_TIME_CRYSTALS_OF_CYTHII, " and place them on their plinths.";
  ],
  daemon
  [;
    if (action == ##Help or ##Hint)
      return;
    if (tutorial)
    {
      if (tutorial_shown == 0)
        ShowTutorial(TUT_EXAMINE_ME);
      if (tutorial_shown == 0)
        ShowTutorial(TUT_INVENTORY);
      if (tutorial_shown == 0 && location == room01)
        ShowTutorial(TUT_EXAMINE);
      if (tutorial_shown == 0 && location == room01)
        ShowTutorial(TUT_MOVEMENT);
      if (tutorial_shown == 0)
      {
        ShowTutorial(TUT_HELP_HINT);
        StopDaemon(self);
      }
      tutorial_shown = 0;
    }
  ],
has light;

!----------------------------------------
! Domed room
!----------------------------------------
Object "domed room" room01
with
  name 'circular' 'domed' 'room' 'dome' 'ceiling' 'pure' 'white' 'marble' 'wall' 'walls' 'surface',
  description
  [;
    tutorial_shown = 1;!Prevent next tutorial clue
    "The ceiling and walls of the room are lined with pure white marble. The glare from the marble is quite dazzling and it's your job to keep it clean so that it stays that way, otherwise you don't get any pocket money.";
  ],
has scenery;

!----------------------------------------
! Inscription
!----------------------------------------
Object inscription "inscription" room01
with
  article AN,
  name 'inscription' 'script',
  description
  [;
    tutorial_shown = 1;!Prevent next tutorial clue
    print "The inscription is carved into the marble in a single continuous line that surrounds the room. It's written in an ancient Cythii script. Fortunately for you, you can read this script, as you're quite fluent in many ancient and foreign languages.^";
    ShowTutorial(TUT_READ);
    rtrue;
  ],
  before
  [;
    Read:
      tutorial_shown = 1;!Prevent next tutorial clue
      print_ret "When translated, it reads, 'Whomsoever removes ", (string)THE_TIME_CRYSTALS_OF_CYTHII, " from this room shall break the balance of time and be doomed to eternal damnation. Should the crystals be removed, whomsoever returns them shall restore the balance of time and be blessed for eternity.'";
  ],
has scenery;

!----------------------------------------
! Stairway (floating object
!----------------------------------------
Object "stairway"
with
  name 'stairway' 'stair' 'stairs' 'staircase',
  description
  [;
    tutorial_shown = 1;!Prevent next tutorial clue
    print "It's a stone staircase that leads ";
    if (self in room01)
      print "down";
    else
      print "up";
    " to the next level of the time tower.";
  ],
  before
  [;
    Climb, Enter:
      if (self in room01)
        <<Go FAKE_D_OBJ>>;
      else
        <<Go FAKE_U_OBJ>>;
  ],
  found_in room01 room02,
has scenery;

!----------------------------------------
! Red plinth
!----------------------------------------
Object red_plinth "red plinth" room01
with
  name 'red' 'plinth' 'plinths//p' 'carved' 'marble' 'white' 'streaks',
  description
  [;
    tutorial_shown = 1;!Prevent next tutorial clue
    print (string)THIS_IS_MARBLE_PLINTH, "characterised by three different tones of red with white streaks. The top surface is highly polished with an oval depression";
    if (red_crystal in self)
      " that contains a red crystal.";
    print ".^";
    ShowTutorial(TUT_PUT_CRYSTAL);
    rtrue;
  ],
  before
  [;
    Receive:
      if (child(self) ~= 0)
        "There's already ", (a)child(self), " on the red plinth.";
      if (noun == green_crystal or blue_crystal)
        print_ret (string)PLINTH_EMITS_SPARKS;
      if (noun ~= red_crystal)
        print_ret (The)noun, (string)WOULD_BE_OUT_OF_PLACE_ON, "red plinth.";
  ],
  after
  [;
    Receive:
      print (string)YOU_CAREFULLY_PLACE, "red crystal on the red plinth.^";
      CheckCrystals();
      rtrue;
  ],
has supporter static;

!----------------------------------------
! Green plinth
!----------------------------------------
Object green_plinth "green plinth" room01
with
  name 'deep' 'green' 'plinth' 'plinths//p' 'carved' 'marble' 'black' 'pigmentations',
  description
  [;
    tutorial_shown = 1;!Prevent next tutorial clue
    print (string)THIS_IS_MARBLE_PLINTH, "of deep green intermingled with black pigmentation. The top surface is highly polished with an oval depression";
    if (green_crystal in self)
      " that contains a green crystal.";
    print ".^";
    ShowTutorial(TUT_PUT_CRYSTAL);
    rtrue;
  ],
  before
  [;
    Receive:
      if (child(self) ~= 0)
        "There's already ", (a)child(self), " on the green plinth.";
      if (noun == red_crystal or blue_crystal)
        print_ret (string)PLINTH_EMITS_SPARKS;
      if (noun ~= green_crystal)
        print_ret (The)noun, (string)WOULD_BE_OUT_OF_PLACE_ON, "green plinth.";
  ],
  after
  [;
    Receive:
      print (string)YOU_CAREFULLY_PLACE, "green crystal on the green plinth.^";
      CheckCrystals();
      rtrue;
  ],
has supporter static;

!----------------------------------------
! Blue plinth
!----------------------------------------
Object blue_plinth "blue plinth" room01
with
  name 'non-uniform' 'blue' 'plinth' 'plinths//p' 'carved' 'marble' 'yellow' 'white' 'veins',
  description
  [;
    tutorial_shown = 1;!Prevent next tutorial clue
    print (string)THIS_IS_MARBLE_PLINTH, "with a non-uniform blue surface, black intrusions, and yellow and white veins. You know that blue marble is rare. The top surface is highly polished with an oval depression";
    if (blue_crystal in self)
      " that contains a blue crystal.";
    print ".^";
    ShowTutorial(TUT_PUT_CRYSTAL);
    rtrue;
  ],
  before
  [;
    Receive:
      if (child(self) ~= 0)
        "There's already ", (a)child(self), " on the blue plinth.";
      if (noun == red_crystal or green_crystal)
        print_ret (string)PLINTH_EMITS_SPARKS;
      if (noun ~= blue_crystal)
        print_ret (The)noun, (string)WOULD_BE_OUT_OF_PLACE_ON, "blue plinth.";
  ],
  after
  [;
    Receive:
      print (string)YOU_CAREFULLY_PLACE, "blue crystal on the blue plinth.^";
      CheckCrystals();
      rtrue;
  ],
has supporter static;

!----------------------------------------
! Depression
!----------------------------------------
Object "depression" room01
with
  name 'depression' 'oval' 'top' 'surface',
  description
  [;
    tutorial_shown = 1;!Prevent next tutorial clue
    "There's a depression on each of the plinths. That's where you need to put the missing time crystals.";
  ],
  before
  [;
    Insert, Receive:
      if (noun == red_crystal or green_crystal or blue_crystal)
        "You need to put the crystal on the appropriate plinth, e.g. PUT RED CRYSTAL ON RED PLINTH.";
  ],
has scenery;

!----------------------------------------
! Cleaning cloth
!----------------------------------------
Object cloth "cleaning cloth" room01
with
  name 'cleaning' 'cloth',
  description
  [;
    print "This is the cloth you were using to clean the marble dome before you fell asleep.^";
    if (self notin player)
      ShowTutorial(TUT_TAKE);
    rtrue;
  ],
  after
  [;
    Take:
      PrintMsg(MSG_TAKE_DEFAULT);
      ShowTutorial(TUT_DROP);
      rtrue;
  ],
has;

!========================================
! Room 2: Time Tower of Cythii
!========================================
Object room02 "Time Tower of Cythii"
with
  description "You're in the stone tower that you know intimately as the Time Tower of Cythii. A strange mist swirls around the tower. That's not normal. As the mist moves around, you catch a glimpse of openings to the north, south, east and west, as well as an opening in the floor that leads further down the tower. The only part of the tower not affected by the strange mist is the stairway leading up.",
  n_to !Krakatoa
  [;
    save_time = the_time;
    date = KRAKATOA;
    SetTime(249, 1); !4:09 a.m.
    StartDaemon(room34);
    print (string)TIME_WARP;
    ShowTutorial(TUT_SAVE);
    return room34;
  ],
  s_to !Titanic
  [;
    save_time = the_time;
    date = TITANIC;
    SetTime(89, 1); !1:29 a.m.
    StartDaemon(room06);
    ship_directions_enabled = true;
    print (string)TIME_WARP;
    ShowTutorial(TUT_SAVE);
    print (italic)"[Use nautical directions (F, A, P, S) on the ship.]^^";
    return room06;
  ],
  e_to !London
  [;
    save_time = the_time;
    date = LONDON;
    SetTime(14, 1); !12:14 a.m.
    StartDaemon(room03);
    remove coal;
    give smoke absent;
    give flames absent;
    move baker to room05;
    move lantern to workbench;
    print (string)TIME_WARP;
    ShowTutorial(TUT_SAVE);
    return room03;
  ],
  w_to !San Francisco
  [;
    save_time = the_time;
    date = SAN_FRANCISCO;
    SetTime(261, 1); !4:21 a.m.
    StartDaemon(room20);
    print (string)TIME_WARP;
    ShowTutorial(TUT_SAVE);
    return room20;
  ],
  d_to !Hindenburg
  [;
    save_time = the_time;
    date = HINDENBURG;
    SetTime(1124, 1); !6:44 p.m.
    StartDaemon(room31);
    ship_directions_enabled = true;
    print (string)TIME_WARP;
    ShowTutorial(TUT_SAVE);
    print (italic)"[Use nautical directions (F, A, P, S) on the airship.]^^";
    return room31;
  ],
  u_to room01,
  before
  [;
    Hint:
      print "There are lots of exits here. ";
      if (room03 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "east yet.";
      if (room06 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "south yet.";
      if (room20 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "west yet.";
      if (room31 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "down yet.";
      if (room34 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "north yet.";
      "Do you have any unsolved puzzles in any of the time zones? If so, visit that time zone and try HINT there. Otherwise, pick an exit at random and explore more to see if you've missed something.";
  ],
has light;

!----------------------------------------
! Tower
!----------------------------------------
Object "tower" room02
with
  name 'time' 'tower' 'of' 'cythii' 'stone' 'granite',
  description "This part of the tower is lined with stone, probably granite, rather than marble.",
has scenery;

!----------------------------------------
! Opening
!----------------------------------------
Object "opening" room02
with
  name 'opening' 'openings',
  description "The openings appear and disappear as the strange mist swirls around the room.",
has scenery;

!----------------------------------------
! Strange mist (floating object)
!----------------------------------------
Object "strange mist"
with
  name 'strange' 'mist' 'fog',
  description "The strange mist has an eerie yellow glow, like something out of this world.",
  before
  [;
    Enter:
      if (self in room03)
        <<Go FAKE_W_OBJ>>;
      if (self in room06)
        <<Go FAKE_N_OBJ>>;
      if (self in room20)
        <<Go FAKE_E_OBJ>>;
      if (self in room31)
        <<Go FAKE_U_OBJ>>;
      if (self in room34)
        <<Go FAKE_S_OBJ>>;
      "The mist swirls all around you. You'll need to specify which direction to go.";
    Touch:
      print_ret (string)YOUR_HAND_PASSES_THROUGH, "mist, but it feels noticeably colder.";
  ],
  found_in room02 room03 room06 room20 room31 room34,
has scenery;

!========================================
! Room 3: Lane
!========================================
Object room03 "Lane"
with
  description
  [;
    if (self hasnt visited)
      print "It's the middle of the night and everything is quiet. There's a chill in the air accompanied by a southerly breeze that brings a smell of animal offal.^^";
    "You're in a dark lane. It's very late and there's no one around. It looks like everyone has gone to bed. There's a dimly-lit shop to the east and a strange mist to the west.";
  ],
  e_to room04,
  w_to
  [;
    date = TIME_TOWER;
    SetTime(save_time, 1);
    StopDaemon(self);
    print (string)TIME_WARP;
    return room02;
  ],
  in_to room04,
  before
  [;
    Hint:
      if (hanging_sign hasnt general)
        print_ret (string)NEED_TO_WORK_OUT_WHERE, "Examine the hanging sign and do what it suggests.";
      if (room04 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "east yet.";
      if (bread in nothing)
        "Did you leave the shop empty-handed? Perhaps you missed something.";
      if (the_time > 47)
        print_ret (string)GET_OUT_OF_HERE;
    Smell:
      if (noun == nothing)
      {
        if (smoke in self)
          print_ret (string)YOU_SMELL_SMOKE;
        else
          "There's a horrible smell of animal offal coming from the docks to the south.";
      }
  ],
  daemon
  [;
    if (the_time < 45)
      rfalse;
    switch (the_time)
    {
      44: !12:44 a.m.
        if (location == room05)
          "^The baker turns to you and says, ~If ya don't mind, I gotta rake the coals ta make sure the fire's out.~";
      45: !12:45 a.m.
        move coal to room05;
        if (location == room05)
          "^As the baker rakes the coals, a large chunk of hot coal rolls across the floor, leaving sparks in its wake. It stops under the pile of firewood, but he doesn't seem to notice.";
      46: !12:46 a.m.
        if (location == room05)
          "^You try to tell the baker that there's a hot coal under the firewood, but he just says, ~Go away. Can't ya see I'm busy.~";
      47: !12:47 a.m.
        give smoke ~absent;
        MoveFloatingObjects();
        if (location == room05)
          "^The hot coal starts to burn the firewood. The baker pauses for a moment. ~What's that smell?~";
         else
           "^You here a voice to the east.";
      48: !12:48 a.m.
        give flames ~absent;
        MoveFloatingObjects();
        if (location == room05)
          "^It's been a long, dry summer. The city has been suffering a drought and all the wood is particularly dry. All of a sudden, the pile of firewood bursts into flames. ~Holy Mary! Get out of 'ere if ya don't wanna be burnt toast!~";
        else
          "^You hear a scream from the east.";
      49: !12:49 a.m.
        if (location == room05)
          "^Smoke starts billowing from the fire as the baker tries to stamp it out. You try to help, but you only get in the way.";
        else
          "^You smell smoke coming from the east.";
      50: !12:50 a.m.
          "^The smoke is getting thicker and quickly spreads.";
      51: !12:51 a.m.
        if (location == room05)
          "^The flames are out of control and the smoke is getting worse. It's hard to breathe.";
        else
          "^The smoke is getting worse.";
      52: !12:51 a.m.
        if (location == room05)
          print_ret (string)ALL_OF_A_SUDDEN_YOUNGER_MAN, "bursts into the bakehouse. ~What's goin' on, Thomas?~^^~Are ya blind? The friggin' firewood caught fire. Go back upstairs, wake everyone up and get 'em outta the house! Quick!~ The younger man runs out of the bakehouse.";
        if (location == room04)
          print_ret (string)ALL_OF_A_SUDDEN_YOUNGER_MAN, "runs down the stairs and into the doorway to the east. A moment later, he returns and runs up the stairs.";
        else
          print_ret (string)HEAR_COMMOTION_TO_EAST;
      53: !12:53 a.m.
        if (location == room05)
          "^The baker yells, ~If ya knows what's good for ya, get outta the house before she goes up in flames.~";
        else
          "^The smoke is followed by flames from a fire.";
      54: !12:54 a.m.
        remove baker;
        remove lantern;
        if (location == room05)
          "^The baker grabs the lantern and runs off, leaving you alone with the flames. You'd better follow his advice.";
        if (location == room04)
          "^An older man carrying a lantern runs into the shop from the east, then runs up the stairs.";
        else
          print_ret (string)HEAR_COMMOTION_TO_EAST;
      55 to 56: !12:55 to 12:58 a.m.
          "^The fire is getting worse.";
      57 to 59: !12:59 a.m.
          "^If you don't get out, you'll be engulfed by flames. ", (string)YOUD_BETTER_GET_BACK;
      60: !1:00 a.m.
        deadflag = 1;
        "^The baker's shop erupts in a ball of flame and you're caught in the inferno. You should have gotten out of London while you had the chance.^^Most of the others in the bakery escaped by climbing from an upstairs window to the house next door. The maidservant was too frightened to try and she became the first victim of the Great Fire of London. Actually, you were the first victim, but your body was burnt beyond recognition and wasn't found amongst the smouldering ruins in the weeks that followed.";
    }
  ],
has light;

!----------------------------------------
! Pudding Lane
!----------------------------------------
Object "lane" room03
with
  name 'pudding' 'lane' 'dark' 'cobble' 'cobbles' 'cobblestone' 'cobblestones',
  description "It's a cobblestone lane. The cobbles look damp, perhaps due to the strange mist to the west.",
has proper scenery;

!----------------------------------------
! Shop (floating object)
!----------------------------------------
Object "shop"
with
  name 'dimly-lit' 'dimly' 'lit' 'shop' 'bakery',
  description
  [;
    if (self in room03)
      "When you look through the window, you can see that the shop is dimly lit, but you can't see the source of the light. The shop appears to be a bakery, as there are loaves of bread on display behind the window.";
    else
      "Now that you're inside the shop, you can clearly see that it's a bakery. The loaves of bread inside the window attest to that.";
  ],
  before
  [;
    Enter:
      if (self in room03)
        <<Go FAKE_E_OBJ>>;
    Exit:
      if (self in room04)
        <<Go FAKE_W_OBJ>>;
  ],
  found_in room03 room04,
has scenery;

!----------------------------------------
! Window (floating object)
!----------------------------------------
Object "window"
with
  name 'window',
  description
  [;
    print "You can see loaves of bread on display ";
    if (self in room03)
      print "on the other side of";
    else
      print "inside";
    " the window.";
  ],
  found_in room03 room04,
has scenery;

!----------------------------------------
! Loaves of bread
!----------------------------------------
Object "loaves of bread" room03
with
  name 'loaf' 'loaves' 'of' 'bread',
  description "They're only on display to entice customers inside, so they're probably stale.",
  before
  [;
    if (action ~= ##Examine)
      "The loaves of bread are on the other side of the window.";
  ],
has pluralname scenery;

!----------------------------------------
! Entrance
!----------------------------------------
Object "entrance" room03
with
  name 'entrance',
  description "The entrance is open, so you can go inside. Maybe it's late-night shopping.",
has scenery;

!----------------------------------------
! Hanging sign
!----------------------------------------
Object hanging_sign "hanging sign" room03
with
  name 'painted' 'hanging' 'wooden' 'sign',
  description
  [;
    print "It's a painted wooden sign hanging over the entrance to the shop.";
    if (self hasnt general)
      print " It wouldn't hurt to read it.";
    "";
  ],
  before
  [;
    Read:
      give self general;
      print "The sign says, 'Thomas Farriner's Bakery, Est. 1649'.^^Your history lessons come flooding back. That was the bakery where the Great Fire of London started on 2 September 1666. You glance at your watch. Oh, no! That's today! Historians believe the fire broke out about 1:00 a.m., so you'd better get out of here before then.^";
      ShowTutorial(TUT_TIME_LEFT);
      rtrue;
  ],
has static;

!----------------------------------------
! Street lamp
!----------------------------------------
Object "street lamp" room03
with
  name 'primitive' 'street' 'lamp',
  description "It's a primitive lamp lit by a tallow candle. The dull yellow glow from the lamp reflects off the damp cobblestones and illuminates a sign on the wall to the east.",
has static;

!----------------------------------------
! Tallow candle
!----------------------------------------
Object "tallow candle" room03
with
  name 'tallow' 'candle',
  description "It's a candle made from the tallow sourced from local butchers. The candles are lit by a lamplighter who tours the town at dusk.",
has scenery;

!----------------------------------------
! Street sign
!----------------------------------------
Object "street sign" room03
with
  name 'street' 'sign' 'black' 'white' 'enamel' 'wall',
  description
  [;
    print "There's a black and white enamel street sign nailed to the wall beside the shop.";
    if (self hasnt general)
      print " Perhaps you should read it to see where you are.";
    "";
  ],
  before
  [;
    Read:
      give self general;
      print "It says, 'Pudding Lane, London'. ";
      if (hanging_sign hasnt general)
        "That name rings a bell for some reason.";
      else
        "Yes, that confirms it. This was the location where the Great Fire of London started.";
  ],
has static;

!----------------------------------------
! Smoke (floating object)
!----------------------------------------
Object smoke "smoke"
with
  article SOME,
  name 'smoke',
  description "The smoke is very thick and getting thicker by the minute. It's hard to breathe.",
  before
  [;
    Take:
      print_ret (string)YOUR_HAND_PASSES_THROUGH, "smoke and some of it goes down your throat. Cough, cough, splutter!";
  ],
  found_in
  [;
    if (location == room05 && the_time > 46)
      rtrue;
    if (location == room03 or room04 && the_time > 48)
      rtrue;
  ],
has absent static;

!----------------------------------------
! Flames (floating object)
!----------------------------------------
Object flames "flames"
with
  article SOME,
  name 'flames' 'fire',
  description "The flames have taken hold and are getting worse by the minute.",
  before
  [;
    Take:
      "It's more likely that the flames will take you if you don't get out of here.";
  ],
  found_in
  [;
    if (location == room05 && the_time > 47)
      rtrue;
    if (location == room03 or room04 && the_time > 52)
      rtrue;
  ],
has absent static;

!========================================
! Room 4: Shop
!========================================
Object room04 "Shop"
with
  description "You're inside a shop that has the distinctive aroma of baked bread. As it's late at night and no one's around, that aroma is probably lingering from the previous day's baking. There are loaves of bread in the front window and other pastries under the counter. Some light shines in from an open doorway to the east and a flight of stairs goes up to the living quarters. When you've finished here, you can leave the shop to the west.",
  e_to room05,
  w_to room03,
  u_to "That no doubt leads to the living quarters, which are private. You shouldn't invade the private space of the inhabitants, unless you've been invited. Apart from which, it's dark up there.",
  in_to room05,
  out_to room03,
  before
  [;
    Hint:
      if (bread in nothing)
        "~Take us this day our daily bread.~";
      if (room05 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "east yet.";
      if (the_time > 47)
        print_ret (string)GET_OUT_OF_HERE;
      "Don't bother going up the stairs. Your path lies elsewhere.";
    Smell:
      if (second == nothing)
      {
        if (smoke in self)
          print_ret (string)YOU_SMELL_SMOKE;
        else
          print_ret (string)YOU_SMELL_BREAD;
      }
  ],
has light;

!----------------------------------------
! Stairs
!----------------------------------------
Object "stairs" room04
with
  name 'flight' 'of' 'stairs' 'steps',
  description "The stairs probably lead up to the owner's living quarters.",
  before
  [;
    Climb:
      <<Go FAKE_U_OBJ>>;
  ],
has scenery;

!----------------------------------------
! Doorway
!----------------------------------------
Object "doorway" room04
with
  name 'doorway' 'light',
  description "It's to the east. Why don't you go there?",
has scenery;

!----------------------------------------
! Loaves of bread
!----------------------------------------
Object "loaves of bread" room04
with
  parse_name
  [ nw i flag;
    nw = NextWord();
    while (nw == 'loaves' or 'of' or 'stale' or 'bread')
    {
      i++;
      if (nw == 'of' or 'stale' or 'bread')
        flag++;
      nw = NextWord();
    }
    if (i == flag)
      return 0;
    return i;
  ],
  before
  [;
    Examine:
      <<Examine dummy_bread>>;
    Take:
      if (bread notin nothing)
        <<Take dummy_bread>>;
      else
        "You can't take them all. Try taking one loaf.";
  ],
has pluralname scenery;

!----------------------------------------
! Dummy loaf of bread
!----------------------------------------
Object dummy_bread "loaf of bread" room04
with
  name 'one' 'loaf' 'of' 'stale' 'bread',
  parse_name
  [;
    if (TestScope(bread))
      return 0;
    else
      return -1;
  ],
  description "The loaves of bread are on display to entice customers inside. They look like they're stale, so they're probably not the source of the baked-bread aroma.",
  before
  [;
    Take:
      if (bread notin nothing)
        "You've already taken one. The rest look too stale.";
      if (children(player) == MAX_CARRIED)
      {
        PrintMsg(MSG_TAKE_NO_CAPACITY);
        rtrue;
      }
      move bread to player;
      PronounNotice(bread);
      "You sort through the loaves of bread and take one that doesn't feel too stale.";
  ],
has scenery;

!----------------------------------------
! Loaf of bread
!----------------------------------------
Object bread "loaf of bread"
with
  name 'one' 'loaf' 'of' 'stale' 'bread',
  description "It's a loaf of stale bread. You'd have to be pretty desperate to want to eat it.",
  before
  [;
    Eat:
      "Did you examine it? It's stale. You're not that desperate for a feed.";
  ],
has edible;

!----------------------------------------
! Counter
!----------------------------------------
Object counter "counter" room04
class OpenContainer
with
  name 'counter',
  description
  [;
    print "The owner would no doubt stand behind the counter to serve his customers when the shop is open, but he's not around to do that at the moment. ";
    <<Search self>>;
  ],
  before
  [;
    LookUnder:
      "There are pastries under the counter.";
  ],
has static supporter;

!----------------------------------------
! Pastries
!----------------------------------------
Object "pastries" room04
with
  name 'pastry' 'pastries',
  description "There are several pastries under the counter where you can't get to them.",
  before
  [;
    Take:
      "They're under the counter where you can't get to them, so leave them alone.";
  ],
has pluralname scenery;

!========================================
! Room 5: Bakehouse
!========================================
Object room05 "Bakehouse"
with
  description "This is the bakehouse at the back of the shop and is clearly where all the baking is done. When you've finished exploring here, you can leave to the west.",
  w_to room04,
  out_to room04,
  before
  [;
    Hint:
      if (the_time > 47)
        print_ret (string)GET_OUT_OF_HERE;
      if (baker hasnt proper)
        "Talk to the baker to find out who he is.";
      "Ask the baker about various things related to himself, his shop and his occupation.";
    Smell:
      if (noun == nothing)
      {
        if (smoke in self)
          print_ret (string)YOU_SMELL_SMOKE;
        else
          print_ret (string)YOU_SMELL_BREAD;
      }
  ],
has light;

!----------------------------------------
! Bakehouse
!----------------------------------------
Object "bakehouse" room05
with
  name 'bakehouse' 'bakery' 'baking' 'tools',
  description
  [;
    "The bakehouse is dominated by a large oven, a workbench and various baking tools that aren't important in your quest for ", (string)THE_TIME_CRYSTALS_OF_CYTHII, ".";
  ],
has scenery;

!----------------------------------------
! Oven
!----------------------------------------
Object "oven" room05
with
  article AN,
  parse_name
  [ nw i flag;
    nw = NextWord();
    while (nw == 'oven' or 'large' or 'wood-fired' or 'wood' or 'fired' or 'brick' or 'baking' or 'fire' or 'chamber')
    {
      i++;
      if (nw == 'wood')
        flag++;
      if (nw == 'fire' && flames in location)
        flag++;
      nw = NextWord();
    }
    if (i == flag)
      return 0;
    return i;
  ],
  description "It's a large, wood-fired brick oven that's used for baking breads and pastries. It has a baking chamber at the top with a fire chamber below it. This provides better heat control and even cooking.",
  before
  [;
    Open:
      "There's no door on the oven. The baking chamber is open so that you can keep an eye on the bread as it cooks.";
    Receive:
      "The oven is meant for baking bread. It's not a place for you to store all your junk.";
  ],
has static;

!----------------------------------------
! Workbench
!----------------------------------------
Object workbench "workbench" room05
class OpenContainer
with
  name 'workbench' 'wooden' 'bench',
  description
  [;
    print "It's a plain wooden workbench covered in flour. ";
    <<Search self>>;
  ],
has static supporter;

!----------------------------------------
! Lantern
!----------------------------------------
Object lantern "lantern" workbench
with
  name 'oil' 'lantern',
  description "It's an oil lantern that emits a dull yellow glow.",
  before
  [;
    Take:
      if (smoke in location)
        "You can't get to it because of the smoke.";
      "Youch! The lantern is hot. The baker yells out, ~Oi, 'ands off me lantern. I can't work in the dark.~";
    Touch:
      "Youch! It's hot, very hot! Don't pick it up!";
  ],
has light;

!----------------------------------------
! Flour
!----------------------------------------
Object "flour" room05
with
  name 'flour',
  description "There's flour all over the place - on the baker's apron, on the workbench and in the sacks. Perhaps you should examine them individually.",
has scenery;

!----------------------------------------
! Pile of firewood
!----------------------------------------
Object "pile of firewood" room05
with
  name 'firewood' 'wood' 'stack' 'pile' 'of',
  description
  [;
    print "It's a large pile of firewood that's no doubt used to fuel the oven";
    if (the_time > 46)
      print ", or it would if it wasn't on fire";
    ".";
  ],
  before
  [;
    LookUnder:
      if (coal in location)
      {
        print "There's a glowing hot coal under there";
        if (the_time > 46)
          print ", but you can't get to it because of the fire";
        ".";
      }
    Take:
      print "What on earth are you going to do with a pile of firewood";
      if (the_time > 46)
        print ", especially when it's on fire";
      "?";
  ],
has static;

!----------------------------------------
! Hot coal
!----------------------------------------
Object coal "hot coal"
with
  name 'hot' 'coal' 'coals',
  description "It's glowing orange.",
  before
  [;
    Take:
      print "It's under the firewood, where you can't get to it. ";
      if (the_time < 47)
        "It's too hot to take, anyway.";
      else
        "The fire prevents you, anyway.";
  ],
has scenery;

!----------------------------------------
! Sacks of flour
!----------------------------------------
Object "sacks of flour" room05
with
  parse_name
  [ nw i flag;
    nw = NextWord();
    while (nw == 'sack' or 'sacks' or 'of' or 'flour' or 'crude' or 'hessian')
    {
      i++;
      if (nw == 'flour')
        flag++;
      nw = NextWord();
    }
    if (i == flag)
      return 0;
    return i;
  ],
  description "They're crude hessian sacks full of flour.",
  before
  [;
    Pull, Push, Take:
      "Those sacks are really heavy. Your slight build could not manage to move one sack let alone all of them.";
  ],
has pluralname static;

!----------------------------------------
! Baker
!----------------------------------------
Object baker "baker" room05
with
  name 'baker' 'portly' 'man' 'thomas' 'farriner',
  description
  [;
    print "He's a portly man in his early 50s with thin, wispy grey hair. He's wearing a baker's apron that struggles to cover his stomach. ";
    if (the_time > 47)
      print (string)HE_SEEMS_TO_BE_OCCUPIED;
    else
      print "He's raking the coals under the oven.";
    new_line;
    ShowTutorial(TUT_TALK);
    rtrue;
  ],
  short_name
  [;
    if (self has proper)
    {
      print "Thomas Farriner";
      rtrue;
    }
  ],
  life
  [;
    Ask:
      if (the_time > 47)
        print_ret (string)HE_SEEMS_TO_BE_OCCUPIED, " You should have asked your questions earlier.";
      wn = consult_from;
      switch (NextWord())
      {
        'baker', 'him', 'himself':
          give self proper;
          "~Me name's Thomas Farriner. I'm the owner of this 'ere bakery.~";
        'bakehouse', 'bakery':
          "~I opened this 'ere bakery in 1649. That was after I left the Baker's Company. Let's see. It's now 1666, so that's about...~ He stops and counts on his fingers, ~...about 17 years ago.~";
        'bread':
          "~I make the best bread in London. Most of me time is spent bakin' bread for the Royal Navy, but I still manage ta supply all the locals.~";
        'crystal', 'crystals':
          "~I dunno nothin' 'bout no crystals. Are you a jeweller or somethin'?~";
        'dutch':
          print_ret (string)NAVYS_BUSY_FIGHTIN_DUTCH, " at the moment. I dunno what it's about. Somethin' ta do with trade and colonial expansion. Maybe the Dutch got upset 'cause we didn't buy enough tulips.~";
        'farriner', 'thomas':
          "~That's me.~";
        'lantern':
          "~Be careful. It's hot.~";
        'locals', 'londoners':
          "~You know, locals, Londoners, people what lives 'round 'ere.~";
        'london':
          "~Geez, you are new 'round 'ere, aren't ya? This 'ere is London and we're slap bang in the middle of it. The Thames is at the end of the lane down that way.~ He points to the south.";
        'me', 'myself', 'self':
          "~Ya look like a right scrawny pipsqueak. Ya need ta get some of me award-winnin' bread into ya. Come back in the mornin' and I'll give ya a loaf on the house.~";
        'oven':
          "~This 'ere oven 'as been bakin' me bread since I started the bakery in 1649. It's gettin' a bit long in the tooth, now. Earlier tonight, it spat out a spark that started a fire in the wood pile. Lucky I noticed. I put it out, but it was a wake-up call that I need ta get a new oven.~";
        'pudding', 'lane':
          "~Puddin' Lane's just out the front. Ya musta walked down it ta get 'ere.~";
        'royal', 'navy':
          print_ret (string)NAVYS_BUSY_FIGHTIN_DUTCH, ". This is the second Anglo-Dutch war, an' I 'ope it's the last one.~";
        'shop':
          "~The shop's next door.~ He points to the west. ~Best bread shop in all of London. I even bake bread for the Royal Navy, ya know. They needs ta keep their strength up ta fight them Dutch.~";
        'thames', 'river':
          "~The Thames is the river what runs through the middle of London.~";
        default:
          "~I don't know nothin' 'bout that. Ask me about' somethin' else, but make it snappy, 'cause I've gotta get finished up 'ere and get ta bed.~";
      }
    Give, Show:
      if (the_time > 47)
        print_ret (string)HE_SEEMS_TO_BE_OCCUPIED, " You should have caught him earlier.";
      if (noun == bread)
        "~Is that one of the loaves from the shop?~ You tell him it is. ~That'll be stale. It's only there for display. If ya wanna fresh loaf, come back in the mornin'.~";
      "~No offence, but whatever it is, I don't need it.~";
    Talk:
      if (the_time > 47)
        print_ret (string)HE_SEEMS_TO_BE_OCCUPIED, " You should have talked to him earlier.";
      if (self hasnt general)
      {
        give self general proper;
        print "~Yaah! Who are you? You scared the livin' daylights outta me.~ The baker looks you up and down. ~I 'aven't seen ya in 'ere before. Ya must be new in town. Me name's Thomas Farriner. What can I do for ya?~^";
        ShowTutorial(TUT_ASK);
        rtrue;
      }
      "~If I can help ya with somethin', just ask. Otherwise, come back in the mornin'.~";
  ],
has animate transparent;

!----------------------------------------
! Apron
!----------------------------------------
Object "apron" baker
with
  article AN,
  name 'baker^s' 'apron',
  description "The apron is covered in flour, which gives away the owner's profession as a baker.",
has scenery;

!========================================
! Room 6: Deck
!========================================
Object room06 "Deck"
with
  description
  [;
    if (self hasnt visited)
      print "You can smell the distinctive salty air of the ocean. It's very dark and it's freezing! Every time you exhale, your breath comes out as a white mist. You sense a vague rocking motion below your feet, as though you're on a large ship in an ocean swell.^^";
    "This is the uppermost deck on the starboard side of the ship. It's called the boat deck, as this is where the lifeboats are located. You notice that all the lifeboats are gone, apart from the one immediately to starboard. It's bitterly cold and you shiver in the cold night air. There's a strange mist to fore and an entrance into the ship to port. The deck continues to aft.";
  ],
  n_to
  [;
    date = TIME_TOWER;
    SetTime(save_time, 1);
    StopDaemon(self);
    ship_directions_enabled = false;
    print (string)TIME_WARP;
    print (italic)"[Use compass directions (N, S, E, W) now that you're no longer on the ship.]^^";
    return room02;
  ],
  e_to
  [;
    give lifeboat scenery ~static;
    return room07;
  ],
  s_to room13,
  w_to room08,
  in_to
  [;
    give lifeboat scenery ~static;
    return room07;
  ],
  before
  [;
    Hint:
      if (gunwale hasnt general)
        print_ret (string)NEED_TO_WORK_OUT_WHERE, "Examine the lifeboat and read what you find there.";
      if (room08 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "to port yet.";
      if (room13 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "aft yet.";
      if (room07 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "in the lifeboat yet.";
  ],
  daemon
  [;
    if (the_time < 130)
    {
      switch (random(40))
      {
        1: "^You hear a scream somewhere in the distance.";
        2: "^You hear a little girl crying somewhere.";
        3: "^You hear shouts of panic.";
        4: "^You hear the sound of running in a nearby corridor.";
        5: "^You hear someone calling for help from another part of the ship.";
        6: "^You hear an official-sounding voice calling, ~Women and children first.~";
        7: "^You hear a scraping noise, like metal against metal.";
        8: "^It might be an illusion, but the floor seems to shake under your feet.";
        9: "^You feel the ship shudder. It seems to be groaning in agony.";
        10: "^A deep voice in the distance shouts, ~Abandon ship. Make your way to the lifeboats.~";
        11: "^You can hear a band playing from the fore of the boat deck.";
      }
      rtrue;
    }
    if (the_time == 125)
      "^The floor is tilting. You find it hard to walk.";
    if (the_time < 130)
      "^The ship is tilting more and more.";
    if (the_time < 140)
      "^The ship is sinking! ", (string)YOUD_BETTER_GET_BACK;
    if (the_time == 140)
    {
      deadflag = 1;
      "^The deck suddenly tilts up at a steep angle and anything that's not locked down falls into the icy Atlantic Ocean, including you. Water and debris rushes all around you. In your desperate bid to escape the swirling water, something hits you on the head and you drown. You've become a victim of the Titanic disaster. You should have got out while you had the chance.";
    }
  ],
has light;

!----------------------------------------
! Deck
!----------------------------------------
Object "deck" room06
with
  parse_name
  [ nw i flag;
    nw = NextWord();
    while (nw == 'boat' or 'deck')
    {
      i++;
      if (nw == 'boat')
        flag++;
      nw = NextWord();
    }
    if (i == flag)
      return 0;
    return i;
  ],
  description "You can't see any further to fore because of the strange mist, but you imagine that this leads to the first-class promenade and the officers' promenade and, from there, to the bridge, the wheelhouse and the officers' quarters.",
has scenery;

!----------------------------------------
! Lifeboat (floating object)
!----------------------------------------
Object lifeboat "lifeboat"
with
  name 'lifeboat' 'boat' 'clinker-built' 'wooden' 'hole' 'bilge',
  description
  [;
    print "It's a clinker-built wooden lifeboat measuring about 9 m long and 2.8 m wide. You reckon it could hold up to 65 passengers and crew, except that it has a hole in the bilge. This would explain why it hasn't been used to evacuate passengers.";
    if (self in room06)
      print " You notice that it has a name painted under the gunwale.";
    "";
  ],
  before
  [;
    Enter:
      if (self in room06)
        <<Go FAKE_E_OBJ>>;
    Exit:
      if (self in room07)
        <<Go FAKE_W_OBJ>>;
    Search:
      if (self in room06)
        "You'll have to enter the lifeboat if you want to search it.";
      else
        <<Examine self>>;
  ],
  found_in room06 room07,
has static;

!----------------------------------------
! Gunwale
!----------------------------------------
Object gunwale "gunwale" room06
with
  name 'name' 'gunwale',
  description
  [;
    give self general;
    print "The name painted under the gunwale is 'S.S. Titanic'.^^Oh, no! The lifeboat must belong to the 'R.M.S. Titanic'. That's the ship that ran into an iceberg in the north Atlantic Ocean on its maiden voyage. That explains why the deck of the ship is at such a steep incline. You'll need to get off the ship before it eventually sinks at 2:20 a.m.^";
    ShowTutorial(TUT_TIME_LEFT);
    rtrue;
  ],
  before
  [;
    Read:
      give self general;
      <<Examine self>>;
  ],
has scenery;

!========================================
! Room 7: Lifeboat
!========================================
Object room07 "Lifeboat"
with
  description "You're in a lifeboat, swinging gently on its davits. The only way to get off the lifeboat is to return to the deck to port.",
  w_to
  [;
    give lifeboat ~scenery static;
    return room06;
  ],
  out_to
  [;
    give lifeboat ~scenery static;
    return room06;
  ],
  before
  [;
    Hint:
      if (axe hasnt moved)
        print_ret (string)DONT_FORGET_THE, "axe.";
      "The lifeboat is damaged, so you might as well get out.";
  ],
has light;

!----------------------------------------
! Davits
!----------------------------------------
Object "davits" room07
with
  name 'davits' 'crane-like' 'devices',
  description "They're crane-like devices used to raise and lower the lifeboat.",
has pluralname scenery;

!----------------------------------------
! Axe
!----------------------------------------
Object axe "axe" room07
with
  article AN,
  name 'axe' 'fireman^s' 'long' 'handle' 'sharp' 'blade' 'rust',
  description "It looks like a fireman's axe with a long handle and sharp blade, albeit a little rusty from exposure to the salty ocean air.",
has;

!========================================
! Room 8: Top of Grand Staircase
!========================================
Object room08 "Top of Grand Staircase"
with
  description "You find yourself at the top of an opulent staircase that leads down to A deck. The craftsmanship is truly impressive. Overhead, the staircase is crowned by an extravagant wrought iron and glass dome with a large chandelier at the centre. Towards the starboard side of the staircase, a corridor leads fore, where you hear worrying noises, and a door leads aft. You can also return to the cold night air of the outside deck to starboard.",
  n_to room15,
  s_to gym_door,
  e_to room06,
  d_to room09,
  before
  [;
    Hint:
      if (room09 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "down the staircase yet.";
      if (room15 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "fore yet.";
      if (gym_door hasnt general && metal_bar hasnt general)
        "Examine the door and the thing sticking out of it.";
      if (gym_door hasnt general && thread hasnt general)
        "Examine the thread.";
      if (gym_door hasnt general && wheel in nothing)
        print_ret (string)COME_BACK_WHEN_YOUVE_FOUND, "something that may screw onto the metal bar.";
      if (gym_door hasnt general)
        print_ret (string)YOUVE_FOUND_WHAT_YOU_NEED, "Just screw it onto the metal bar.";
      if (gym_door hasnt open && room14 hasnt visited)
        print_ret (string)OPEN_THE, "door.";
      if (room14 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "aft yet.";
    Listen:
      if (noun == nothing)
        "You hear a disconcerting metallic scraping and creaking from the ship's hull. There's also shouting and screaming of passengers somewhere in the distance.";
  ],
has light;

!----------------------------------------
! Grand staircase (floating object)
!----------------------------------------
Object "grand staircase"
with
  article THE,
  name 'grand' 'staircase' 'stairs' 'steps' 'bottom' 'top' 'of' 'opulent' 'lavish ' 'solid' 'english' 'oak' 'balustrade' 'wrought' 'iron' 'grilles' 'ormolu' 'swags',
  description
  [;
    print "You're ";
    if (self in room08)
      print "on the boat deck at the top";
    else
      print "on A deck at the bottom";
    " of the grand staircase. It's constructed of solid English oak with sweeping curves and the surrounding spaces are panelled in the sleek neoclassical William and Mary style. The balustrades display distinctive wrought iron grilles with ormolu swags in the style of Louis XIV.";
  ],
  before
  [;
    Climb:
      if (self in room08)
        <<Go FAKE_D_OBJ>>;
      else
        <<Go FAKE_U_OBJ>>;
  ],
  found_in room08 room09,
has scenery;

!----------------------------------------
! Glass dome
!----------------------------------------
Object "dome" room08
with
  name 'frosted' 'glass' 'dome' 'extravagant' 'wrought' 'iron',
  description "The glass dome is made from frosted glass so that the direct sunlight is filtered during the day time. A chandelier hangs from the middle of the dome to provide light during the night time.",
  before
  [;
    Take:
      "The dome", (string)OUT_OF_YOUR_REACH;
  ],
has scenery;

!----------------------------------------
! Chandelier
!----------------------------------------
Object "chandelier" room08
with
  name 'chandelier' 'small' 'crystal' 'shards' 'light' 'globes',
  description "The chandelier is made from seemingly hundreds of small crystal shards interspersed with light globes. You'd hate to be the one who has to change those light globes.",
  before
  [;
    Take:
      "The chandelier", (string)OUT_OF_YOUR_REACH;
  ],
has scenery;

!----------------------------------------
! Gym door (floating object)
!----------------------------------------
Object gym_door "door"
with
  name 'gym' 'door' 'odd-looking' 'odd' 'looking',
  description
  [;
    print "The door is located to ";
    if (self in room14)
      "fore. ";
    print "aft, at the starboard side of the large open area surrounding the grand staircase. ";
    if (self hasnt general)
      "It has a metal bar sticking out of it.";
    else
      "It has a wheel attached.";
  ],
  door_dir
  [;
    if (self in room08)
      return s_to;
    else
      return n_to;
  ],
  door_to
  [;
    if (self in room08)
      return room14;
    else
      return room08;
  ],
  after
  [;
    Open:
      "You turn the wheel to open the door.";
  ],
  add_to_scope
  [;
    if (self hasnt general)
    {
      PlaceInScope(metal_bar);
      PlaceInScope(thread);
      return;
    }
    PlaceInScope(wheel);
    return;
  ],
  found_in room08 room14,
has door lockable locked openable scenery;

!----------------------------------------
! Metal bar
!----------------------------------------
Object metal_bar "metal bar"
with
  name 'thick' 'metal' 'bar',
  description
  [;
    give self general;
    print "It's a thick metal bar protruding from the door with a ";
    if (gym_door hasnt general)
      "screw thread on the exposed end.";
    else
      "large metal wheel screwed onto it.";
  ],
has scenery;

!----------------------------------------
! Screw thread
!----------------------------------------
Object thread "screw thread"
with
  name 'screw' 'thread',
  description
  [;
    give self general;
    "Quite clearly, something needs to be screwed onto it.";
  ],
has scenery;

