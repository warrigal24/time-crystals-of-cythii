!========================================
! Room 10: Corridor
!========================================
Object room10 "Corridor"
with
  description "You're in a narrow corridor that runs fore and aft with an opening to port.",
  n_to room09,
  s_to room12,
  w_to room11,
  before
  [;
    Hint:
      if (room11 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "to port yet.";
      if (room12 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "aft yet.";
  ],
