! Room 9: Bottom of Grand Staircase
!========================================
Object room09 "Bottom of Grand Staircase"
with
  description "You're on A deck at the bottom of the grand staircase. It's no less impressive at this level and you notice a bronze cherub holding an electric torch on the newel post of the middle balustrade. A narrow corridor leads to aft.",
  s_to room10,
  u_to room08,
  before
  [;
    Hint:
      if (room10 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "aft yet.";
  ],
has light;

