!========================================
! Room 11: Reading and Writing Room
!========================================
Object room11 "Reading and Writing Room"
with
  description "You're in the reading and writing room on A deck. This is intended as a quiet area where passengers can relax and, well, read and write. It's a spacious area with tables and chairs scattered about and settees lining the walls. The exit from here is to starboard.",
  e_to room10,
  before
  [;
    Hint:
      if (bow in nothing)
        "Examine the furniture. All of it.";
      if (bow hasnt moved)
        print_ret (string)DONT_FORGET_THE, "bow.";
  ],
has light;

!----------------------------------------
! Reading and writing room
!----------------------------------------
Object "room" room11
with
  name 'reading' 'and' 'writing' 'room',
  description "The room is painted white and decorated in a refined Georgian style with delicate plasterwork, sleek panelling, fluted columns and a white marble fireplace.",
has scenery;

!----------------------------------------
! Decorations
!----------------------------------------
Object "decorations" room11
with
  name 'decorations' 'delicate' 'plasterwork' 'sleek' 'panelling' 'paneling' 'fluted' 'columns' 'white' 'marble' 'fireplace',
  description
  [;
    "All the decorations are amazing, but you don't have time to admire them until you've returned all ", (string)THE_TIME_CRYSTALS_OF_CYTHII, ".";
  ],
has scenery;

!----------------------------------------
! Tables
!----------------------------------------
Object "tables" room11
with
  name 'table' 'tables' 'small' 'square',
  description
  [;
    print "They're mostly small square tables that can accommodate a maximum of four people. ";
    <<Search self>>;
  ],
  before
  [;
    Receive:
      <<PutOn noun reading_table>>;
    Search:
      if (child(reading_table) == 0)
      {
        PrintMsg(MSG_SEARCH_NOTHING_ON);
        rtrue;
      }
      else
        <<Search reading_table>>;
  ],
has pluralname static;

!----------------------------------------
! Table
!----------------------------------------
Object reading_table "one of the tables" room11
has proper scenery supporter;

!----------------------------------------
! Chairs
!----------------------------------------
Object "chairs" room11
with
  name 'chair' 'chairs',
  description
  [;
    print "The chairs are in shades of yellow and blue grouped around the tables for the convenience of the first-class passengers. ";
    <<Search self>>;
  ],
  before
  [;
    Enter:
      print_ret (string)NO_TIME_TO_LOUNGE_ABOUT;
    Receive:
      <<PutOn noun reading_chair>>;
    Search:
      if (child(reading_chair) == 0)
      {
        PrintMsg(MSG_SEARCH_NOTHING_ON);
        rtrue;
      }
      else
        <<Search reading_chair>>;
  ],
has enterable pluralname static;

!----------------------------------------
! Chair
!----------------------------------------
Object reading_chair "one of the chairs" room11
has proper scenery supporter;

!----------------------------------------
! Settees
!----------------------------------------
Object "settees" room11
with
  name 'settee' 'settees' 'lounge' 'lounges' 'silk-upholstered' 'silk' 'upholstered',
  description
  [;
    print "They're silk-upholstered settees that could comfortably seat two or three people. ";
    <<Search self>>;
  ],
  before
  [;
    Enter:
      print_ret (string)NO_TIME_TO_LOUNGE_ABOUT;
    Receive:
      <<PutOn noun reading_settee>>;
    Search:
      if (bow in nothing)
      {
        move bow to reading_settee;
        "You find a bow on one of the settees. One of the ladies must have left it behind.";
      }
      if (child(reading_settee) == 0)
      {
        PrintMsg(MSG_SEARCH_NOTHING_ON);
        rtrue;
      }
      else
        <<Search reading_settee>>;
  ],
has enterable pluralname static;

