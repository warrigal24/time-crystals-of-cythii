!----------------------------------------
! Bar
!----------------------------------------
Object bar "bar" room12
class OpenContainer
with
  name 'bar',
  description
  [;
    print "This is where the steward would be stationed when the passengers are in the lounge. The passengers would order drinks and smokes from the bar, but they can't do that now, as neither the passengers nor the steward are here. ";
    <<Search self>>;
  ],
has static supporter;

!----------------------------------------
! Bottle of champagne
!----------------------------------------
Object champagne "bottle of champagne" bar
with
  name 'bottle' 'of' 'champagne' 'heidsieck' '&//' 'co' 'monopole',
  description
  [;
    print "It's a bottle of Heidsieck & Co Monopole champagne. It's sealed with a cork";
    if (self has general)
      print " that's been removed and replaced";
    ".";
  ],
  before
  [;
    Attack:
      "Try dropping it.";
    Drink:
      if (self hasnt general)
        "You'd need to open it first.";
      print_ret (string)NEED_TO_STAY_SOBER;
    Drop:
      move self to limbo;
      move glass to location;
      give cork ~scenery;
      move cork to location;
      print_ret (string)IT_SHATTERS_INTO_PIECES;
    Eat:
      print_ret (string)CAN_DRINK_BUT_CANT_EAT;
    Open:
      if (self has general)
        "You've already opened the champagne, but replaced the cork in order to avoid spilling the contents. It's best to leave it that way.";
      give self general;
      "POP! When the cork pops out, the champagne froths up and starts to bubble out of the bottle. You quickly replace the cork to preserve the contents.";
  ],
has edible transparent;

!----------------------------------------
! Cork
!----------------------------------------
Object cork "cork" champagne
with
  name 'cork',
  description
  [;
    print "It's the cork ";
    if (self hasnt scenery)
      "out of the champagne bottle.";
    print "that seals";
    if (champagne notin limbo)
      " the champagne bottle.";
    else
      " the flagon of wine.";
  ],
  before
  [;
    Take:
      if (self hasnt scenery)
        rfalse;
      if (champagne notin limbo)
        <<Open champagne>>;
      else
        <<Open wine>>;
  ],
has scenery;

!----------------------------------------
! Broken glass
!----------------------------------------
Object glass "broken glass"
with
  article SOME,
  name 'hundreds' 'of' 'bits' 'pieces' 'broken' 'glass',
  description "It's the broken glass from the champagne bottle.",
  before
  [;
    Take:
      "You don't have time to pick up hundreds of pieces of broken glass.";
  ],
has static;

!========================================
! Room 13: Deck
!========================================
Object room13 "Deck"
with
  description "You're on the boat deck on the starboard side of the ship. It's bitterly cold and ice is forming on the deck, making it very slippery. Because of the ice, you can only go to fore.",
  n_to room06,
  before
  [;
    Hint:
      if (bronze_key in ice && ice hasnt general)
        "Examine the ice.";
      if (bronze_key in ice && room23 hasnt visited)
        "You'll need a way to melt the ice. Come back later.";
      if (bronze_key in ice)
        "You'll need a way to lower the freezing point of water. You've found what you need.";
      if (bronze_key hasnt moved)
        print_ret (string)DONT_FORGET_THE, "bronze key.";
  ],
has light;

!----------------------------------------
! Deck
!----------------------------------------
Object "deck" room13
with
  name 'deck',
  description "The deck is very icy, so watch your step. You imagine that access to the lifeboats must be very difficult for the third-class passengers who are on the lower decks.",
has scenery;

!----------------------------------------
! Lump of ice
!----------------------------------------
Object ice "lump of ice" room13
with
  name 'lump' 'of' 'ice',
  description
  [;
    give self general;
    "It's frozen to the deck. You can see a key inside it.";
  ],
  before
  [;
    Attack:
      if (second == axe)
        "Your hands are too numb to get a good grip on the axe and it keeps slipping off the ice. Although you manage to chip away a little, it freezes over again straight away. You'll need to take a more subtle approach, perhaps melt the ice.";
      "It's no good. Your blows just bounce off.";
    Take:
      "It's frozen to the deck.";
  ],
has static transparent;

!----------------------------------------
! Bronze key
!----------------------------------------
Object bronze_key "bronze key" ice
with
  name 'bronze' 'key' 'keys//p',
  description
  [;
    print "It's a small bronze key. ";
    if (drawer hasnt general)
      "It looks like a furniture key, but, on a ship this size, you have no idea which piece of furniture it would unlock.";
    else
      print_ret (string)YOU_KNOW_THAT_IT_UNLOCKS, "dresser drawer in the stateroom.";
  ],
  before
  [;
    Take:
      if (self in ice)
        "You can't. It's frozen in the ice.";
  ],
has;

!----------------------------------------
! Pool of salty water
!----------------------------------------
Object pool "pool of salty water"
with
  name 'pool' 'of' 'salty' 'water',
has static;

!========================================
! Room 14: Gymnasium
!========================================
Object room14 "Gymnasium"
with
  description "You're in the ship's gymnasium. The ropes hanging from the ceiling are hanging at a rather disturbing angle with respect to the floor. They should be hanging vertically. The exit from the gym is via a door to fore.",
  n_to gym_door,
  before
  [;
    Hint:
      if (trampoline hasnt moved)
        print_ret (string)DONT_FORGET_THE, "trampoline.";
  ],
has light;

!----------------------------------------
! Gymnasium
!----------------------------------------
Object "gymnasium" room14
with
  name 'gymnasium' 'gym' 'vaulting' 'horses' 'racks' 'weights' 'assorted' 'exercise' 'equipment',
  description "If you were a gym junkie, you could have a lot of fun in here. THere are vaulting horses, racks, weights and assorted exercise equipment that you're not familiar with. However, you're not a gym junkie and the thought of doing all that exercise could give you a panic attack.",
has scenery;

!----------------------------------------
! Ropes
!----------------------------------------
Object "ropes" room14
with
  parse_name
  [ nw i flag;
    nw = NextWord();
    while (nw == 'rope' or 'ropes' or 'ceiling' or 'floor')
    {
      i++;
      if (nw == 'rope' && TestScope(rope))
        flag++;
      nw = NextWord();
    }
    if (i == flag)
      return 0;
    return i;
  ],
  description "The ropes are hanging from the ceiling at a disturbing angle, which indicates that the ship is probably sinking, so don't hang around any longer than necessary.",
  before
  [;
    Climb:
      if (HandsFree())
        "You climb a little way up one of the ropes, but your grip strength is not the best and you slide back down again.";
      else
        print_ret (string)NEED_HANDS_FREE, "climb up any of the ropes.";

  ],
has pluralname scenery;

!----------------------------------------
! Mini-trampoline
!----------------------------------------
Object trampoline "mini-trampoline" room14
with
  name 'trampoline' 'small' 'portable' 'circular' 'mini-trampoline' 'mini',
  short_name
  [;
    if (self hasnt general)
      rfalse;
    print "mini-trampoline with a rope tied to it";
    rtrue;
  ],
  description
  [;
    print "It's a small, portable trampoline, about 1 m in diameter.";
    if (self hasnt moved)
      print " You don't know its purpose as a piece of exercise equipment, but it sure looks like a lot of fun to jump on.";
    if (self has general)
    {
      print " There's a short length of rope tied to it. ";
      if (rope in player)
        "You're holding the other end of the rope.";
      print "The other end of the rope is ";
      if (rope in location)
        "on the ground.";
      else
        "somewhere nearby.";
    }
    "";
  ],
  react_before
  [;
    Go:
      if (self has general && self in player && rope notin player)
        "You'd better pick up the rope, or you might trip over it.";
  ],
  before
  [;
    Enter:
      "Try jumping on it.";
    JumpOn:
      if (self in player)
        "You can't jump on", (string)TRAMPOLINE_WHILE_CARRIED;
      if (self in room15 or room16)
        <<JumpOver gaping_hole>>;
      "Boing, boing, boing. Whee, this is fun.";
    JumpOver:
      if (self in player)
        "You can't jump over", (string)TRAMPOLINE_WHILE_CARRIED;
      if (self in room15 or room16)
      {
        deadflag = 1;
        print "You jump over the trampoline and into the gaping hole on the other side. Needless to say, the outcome is not pretty.^";
        ShowTutorial(TUT_UNDO);
        rtrue;
      }
      "Okay, but why anyone would want to jump over a trampoline is beyond me.";
    Receive:
      if (self in player)
        "You can't put anything on", (string)TRAMPOLINE_WHILE_CARRIED;
      "The trampoline isn't stable enough to use as a table. It's meant for people to jump on.";
  ],
  add_to_scope
  [;
    if (self has general)
      PlaceInScope(dummy_rope);
  ],
has;

!----------------------------------------
! Dummy rope
!----------------------------------------
Object dummy_rope "rope"
with
  name 'rope',
  parse_name
  [;
    if (TestScope(rope))
      return 0;
    return -1;
  ],
  before
  [;
    Examine:
      <<Examine rope>>;
    Pull:
      move rope to location;
      "You pull the end of the rope into this location.";
    Take:
      print (string)FIRST_PULLING_ROPE;
      move rope to location;
      <<Take rope>>;
    Untie:
      print (string)FIRST_PULLING_ROPE;
      move rope to location;
      <<Untie rope trampoline>>;
  ],
has scenery;

!========================================
! Room 15: Corridor
!========================================
Object room15 "Corridor"
with
  description "You're in a corridor going fore to aft, but a gaping hole torn in the metal floor prevents you going further to fore. Beyond the hole, the corridor continues. From the bottom of the hole, you can hear the sound of water swishing about, but you can't see it in the darkness.",
  n_to DEEP_HOLE_IN_THAT_DIRECTION,
  s_to room08,
  before
  [;
    Hint:
      if (room14 hasnt visited)
        "That hole looks deep. ", (string)COME_BACK_WHEN_YOUVE_FOUND, "a way to jump over it.";
      if (trampoline hasnt moved)
        "There are times when exercise equipment can be used for more than just exercise.";
      if (room16 hasnt visited && trampoline notin self)
        print_ret (string)YOUVE_FOUND_WHAT_YOU_NEED, "Just drop it here.";
      if (room16 hasnt visited)
        "Boing, boing, boing.";
    Listen:
      "You can hear water swishing about at the bottom of the hole.";
  ],
has light;

!----------------------------------------
! Corridor
!----------------------------------------
Object "corridor" room15
with
  name 'corridor',
  description "It's a metallic corridor that runs from fore to aft along the length of the ship, except that a huge gash in the floor prevents further progress to fore.",
has scenery;

!----------------------------------------
! Gaping hole in floor (floating object)
!----------------------------------------
Object gaping_hole "gaping hole in the floor"
with
  name 'gaping' 'hole' 'in' 'floor',
  description
  [;
    print "There's a gaping hole in the floor of the corridor to ";
    if (self in room15)
      "fore.";
    else
      "aft.";
  ],
  before
  [;
    Enter:
      deadflag = 1;
      print "That probably wasn't such a smart idea. You fall into the abyss below and do a massive belly flop into the cold water, where you drown.^";
      ShowTutorial(TUT_UNDO);
      rtrue;
    JumpOver:
      if (trampoline in player)
      {
        deadflag = 1;
        print "You make a desperate grab for the far side of the hole, miss, and fall into the icy water far below. It probably wasn't a smart idea to try jumping while carrying a trampoline. You hit the water first and the trampoline falls on top of you. You struggle to remove the trampoline, but its weight holds you under the water, where you drown.^";
        ShowTutorial(TUT_UNDO);
        rtrue;
      }
      if (trampoline notin location)
      {
        deadflag = 1;
        print "You make a desperate grab for the far side of the hole, miss, and plummet to a cold, watery grave.^";
        ShowTutorial(TUT_UNDO);
        rtrue;
      }
      if (self in room16 && (trampoline hasnt general || rope notin player))
        "That wouldn't be very wise. The last time you did that, the trampoline fell in the hole. You'll need to be able to recover it if that happens again.";
      print "You jump onto the trampoline and spring across the hole. Unfortunately, your foot catches the edge of the trampoline and drags it into the hole. ";
      if (trampoline has general && rope in player)
      {
        if (self in room15)
          move trampoline to room16;
        else
          move trampoline to room15;
        print "Fortunately, you were hanging onto the rope and you're able to pull the trampoline out of the hole.^^";
      }
      else
      {
        remove trampoline;
        if (trampoline has general)
          remove rope;
        print "You hear it splash into the water far below.^^";
      }
      if (self in room15)
        PlayerTo(room16);
      else
        PlayerTo(room15);
      rtrue;
  ],
  found_in room15 room16,
has scenery;

!========================================
! Room 16: Corridor
!========================================
Object room16 "Corridor"
with
  description "The corridor ends at the door to a stateroom to fore. There's a gaping hole in the corridor to aft and an exit to port leads down to B-deck.",
  n_to stateroom_door,
  s_to DEEP_HOLE_IN_THAT_DIRECTION,
  w_to room18,
  before
  [;
    Hint:
      if (room17 hasnt visited && stateroom_door hasnt open)
        "If the passengers left their room in a hurry, the door might not be locked. Try opening it.";
      if (room17 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "fore yet.";
      if (room18 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "to port yet.";
      if (trampoline in nothing)
        print_ret (string)TRYING_TO_GET_ACROSS_HOLE, "you can do so the same way you got here. Just recover the trampoline.";
      if (trampoline hasnt general)
        print_ret (string)TRYING_TO_GET_ACROSS_HOLE, "try tying something to the trampoline so that you can recover it.";
      if (rope notin player)
        print_ret (string)TRYING_TO_GET_ACROSS_HOLE, "don't forget to hold the end of the rope.";
      print_ret (string)GO_BACK_WAY_YOU_CAME;
  ],
has light;

!----------------------------------------
! Corridor
!----------------------------------------
Object "corridor" room16
with
  name 'corridor',
  description "It's a metallic corridor that ends at a stateroom to fore. A huge gash in the floor prevents progress to aft.",
has scenery;

!----------------------------------------
! Stateroom door
!----------------------------------------
Object stateroom_door "stateroom door"
with
  name 'stateroom' 'door',
  description
  [;
    print "It's the door to the stateroom. It's currently ";
    if (self has open)
      "open.";
    else
      "closed.";
  ],
  door_dir
  [;
    if (self in room16)
      return n_to;
    else
      return s_to;
  ],
  door_to
  [;
    if (self in room16)
      return room17;
    else
      return room16;
  ],
  found_in room16 room17,
has door openable scenery;

!========================================
! Room 17: Stateroom
!========================================
Object room17 "Stateroom"
with
  description "This is one of the many first-class staterooms aboard the ship. Each is decorated in one of 11 period styles, including Georgian, Jacobean and Italian Renaissance. This one appears to be a Louis XV-inspired design with varnished oak panelling and cabriolet furniture. The opulence takes your breath away. The door out of the room is to aft.",
  s_to stateroom_door,
  before
  [;
    Hint:
      if (dressing_table hasnt general)
        "Examine the dressing table.";
      if (drawer has locked && bronze_key in ice)
        "You'll need a key to unlock the drawer. ", (string)COME_BACK_WHEN, "you've found it.";
      if (drawer has locked)
        print_ret (string)TRY_UNLOCKING_THE, "drawer.";
      if (drawer hasnt open && blue_crystal hasnt moved)
        print_ret (string)OPEN_THE, "drawer.";
      if (blue_crystal hasnt moved)
        print_ret (string)DONT_FORGET_THE, "blue crystal.";
  ],
has light;

!----------------------------------------
! Stateroom
!----------------------------------------
Object "stateroom" room17
with
  name 'stateroom' 'finely-carved' 'panelling' 'paneling' 'veneers' 'marquetry' 'exotic' 'wood' 'woods',
  description "The stateroom has finely-carved panelling, veneers and marquetry made from exotic woods.",
has scenery;

!----------------------------------------
! Cabriolet furniture
!----------------------------------------
Object "cabriolet furniture" room17
with
  name 'cabriolet' 'furniture',
  description "The most distinguishing features of the cabriolet furniture are the curving lines and legs ending in ornamental feet.",
has scenery;

!----------------------------------------
! Dressing table
!----------------------------------------
Object dressing_table "dressing table" room17
class OpenContainer
with
  name 'dressing' 'table' 'dresser' 'elaborately-carved',
  description
  [;
    give self general;
    print "It's an elaborately-carved dressing table with a single drawer. ";
    <<Search self>>;
  ],
has static supporter;

!----------------------------------------
! Drawer
!----------------------------------------
Object drawer "drawer" room17
class OpenableContainer
with
  name 'drawer',
  description
  [;
    print "The drawer is part of the dressing table. ";
    <<Search self>>;
  ],
  after
  [;
    Unlock:
      give self general;
  ],
  with_key bronze_key,
has container lockable locked openable scenery;

!----------------------------------------
! Piece of jewellery
!----------------------------------------
Object jewellery "piece of jewellery" drawer
with
  name'piece' 'of' 'jewellery' 'jewelry' 'red' 'earring',
  description "It's a red earring, not to be confused with a red herring.",
has clothing;

!----------------------------------------
! Blue crystal
!----------------------------------------
Object blue_crystal "blue crystal" drawer
with
  name 'bright' 'blue' 'crystal' 'crystals//p',
  description
  [;
    print "It's a bright blue crystal that ";
    if (self notin green_plinth)
      print "belongs";
    else
      print "is now at home";
    " on the blue", (string)PLINTH_IN_TIME_TOWER;
  ],
has;

!========================================
! Room 18: Landing
!========================================
Object room18 "Landing"
with
  description "You're on a landing at the top of the stairs leading down to B-deck. You can hear the sound of water down there. The main corridor is to starboard.",
  e_to room16,
  d_to room19,
  before
  [;
    Hint:
      if (room19 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "down the stairs yet.";
  ],
has light;

!----------------------------------------
! Landing
!----------------------------------------
Object "landing" room18
with
  name 'landing',
  description "This is a landing on A-deck at the top of the stairs leading down to B-deck.",
has scenery;

!----------------------------------------
! Stairs (floating object)
!----------------------------------------
Object "stairs"
with
  name 'stair' 'stairs' 'step' 'steps' 'stairway' 'staircase',
  description
  [;
    print "The stairs lead ";
    if (self in room18)
      "down to B-deck.";
    else
      "up to A-deck.";
  ],
  before
  [;
    Climb, Enter:
      if (self in room18)
        <<Go FAKE_D_OBJ>>;
      else
        <<Go FAKE_U_OBJ>>;
  ],
  found_in room18 room19,
has scenery;

!========================================
! Room 19: Corridor
!========================================
Object room19 "Corridor"
with
  description "You're in a corridor on B-deck. The corridor is flooded with sea water and the water appears to be slowly rising. You'd better get out of here by climbing back up the stairs to A-deck.",
  u_to room18,
  before
  [;
    Hint:
      if (trampoline in nothing)
        "When you jumped across the hole, the trampoline fell in the water. So, look in the water!";
      if (trampoline hasnt general)
        "You found a rope here. Try tying it to something.";
      if (trampoline in self)
        print_ret (string)DONT_FORGET_THE, "trampoline.";
    Swim:
      "No, thanks. The water is freezing cold and it's full of swirling debris.";
  ],
has light;

!----------------------------------------
! Corridor
!----------------------------------------
Object "corridor" room19
with
  name 'corridor',
  description "It's a metallic corridor that runs from here to aft along the length of the ship, except that sea water covers the floor, preventing further progress in that direction.",
has scenery;

!----------------------------------------
! Water
!----------------------------------------
Object water "water" room19
with
  article SOME,
  name 'sea' 'ocean' 'water' 'swirling' 'debris',
  description
  [;
    print "It looks like sea water with swirling debris";
    if (trampoline in nothing)
    {
      move trampoline to location;
      print ". You see the trampoline in the water, so you drag it out onto the sloping floor of the corridor";
      if (trampoline has general)
      {
        move rope to location;
        print ", along with the rope that's tied to it";
      }
    }
    ".";
  ],
  before
  [;
    Drink:
      "The water is too salty to drink.";
    Search:
      <<Examine self>>;
  ],
has scenery;

!----------------------------------------
! Rope
!----------------------------------------
Object rope "rope" room19
with
  article
  [;
    if (trampoline has general)
      print "the";
    else
      print "a";
  ],
  name 'rope' 'short' 'length' 'of',
  short_name
  [;
    if (trampoline has general)
      print "end of a ";
    rfalse;
  ],
  description
  [;
    print "It's a short length of rope, maybe 10 m long";
    if (trampoline has general)
    {
      print ". The rope is tied to the trampoline";
      if (~~TestScope(trampoline))
        print ", which is located nearby";
    }
    ".";
  ],
  react_before
  [;
    Go:
      if (trampoline has general && self in player && trampoline notin player && trampoline notin location && trampoline notin location.selected_direction)
        "The rope isn't long enough. You'll have to drop it.";
    Take:
      if (trampoline has general && ~~TestScope(self))
      {
        print "(first pulling the end of the rope)";
        move rope to location;
      }
  ],
  before
  [;
    Tie:
      if (self notin player)
        "You need to be holding the rope before you can tie it to anything.";
      if (second == nothing && TestScope(trampoline))
      {
        print "(to the trampoline)^";
        second = trampoline;
      }
      if (second == nothing)
        print_ret (string)YOULL_HAVE_TO_TELL_ME_WHAT_TO, "tie it to.";
      if (second ~= trampoline)
        "You can't tie the rope to ", (the)second, ".";
      if (TestScope(trampoline) && trampoline has general)
        "The rope is already tied to the trampoline.";
      if (TestScope(trampoline))
      {
        give trampoline general;
        "You tie the rope to the trampoline.";
      }
    Untie:
      if (second == nothing && TestScope(trampoline))
      {
        print "(from the trampoline)^";
        second = trampoline;
      }
      if (second == nothing)
        print_ret (string)YOULL_HAVE_TO_TELL_ME_WHAT_TO, "untie it from.";
      if (second ~= trampoline)
        "The rope isn't tie to ", (ThatOrThose)second, ".";
      if (TestScope(trampoline) && trampoline hasnt general)
        "The rope isn't tied to the trampoline.";
      if (TestScope(trampoline))
      {
        give trampoline ~general;
        "You untie the rope from the trampoline.";
      }
  ],
has;

!========================================
! Room 20: Cul-de-Sac
!========================================
Object room20 "Cul-de-Sac"
with
  description
  [;
    if (self hasnt visited)
      print "It's very early in the morning and all is quiet. The low-rise buildings around you block out your view of the night sky, but this tells you that you're in a city.^^";
    "You're in a cul-de-sac. The open end is to the west and there's a strange mist to the east.";
  ],
  e_to
  [;
    date = TIME_TOWER;
    SetTime(save_time, 1);
    StopDaemon(self);
    print (string)TIME_WARP;
    return room02;
  ],
  w_to room21,
  before
  [;
    Hint:
      if (newspaper hasnt general)
        print_ret (string)NEED_TO_WORK_OUT_WHERE, "Examine the newspaper you found here.";
      if (room21 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "west yet.";
  ],
  daemon
  [;
    if (the_time < 304)
      rtrue;
    if (the_time == 304)
      "^You feel a tremor shaking the ground and hear a low rumbling noise.";
    if (the_time < 312)
      "^The ground is rumbling. I think it's an earthquake. ", (string)YOUD_BETTER_GET_BACK;
    if (the_time == 312)
    {
      deadflag = 1;
      "^The earth shakes violently and you're thrown to the ground. As you struggle to get up, a nearby building collapses on top of you and you're crushed by the rubble. Hanging around during an earthquake probably wasn't the smartest thing to do.";
    }
  ],
has light;

!----------------------------------------
! Cul-de-sac
!----------------------------------------
Object "cul-de-sac" room20
with
  name 'cul-de-sac' 'cul' 'de' 'sac' 'dead' 'end',
  description "A cul-de-sac is just a fancy word for a dead end and that's what this is.",
has scenery;

!----------------------------------------
! Newspaper
!----------------------------------------
Object newspaper "newspaper" room20
with
  name 'newspaper' 'paper' 'san' 'francisco' 'call',
  description
  [;
    give self general;
    print "It's 'The San Francisco Call' dated Wednesday, 18 April 1906. You should probably read it to see if there's anything about the stolen crystals.^^That date rings a bell. Of course! That was the date of the great San Francisco earthquake of 1906. This must be the early edition, so there won't be anything about the earthquake, as it hasn't happened yet. If you recall your history correctly, the earthquake began at 5:12 a.m., so you'd better get out of here before then.";
    print "^";
    ShowTutorial(TUT_TIME_LEFT);
    rtrue;
  ],
  before
  [;
    Burn:
      "It's too damp.";
    Read:
      self.number++;
      if (self.number == 6)
      {
        self.number = 1;
        print "You've read all the headlines, but I don't suppose it hurts to read them again.^^";
      }
      switch (self.number)
      {
        1: print "'MR. PERKINS ~RUN IN~ BY POLICEMAN'";
        2: print "'MYRIADS OF DIVORCES ARE INVALIDATED BY SUPREME COURT EDICT'";
        3: print "'STANDARD OIL'S ASSETS SHOWN'";
        4: print "'WEDS NURSE TO WHOM HE OWES HEALTH'";
        5: print "'RICH MAN'S SON LANDS IN PRISON'";
      }
      "^^You wonder if there's anything more interesting than that.";
  ],
  number 0,
has;

!========================================
! Room 21: City Street
!========================================
Object room21 "City Street"
with
  description "You're in a deserted city street that curves towards the north and east. This appears to be a seedier area of the city.",
  n_to room22,
  e_to room20,
  before
  [;
    Hint:
      if (room22 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "north yet.";
  ],
has light;

!----------------------------------------
! Street (floating object)
!----------------------------------------
Object "street"
with
  name 'street' 'roughly-paved' 'roughly' 'paved' 'less' 'saubrious' 'part' 'of' 'city',
  description "This is a roughly-paved street in the less saubrious part of the city.",
  found_in room21 room22 room28,
has scenery;

!========================================
! Room 22: City Street
!========================================
Object room22 "City Street"
with
  name 'city' 'street',
  description "You're on a city street that runs north and south with shops to the east and west.",
  n_to room28,
  s_to room21,
  e_to room27,
  w_to room23,
  before
  [;
    Hint:
      if (room23 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "west yet.";
      if (room28 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "north yet.";
      if (room27 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "east yet.";
  ],
has light;

!----------------------------------------
! Shops
!----------------------------------------
Object "shops" room22
with
  name 'shop' 'shops',
  description "There's one to the east and another to the west. You could enter them to take a closer look.",
  before
  [;
    Enter:
      "As there are two shops, you'll need to use a direction.";
  ],
has scenery;

!========================================
! Room 23: General Store
!========================================
Object room23 "General Store"
with
  description "You're in a general store. There are shelves lining the walls, but stocks look to be low. The exit to the street is to the east, but there's also an exit to the back of the shop to the south.",
  s_to room24,
  e_to room22,
  before
  [;
    Hint:
      if (salt hasnt moved)
        print_ret (string)DONT_FORGET_THE, "bag of salt.";
      if (room24 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "south yet.";
  ],
has light;

!----------------------------------------
! General store
!----------------------------------------
Object "general store" room23
with
  name 'general' 'store',
  description "It looks like it deals in bulk goods. Perhaps it's a holding store for goods that have been unloaded from the wharves.",
has scenery;

!----------------------------------------
! Shelves
!----------------------------------------
Object shelves "shelves" room23
class OpenContainer
with
  name 'shelves',
  description
  [;
    print "The shelves surround the store, but stocks are low. ";
    <<Search self>>;
  ],
has pluralname static supporter;

!----------------------------------------
! Bag of salt
!----------------------------------------
Object salt "bag of salt" shelves
with
  name 'bag' 'of' 'salt' 'small' 'canvas' 'sack',
  description "It's a small canvas sack full of salt.",
  before
  [;
    PutOn:
      if (second == ice)
      {
        move self to limbo;
        move ice to limbo;
        move bronze_key to location;
        move pool to location;
        "The salt dissolves the ice, leaving just a bronze key and a small pool of salty water. As you have no further use for the salt, you throw it overboard.";
      }
  ],
has;

!========================================
! Room 24: Parlour
!========================================
Object room24 "Parlour"
with
  description "You're in a parlour attached to the back of the general store. This is probably where all the administration and record-keeping takes place. It's decorated in Victorian style, but you can't see anything noteworthy. The exit is to the north, but there's also a narrow staircase leading down and out of the store to the south.",
  n_to room23,
  s_to
  [;
    if (girl in self)
      "The little girl is blocking the staircase.";
    return room25;
  ],
  d_to
  [;
    <<Go FAKE_S_OBJ>>;
  ],
  before
  [;
    Hint:
      if (girl hasnt general)
        "Examine the little girl.";
      if (girl hasnt proper)
        "Ask the little girl about herself and anything she mentions that might be interesting.";
      if (girl in self && brass_key hasnt general)
        "Ask Alice about the brass key.";
      if (girl in self && bow notin player)
        print_ret (string)DO_YOU_HAVE_SOMETHING_PRETTY, (string)COME_BACK_WHEN, "you do.";
      if (girl in self)
        print_ret (string)DO_YOU_HAVE_SOMETHING_PRETTY, "If so, show it to Alice or give it to her.";
      if (brass_key hasnt moved)
        print_ret (string)DONT_FORGET_THE, "brass key.";
      if (room25 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "down the stairs yet.";
  ],
has light;

!----------------------------------------
! Parlour
!----------------------------------------
Object "parlour" room24
with
  name 'parlour' 'parlor',
  description "You can't see anything of interest in the darkness of the night.",
has scenery;

!----------------------------------------
! Staircase (floating object)
!----------------------------------------
Object staircase18 "staircase"
with
  name 'staircase' 'narrow' 'wood' 'wooden' 'stairway' 'stair' 'stairs',
  description
  [;
    print "It's a narrow wooden staircase that ";
    if (self in room24)
      "descends into the cool air outside the store.";
    else
      "goes up back into the warmth inside the general store.";
  ],
  before
  [;
    Climb, Enter:
      if (self in room24)
        <<Go FAKE_S_OBJ>>;
      else
        <<Go FAKE_N_OBJ>>;
  ],
  found_in room24 room25,
has scenery;

!----------------------------------------
! Little girl
!----------------------------------------
Object girl "little girl" room24
with
  name 'little' 'girl' 'alice',
  short_name
  [;
    if (self has proper)
    {
      print "Alice";
      rtrue;
    }
  ],
  description
  [;
    give self general;
    print "She's a nice, friendly-looking little girl with a head of slightly untidy hair. You notice that she's fondling a brass key.^";
    ShowTutorial(TUT_TALK);
    rtrue;
  ],
  life
  [;
    Ask:
      wn = consult_from;
      switch (NextWord())
      {
        'alice':
          give self proper;
          "~That's my name.~";
        'bow':
          "~I need a bow to tie my hair back, but I lost it.~";
        'brass', 'key':
          give brass_key general;
          "~It's mine. I found it.~ She pauses for a moment. ~But I'll swap it for something pretty. Do you have something pretty?~";
        'dad', 'daddy', 'father':
          "~I don't have a daddy.~";
        'hair':
          "The little girl just blushes and twirls her hair.";
        'her', 'herself':
          give self proper;
          "~My name's Alice.~";
        'me', 'myself', 'self':
          "~You look like an elf.~";
        'mom', 'mommy', 'mother', 'mum', 'mummy':
          "~My mummy died.~ Oh, my! The poor girl. She must be an orphan. No wonder she looks so scruffy.";
        'stranger', 'strangers':
          "~You're a stranger.~ You ask her why. ~Because you look strange. You look like an elf.~";
        default:
          "~My mummy told me not to talk to strangers.~";
      }
    Give:
      if (noun ~= bow)
        "~I don't want that.~";
      move bow to limbo;
      move girl to limbo;
      move brass_key to location;
      print_ret (The)self, "'s face breaks into a big smile. ~Thank you, mister.~ She drops the brass key in order to take the bow, puts it in her hair and skips away singing.";
    Show:
      print (The)self;
      if (noun == bow)
        "'s face lights up at the sight of the bow. ~That's very pretty. I used to have a bow like that once, but I lost it.~";
      else
        " doesn't seem to be interested in ", (the)noun, ". She just says, ~That's not very pretty.~";
    Talk:
      print "She doesn't answer. She just looks at you shyly and plays with her hair.^";
      ShowTutorial(TUT_ASK);
      rtrue;
  ],
  before
  [;
    Take, Touch:
      "That could get you into a lot of trouble.";
  ],
has animate female transparent;

!----------------------------------------
! Brass key
!----------------------------------------
Object brass_key "brass key" girl
with
  name 'brass' 'key' 'keys//p',
  description
  [;
    print "It's a small brass key. ";
    if (cupboard hasnt general)
      "It's too small for a door key, so it probably unlocks some sort of furniture, like a chest or a wardrobe.";
    else
      print_ret (string)YOU_KNOW_THAT_IT_UNLOCKS, "cupboard in the shop in San Francisco.";
  ],
has;

!========================================
! Room 25: Back Yard
!========================================
Object room25 "Back Yard"
with
  description "You're in a fenced-in back yard. It's totally devoid of anything of value. This family can't even afford rubbish. There's a narrow staircase to the north that goes up to the general store.",
  n_to room24,
  s_to FENCE_SURROUNDING_YARD,
  e_to FENCE_SURROUNDING_YARD,
  w_to FENCE_SURROUNDING_YARD,
  u_to room24,
  before
  [;
    Hint:
      if (room26 hasnt visited && fence hasnt general)
        "Examine the fence.";
      if (room26 hasnt visited)
        "What are you waiting for? Climb over the fence.";
  ],
has light;

!----------------------------------------
! Back yard
!----------------------------------------
Object "back yard" room25
with
  name 'back' 'yard' 'backyard',
  description "The back yard is bare. There's not even any rubbish. Maybe they just toss it over the fence.",
has scenery;

!----------------------------------------
! Fence (floating object)
!----------------------------------------
Object fence "fence"
with
  name 'fence' 'wood' 'wooden' 'paling',
  description
  [;
    give self general;
    print "It's a wooden paling fence.";
    if (room26 hasnt visited)
      print " A nimble person like you could probably climb over it.";
    "";
  ],
  before
  [;
    Climb:
      print "You deftly climb over the fence at the ";
      if (self in room25)
      {
        print "south side of the back yard.^^";
        PlayerTo(room26);
      }
      else
      {
        print "north side of the garbage dump.^^";
        PlayerTo(room25);
      }
      rtrue;
  ],
  found_in room25 room26,
has static;

!========================================
! Room 26: Garbage Dump
!========================================
Object room26 "Garbage Dump"
with
  description "You're in a garbage dump with no obvious exits apart from over the fence to the north.",
  n_to "There's a fence in the way. You'd have to climb over it.",
  before
  [;
    Hint:
      if (wheel in nothing || satchel in nothing)
        "Examine the garbage.";
      if (wheel hasnt moved)
        print_ret (string)DONT_FORGET_THE, "wheel.";
      if (satchel hasnt moved)
        print_ret (string)DONT_FORGET_THE, "satchel.";
      print_ret (string)GO_BACK_WAY_YOU_CAME;
    Smell:
      if (noun == nothing)
        "This area has the distinct smell of industrial waste. Let's say, it doesn't exactly smell like roses.";
  ],
has light;

!----------------------------------------
! Heap of garbage
!----------------------------------------
Object garbage "heap of garbage" room26
with
  name 'garbage' 'trash' 'rubbish' 'dump' 'heap' 'of',
  description
  [;
    print "You scrounge around in the garbage ";
    if (wheel in nothing)
    {
      move wheel to location;
      "and find an old wheel. You wonder what other goodies might be in there.";
    }
    if (satchel in nothing)
    {
      move satchel to location;
      "again and find a perfectly good satchel. Why would anyone throw that away? Oh, wait, the flap is missing.";
    }
    "once more. One man's trash is another man's treasure, but all you find is the first man's trash.";
  ],
  before
  [;
    Search:
      <<Examine self>>;
    Take:
      "You're joking, right?";
  ],
has static;

!----------------------------------------
! Wheel
!----------------------------------------
Object wheel "small metal wheel"
with
  name 'small' 'metal' 'spoked' 'wheel',
  description
  [;
    print "It's a small metal, spoked wheel about 30 cm in diameter. ";
    if (gym_door has general)
      "It's screwed onto the gym door.";
    else
      "It looks like it came off some sort of machinery and has a threaded hole in the centre.";
  ],
  before
  [;
    Screw:
      if (gym_door has general)
        "It's already screwed tightly onto the door. You can now turn it, if you want to, or unscrew it to remove it.";
      if (self notin player)
        "You need to be holding it first.";
      if (second == nothing && location == room08)
      {
        print "(onto the door)^";
        second = gym_door;
      }
      if (second == nothing)
        print_ret (string)YOULL_HAVE_TO_TELL_ME_WHAT_TO, "screw it onto.";
      if (second ~= gym_door or metal_bar or thread)
        "You can't screw it onto ", (ThatOrThose)second, ".";
      give gym_door general ~locked;
      move self to limbo;
      "You screw the wheel tightly onto the thread of the metal bar that protrudes from the door. Luckily for you, it's a good fit. You should now be able to turn the wheel to open the door.";
    Take:
      if (gym_door has general)
        "You'll have to unscrew it from the door before you can take it.";
    Turn:
      if (self in player)
        "You turn the wheel like you're driving a tractor, but you're not driving a tractor, so nothing happens.";
      if (gym_door hasnt general)
        rfalse;
      if (gym_door has open)
        "Nothing happens, as the door is already open.";
      <<Open gym_door>>;
    Unscrew:
      if (gym_door hasnt general)
        "It's not screwed onto anything.";
      if (second == nothing && location == room08)
        print "(from the door)^";
      give gym_door ~general;
      if (gym_door hasnt open)
        give gym_door locked;
      move wheel to location;
      "Oof, it's tight. You give the wheel a sharp nudge to break the seal, then unscrew it from the door. Clang! Whoops, you forgot how heavy it was and it falls to the floor.";
  ],
  add_to_scope
  [;
    if (self hasnt general)
      PlaceInScope(threaded_hole);
  ],
has;

!----------------------------------------
! Threaded hole
!----------------------------------------
Object threaded_hole "threaded hole"
with
  name 'threaded' 'hole' 'centre' 'center',
  description "It's a threaded hole in the centre of the wheel, so the wheel can obviously be screwed onto something.",
has scenery;

!----------------------------------------
! Satchel
!----------------------------------------
Object satchel "satchel"
with
  name 'satchel' 'large' 'canvas' 'bag',
  description
  [;
    print "It's a large canvas bag that would normally be closed by a flap, but the flap is missing. It's carried over the shoulder by a long strap. ";
    <<Search self>>;
  ],
  invent
  [;
    if (inventory_stage == 2 && child(self) == 0)
    {
      if (self has worn)
        print " (worn)";
      rtrue;
    }
  ],
  react_before
  [;
    Drop, Give, Show:
      if (noun in self && children(player) < MAX_CARRIED)
      {
        print "(first taking ", (the)noun, " out of the satchel)^";
        move noun to player;
      }
  ],
  before
  [;
    Receive:
      if (noun == axe or trampoline)
        print_ret (The)noun, " is too large to fit in the satchel.";
      if (noun == rope && trampoline has general)
        "You can't put the rope in the satchel while it's tied to the trampoline.";
      if (noun == lamp && lamp has light)
        "You'd better extinguish the lamp before putting it in the satchel.";
  ],
  add_to_scope flap strap,
has clothing container open;

!----------------------------------------
! Flap
!----------------------------------------
Object flap "flap"
with
  name 'flap',
  description "The flap is missing.",
has scenery;

!----------------------------------------
! Strap
!----------------------------------------
Object strap "strap"
with
  name 'long' 'strap',
  description "You use the strap to wear the satchel over your shoulder.",
has scenery;

!========================================
! Room 27: Abandoned Shop
!========================================
Object room27 "Abandoned Shop"
with
  description "You're in an abandoned shop. The roof has partially collapsed, letting in the pale moonlight. The floor is strewn with rubble from the collapse. The exit is to the west.",
  w_to room22,
  before
  [;
    Hint:
      if (hobo hasnt general)
        "Did you examine the hobo? Try waking him.";
      if (bread in nothing)
        print_ret (string)TALK_TO_HOBO, (string)COME_BACK_WHEN, "you know what he wants.";
      if (bread notin limbo)
        print_ret (string)TALK_TO_HOBO, "If he's hungry, give him some food.";
      if (champagne notin limbo && wine notin limbo)
        print_ret (string)TALK_TO_HOBO, (string)GIVE_HIM_A_DRINK;
      if (champagne in limbo && cork hasnt moved)
        "Did you check the damage after the champagne bottle broke? There's something you'll need there.";
      if (champagne in limbo && wine notin limbo)
        print_ret (string)TALK_TO_HOBO, (string)GIVE_HIM_A_DRINK;
  ],
has light;

!----------------------------------------
! Abandoned shop
!----------------------------------------
Object "abandoned shop" room27
with
  article AN,
  name 'abandoned' 'shop' 'floor',
  description "The shop is dirty and dusty with some rubble from the partially collapsed roof on the floor.",
has scenery;

!----------------------------------------
! Hole in roof
!----------------------------------------
Object "roof" room27
with
  name 'hole' 'collapsed' 'roof' 'ceiling' 'pale' 'moonlight' 'sky',
  description "There's a hole in the roof, where it has collapsed to let in the moonlight.",
has scenery;

!----------------------------------------
! Rubble
!----------------------------------------
Object "rubble" room27
with
  name 'rubble' 'debris',
  description "Don't waste your time with that. It's just the debris from the collapsed roof.",
  before
  [;
    Search:
      <<Examine self>>;
  ],
has scenery;

!----------------------------------------
! Hobo
!----------------------------------------
Object hobo "hobo" room27
with
  name 'hobo' 'man' 'dirty' 'scruffy' 'bum' 'derelict' 'derro',
  description
  [;
    print "He's a dirty, scruffy man that looks down on his luck. He's wrapped in a trench coat in a desperate bid to keep warm.";
    if (self hasnt general)
      " He's currently fast asleep and snoring like a wild animal.";
    print "^";
    ShowTutorial(TUT_TALK);
    rtrue;
  ],
  life
  [;
    if (self hasnt general && action ~= ##WakeOther)
      "He's asleep, so you'd have to wake him first.";
    Ask:
      wn = consult_from;
      switch (NextWord())
      {
        'accountant', 'accountancy':
          "~If ya wanna know about accountancy, don't ask me. I was a complete failure at it.~";
        'alcohol', 'booze', 'champagne', 'drink', 'grog', 'liquor', 'wine':
          if (wine notin limbo)
            "~Man is not a camel. I'm dyin' for a drink. Ya got any grog?~";
          else
            "~Thanks for the grog. I needed that ta lubricate me tonsils.~";
        'bread', 'food', 'meal':
          if (bread notin limbo)
            "~Food. You know, stuff ya eat. Have ya got any? I'm famished.~";
          else
            "~That loaf of bread was very fillin'. Thanks. Much appreciated.~";
        'bum', 'derelict', 'derro', 'hobo':
          "~I'm not a bum. I'm just a bit down on me luck. Could happen ta anyone.~";
        'city', 'san', 'francisco', 'frisco', 'hilton':
          "~Been livin' here all me life. The locals call it 'Frisco'. Used ta live on the bay. Now I'm up holed up here in the Frisco Hilton.~ He waves his arm in a grand gesture to indicate that the abandoned shop is the 'Frisco Hilton'.";
        'crystal', 'crystals':
          "~Sorry, chum. I don't know anythin' about any crystals. The last time I saw any crystals, they were hangin' around the neck of some rich broad.~";
        'him', 'himself':
          "~I used ta be an accountant. Would ya believe it? Then the stock exchange took a turn for the worse and I lost a motsa. Had ta sell everythin' ta pay off me debts and here I am.~";
        'motsa', 'motza':
          "~It's Aussie slang. Picked it up from a mate of mine. It means a large sum of money.~";
        'time':
          "~You've gotta watch. I should be askin' you the time.~";
        default:
          "~I don't mean ta be rude, but I've got no idea what ya talkin' about.~";
      }
    Give:
      if (noun hasnt edible)
        print_ret (string)CANT_EAT_OR_DRINK_THAT;
      if (noun == banana)
        "He takes the banana, looks at it disapprovingly, then hands it back to you. ~No, thanks. I'm not a monkey. Haven't ya got any bread?~";
      if (noun == bread)
      {
        move bread to limbo;
        "The hobo grabs the bread off you and scoffs it down. In amongst mouthfuls, he says, ~Thanks buddy. Your blood's worth bottlin'. I don't s'pose you'd have anythin' ta wash it down with, would ya?~";
      }
      if (noun == wine or champagne && bread notin limbo)
        "The hobo politely declines your offer. ~Thanks, but I can't drink on an empty stomach. Have ya got any food?~";
      if (noun == wine)
      {
        move wine to limbo;
        move matches to player;
        "The hobo is overwhelmed. ~Gee, thanks buddy, but how can I repay ya? I ain't got much.~ He rummages around in his pockets and gives you a box of matches. ~Afraid that's all I've got, but you're welcome to them.~";
      }
      if (noun == champagne)
      {
        move champagne to limbo;
        move glass to location;
        give cork ~scenery;
        move cork to location;
        "The hobo is so surprised at the gift of champagne that, in his excitement, he drops the bottle. ", (string)IT_SHATTERS_INTO_PIECES, " He gives a philosophical shrug. ~Damn, what a waste of good grog.~";
      }
    Show:
      if (noun hasnt edible)
        print_ret (string)CANT_EAT_OR_DRINK_THAT;
      else
        "His eyes light up. ~If ya don't want that, I'm happy ta take it off ya hands for ya.~";
    Talk:
      print "The hobo looks at you through bloodshot eyes. ";
      if (bread notin limbo)
        print "~Ya got any food? I ain't eaten for days.~^";
      else
      {
        if (wine notin limbo)
          print "~Got any liquor, buddy?~^";
        else
          print "~I appreciate ya generosity. but I've got nothin' else ta can give ya. If ya wanna know about anythin' just ask.~^";
      }
      ShowTutorial(TUT_ASK);
      rtrue;
    WakeOther:
      if (self has general)
        "He's already awake.";
      give self general;
      "You give the hobo a shake to wake him up. ~Er, whassup? I didn't do it.~ He rubs his eyes and stares at you. ~Oh, you're not a cop. What do you want? I ain't got no money, so ya can't rob me.~";
  ],
  before
  [;
    Search:
      "He may be a hobo, but he deserves some privacy.";
  ],
has animate transparent;

!----------------------------------------
! Trench coat
!----------------------------------------
Object "trench coat" hobo
with
  name 'trench' 'coat' 'trenchcoat' 'tatty-looking' 'tatty' 'looking',
  description "It's a tatty-looking coat that looks like it hasn't been washed in a hundred years.",
has static;

!----------------------------------------
! Box of matches
!----------------------------------------
Object matches "matches"
class OpenContainer
with
  article "a box of",
  name 'box' 'of' 'safety' 'matches' 'matchbox',
  description "It's a box of safety matches.",
  before
  [;
    Count:
      "There are plenty of matches in the matchbox. There's no need to count them.";
    Open:
      "There's no need to open it first. If you want a match, just TAKE MATCH or LIGHT MATCH and I'll open and close the matchbox for you.";
    Receive:
      if (noun ~= match)
        print_ret (string)YOU_CANT_PUT_ANYTHING_IN_THE, "matchbox, other than matches.";
  ],
  add_to_scope dummy_match,
has container open pluralname;

!----------------------------------------
! Dummy match
!----------------------------------------
Object dummy_match "match"
with
  parse_name
  [;
    if (NextWord() == 'match' && ~~TestScope(match))
      return 1;
    return 0;
  ],
  description "You can't see the matches while they're in the matchbox. Why not take one?",
  before
  [;
    Burn:
      if (match notin nothing)
        "Use the one you've already taken.";
      move match to player;
      PronounNotice(match);
      give match light;
      StartTimer(match, 2);
      print (string)YOU_TAKE_A_MATCH, " and light it, but it won't last very long.^";
      if (location == thedark)
      {
        new_line;
        PlayerTo(real_location, 2);
      }
      rtrue;
    Take:
      if (match notin nothing)
        "You've already taken one.";
      move match to player;
      PronounNotice(match);
      print_ret (string)YOU_TAKE_A_MATCH, ".";
  ],
has scenery;

!----------------------------------------
! Match
!----------------------------------------
Object match "match"
with
  name 'match',
  description
  [;
    print "It's a safety match";
    if (self has light)
      print " that burns with a flickering flame, but the flame won't last long";
    ".";
  ],
  before
  [;
    Burn:
      if (self has light)
        "It's already lit.";
      if (self notin player)
        "You're not holding it.";
      if (matches notin player)
        "You need the matchbox to light it.";
      give self light;
      StartTimer(self, 2);
      print "You light the match, but it won't last very long.^";
      if (location == thedark)
      {
        new_line;
        PlayerTo(real_location, 2);
      }
      rtrue;
    Extinguish:
      if (self hasnt light)
        "It's not lit.";
      give self ~light;
      remove self;
      StopTimer(self);
      print "You blow out the match and throw it away.^";
      if (real_location hasnt light)
      {
        new_line;
        PlayerTo(location, 2);
      }
      rtrue;
    Insert:
      if (second == matches && self has light)
        "Not while it's lit!";
      if (second == matches)
      {
        remove self;
        "You put the match back in the matchbox.";
      }
  ],
  time_out
  [;
    if (TestScope(self))
      print "^The match goes out.^";
    give self ~light;
    remove self;
    if (real_location hasnt light)
    {
      new_line;
      PlayerTo(location, 2);
    }
    rtrue;
  ],
  time_left,
has;

!========================================
! Room 28: City Street
!========================================
Object room28 "City Street"
with
  description "You're at a bend in the street in a run-down area of the city. There's a shop to the west and the street heads off to the south and east.",
  s_to room22,
  e_to room30,
  w_to room29,
  before
  [;
    Hint:
      if (room29 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "west yet.";
      if (room30 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "east yet.";
  ],
has light;

!========================================
! Room 29: Shop
!========================================
Object room29 "Shop"
with
  description "You're in a murky shop with bits of ships' equipment scattered around the walls and hanging from the ceiling. The exit is to the east.",
  e_to room28,
  before
  [;
    Hint:
      if (cupboard has locked && brass_key in girl)
        print_ret (string)HAVE_YOU_TRIED, "opening the cupboard? ", (string)COME_BACK_WHEN, "you've got the key.";
      if (cupboard has locked)
        print_ret (string)TRY_UNLOCKING_THE, "cupboard.";
      if (cupboard hasnt open && crowbar hasnt moved)
        print_ret (string)OPEN_THE, "cupboard.";
      if (crowbar hasnt moved)
        print_ret (string)DONT_FORGET_THE, "crowbar.";
  ],
has light;

!----------------------------------------
! Shop
!----------------------------------------
Object "shop" room29
with
  name 'shop' 'murky' 'ceiling' 'wall' 'walls',
  description
  [;
    "It's full of ships' supplies. You can't see anything that will help with your quest for ", (string)THE_TIME_CRYSTALS_OF_CYTHII, ".";
  ],
has scenery;

!----------------------------------------
! Ships' supplies
!----------------------------------------
Object "ship's' supplies" room29
with
  name 'ships^' 'ship^s' 'supplies' 'equipment',
  description "As you're not a sailor, you have no idea what any of this equipment is or what it's used for. It's probably best to leave it alone.",
has scenery;

!----------------------------------------
! Cupboard
!----------------------------------------
Object cupboard "cupboard" room29
class OpenableContainer
with
  name 'cupboard' 'large' 'wood' 'wooden',
  description
  [;
    print "It's a large wooden cupboard with no distinguishing features. ";
    <<Search self>>;
  ],
  after
  [;
    Unlock:
      give self general;
  ],
  with_key brass_key,
has container lockable locked openable static;

!----------------------------------------
! Crowbar
!----------------------------------------
Object crowbar "crowbar" cupboard
with
  name 'crowbar' 'strong' 'steel' 'prybar',
  description "It's a strong steel crowbar, about 30 cm long, with a curve at one end and flattened points, used to force two objects apart.",
has;

!========================================
! Room 30: Wharf
!========================================
Object room30 "Wharf"
with
  description "You're on a wide timber wharf that juts out into the bay. It's creepily quiet, but you're sure that will change when the sun comes up. You can leave the wharf to the west.",
  w_to room28,
  before
  [;
    Hint:
      if (crate has locked && crowbar hasnt moved)
        print_ret (string)HAVE_YOU_TRIED, "opening the crate? ", (string)COME_BACK_WHEN_YOUVE_FOUND, "something to pry it open.";
      if (crate has locked)
        print_ret (string)HAVE_YOU_TRIED, "opening the crate? Pry it open with something you found earlier.";
      if (banana in nothing)
        "Those bananas look yummy. Why not take one?";
    Listen:
      if (noun == nothing)
        "You can hear the water lapping against the piers of the wharf.";
    Swim:
      "You have no reason to take an early morning dip.";
  ],
has light;

!----------------------------------------
! Wharf
!----------------------------------------
Object "wharf" room30
with
  name 'wharf' 'wide' 'timber',
  description "You imagine that this would be a hive of activity during the day with ships loading and unloading, but it's now quiet apart from the water below.",
has scenery;

!----------------------------------------
! Water in the bay
!----------------------------------------
Object "water" room30
with
  name 'water' 'bay',
  description "The water in the bay looks deep and dark. Don't fall in.",
  before
  [;
    Enter:
      <<Swim>>;
  ],
has scenery;

!----------------------------------------
! Crate
!----------------------------------------
Object crate "crate" room30
class OpenableContainer
with
  name 'crate' 'box',
  description
  [;
    print "It's a heavy wooden crate with 'BANANAS' stencilled on it in black paint. ";
    <<Search self>>;
  ],
  before
  [;
    Attack:
      if (self hasnt locked)
        "What's the point? You've already pried it open.";
      if (second == nothing && crowbar in player)
      {
        print "(with the crowbar)^";
        second = crowbar;
      }
      if (second == nothing)
        "You can't pry it open with your bare hands.";
      if (second == axe)
        "Don't be so destructive. You only need to pry it open, not turn it into firewood.";
      if (second ~= crowbar)
        "You can't pry the crate open with ", (ThatorThose)second, ".";
      give self ~locked;
      print "You pry the crate open with the crowbar. ";
      <<Open self>>;
    Enter:
      if (self has locked)
        "You step onto the crate and look around, then step down again.";
      else
        "There's not enough room for you with all those bananas.";
    Open:
      if (self has locked)
        "It's nailed shut. You'd have to pry it open somehow.";
    Receive:
      if (noun ~= banana)
        "You can't put ", (the)noun, " in the crate, as it's intended for bananas.";
      remove noun;
      "You put the banana back in the crate with the others.";
    Take:
      "That's far too heavy for a puny pipsqueak like you.";
  ],
has container locked openable static;

!----------------------------------------
! Bananas
!----------------------------------------
Object "bananas" crate
with
  name 'bunches' 'of' 'bananas',
  description "They're large bunches of green bananas, so they're not suitable for eating. However, there's also a few loose bananas that look ripe enough to eat.",
  before
  [;
    Take:
      "You can't take them all!";
  ],
has pluralname static;

!----------------------------------------
! Dummy banana
!----------------------------------------
Object dummy_banana "banana" crate
with
  name 'banana',
  parse_name
  [;
    if (TestScope(banana))
      return 0;
    else
      return -1;
  ],
  description "There's more than one banana.",
  before
  [;
    Take:
      if (banana notin nothing)
        "You've already taken one.";
      if (children(player) == MAX_CARRIED)
      {
        PrintMsg(MSG_TAKE_NO_CAPACITY);
        rtrue;
      }
      move banana to player;
      PronounNotice(banana);
      "You sort through the loose bananas and take one of the ripe ones.";
  ],
has scenery;

!----------------------------------------
! Banana
!----------------------------------------
Object banana "banana"
with
  name 'banana',
  description "It's a ripe yellow banana. It looks yummy.",
  before
  [;
    Eat:
      remove self;
      "You peel the skin and toss it away, then eat the banana. Yum. I hope you don't need it later. If you do, you could probably get another one.";
  ],
has edible;

!========================================
! Room 31: Observation Room
!========================================
Object room31 "Observation Room"
with
  description
  [;
    if (self hasnt visited)
      print "It's early in the evening. You feel a gentle vibration beneath your feet and a muffled engine noise, like an aircraft propeller.^^";
    "You're in the sparsely-furnished observation room of an airship. The curved port and starboard walls are lined with windows that join in a tight curve at the stern of the ship. The only exit is fore. There's also a ladder leading up, but you can't see where it goes because the top of the ladder is obscured by a strange mist.";
  ],
  n_to room32,
  u_to
  [;
    date = TIME_TOWER;
    SetTime(save_time, 1);
    ship_directions_enabled = false;
    print (string)TIME_WARP;
    print (italic)"[Use compass directions (N, S, E, W) now that you're no longer on the airship.]^^";
    return room02;
  ],
  before
  [;
    Hint:
      if (plaque hasnt general)
        print_ret (string)NEED_TO_WORK_OUT_WHERE, "Do what is suggested the first time you examine the plaque.";
      if (room32 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "fore yet.";
      if (note in nothing)
        "Poor Willy is all by himself. Talk to him.";
      if (note hasnt moved)
        print_ret (string)DONT_FORGET_THE, "note.";
      if (note notin pruss)
        print_ret (string)DO_WHAT_WILLY_ASKED;
    Listen:
      if (noun == nothing)
        print_ret (string)YOU_HEAR_DULL_DRONE;
  ],
  daemon
  [;
    if (the_time == 1102) !6:22 p.m.
      print_ret (string)SPECK_YELLS_OUT, "landing now!~";
    if (the_time < 1140)
      rfalse;
    switch (the_time)
    {
      1140: !7:00 p.m.
        print "^The airship starts on its final approach to Lakehurst Naval Air Station. ";
        if (location ~= room33)
          print_ret (string)HEAR_VOICES_TO_FORE;
        else
          print_ret (string)SAMMT_CALLS_OUT, "200 m.~";
      1141: !7:01 p.m.
        new_line;
        if (location ~= room33)
          print_ret (string)HEAR_VOICES_TO_FORE;
        else
          print_ret (string)HERZOG_ANNOUNCES_HEADING, "northeast.~";
      1148: !7:08 p.m.
          print_ret (string)SPECK_YELLS_OUT, "the earliest possible landing!~";
      1149: !7:09 p.m.
        new_line;
        if (location ~= room33)
          print (string)HEAR_VOICES_TO_FORE;
        else
          print "Captain Pruss calls out, ~Sharp turn to port around the landing field. Commence landing sequence.~^^Schoenherr responds, ~Turning to port.~^^", (string)HERZOG_ANNOUNCES_HEADING, "north.~";
         " The airship makes a sharp full-speed left turn.";
      1150: !7:10 p.m.
        new_line;
        if (location ~= room33)
          print_ret (string)HEAR_VOICES_TO_FORE;
        else
          print_ret (string)HERZOG_ANNOUNCES_HEADING, "northwest and holding.~";
      1151: !7:11 p.m.
        print "^The airship starts its turn back towards the landing field. ";
        if (location ~= room33)
          print_ret (string)HEAR_VOICES_TO_FORE;
        else
          "Ziegler yells out, ~Valving gas for 15 seconds.~^^", (string)SAMMT_CALLS_OUT, "180 m.~^^", (string)HERZOG_ANNOUNCES_HEADING, "west...heading southwest.~";
      1152: !7:12 p.m.
        new_line;
        if (location ~= room33)
          print (string)HEAR_VOICES_TO_FORE;
        else
          print (string)HERZOG_ANNOUNCES_HEADING, "south...heading southeast.~^^", (string)CAPTAIN_PRUSS_ORDERS, "All engines idle ahead!~";
        " The airship begins to slow.";
      1153: !7:13 p.m.
        new_line;
        if (location ~= room33)
          print_ret (string)HEAR_VOICES_TO_FORE;
        else
          "Ziegler yells out, ~Valving gas for 15 seconds.~^^", (string)CAPTAIN_PRUSS_ORDERS, "All engines idle astern!~";
      1154: !7:14 p.m.
        new_line;
        if (location ~= room33)
          print_ret (string)HEAR_VOICES_TO_FORE;
        else
          print_ret (string)CAPTAIN_PRUSS_ORDERS, "Aft engines full astern!~";
      1155: !7:15 p.m.
        new_line;
        if (location ~= room33)
          print_ret (string)HEAR_VOICES_TO_FORE;
        else
          print_ret (string)CAPTAIN_PRUSS_ORDERS, "Aft engines idle astern!~^^", (string)SAMMT_CALLS_OUT, "120 m!~";
      1157: !7:17 p.m.
        print "^The wind shifts direction from east to southwest. ";
        if (location ~= room33)
          print (string)HEAR_VOICES_TO_FORE;
        else
          print (string)CAPTAIN_PRUSS_ORDERS, "Sharp turn starboard!~^^Schoenherr responds, ~Turning to starboard.~";
        " The ship starts on an S-shaped flight path towards the mooring mast.";
      1158: !7:18 p.m.
        print "^The airship appears to be stern heavy. ";
        if (location ~= room33)
          print_ret (string)HEAR_VOICES_TO_FORE;
        else
          print_ret (string)CAPTAIN_PRUSS_ORDERS, "Drop water ballast!~^^Bauer responds, ~Dropping water ballast.~^^Ziegler also calls out, ~Valving forward gas cells!~";
      1159: !7:19 p.m.
        new_line;
        if (location ~= room33)
          print_ret (string)HEAR_VOICES_TO_FORE;
        else
          "As the previous measures fail to bring the ship into trim, ", (string)CAPTAIN_PRUSS_GETS_ON_TELEGRAPH, ". ~Send six men to the bow to trim the ship.~";
      1161: !7:21 p.m.
        new_line;
        if (location ~= room33)
          print_ret (string)HEAR_VOICES_TO_FORE;
        else
          print_ret (string)SAMMT_CALLS_OUT, "90 m.~^^", (string)CAPTAIN_PRUSS_GETS_ON_TELEGRAPH, " again, ~Drop mooring lines.~";
      1162: !7:22 p.m.
        "^The starboard mooring line is dropped from the bow. A light rain begins to fall as the ground crew grab the mooring line. ", (string)YOUD_BETTER_GET_BACK;
      1163: !7:23 p.m.
        "^The port mooring line is dropped from the bow. The line is overtightened as it's connected to the post of the ground winch. The starboard line hasn't been connected yet. ", (string)YOUD_BETTER_GET_BACK;
      1164: !7:24 p.m.
        "^There's tension in the air as the crew waits for the mooring to be completed. ", (string)YOUD_BETTER_GET_BACK;
      1165: !7:25 p.m.
        deadflag = 1;
        "^All of a sudden, the Hindenburg catches fire and dives towards the field adjacent to the mooring mast. Within seconds, it's engulfed in flames and you're in the middle of it!^^13 of the 36 passengers and 22 of the 61 crew die in the disaster, along with one member of the ground crew and one guardian of ", (string)THE_TIME_CRYSTALS_OF_CYTHII, ", who shouldn't have been there in the first place.";
    }
    rfalse;
  ],
has light;

!----------------------------------------
! Airship (floating object)
!----------------------------------------
Object "airship"
with
  article AN,
  name 'airship' 'ship' 'hull' 'gondola' 'hindenburg' 'aluminium' 'framework',
  description "You can't see what it looks like from the outside, but from the inside, the airship looks to be a fairly sturdy construction with an aluminium framework.",
  found_in room31 room32 room33,
has scenery;

!----------------------------------------
! Windows (floating object)
!----------------------------------------
Object "windows"
with
  name 'window' 'windows' 'wall' 'walls',
  description
  [;
    "The windows line all the exterior walls. ", (string)CAN_SEE_LAKEHURST;
  ],
  before
  [;
    LookThrough:
      print_ret (string)CAN_SEE_LAKEHURST;
  ],
  found_in room31 room32 room33,
has pluralname scenery;

!----------------------------------------
! Lakehurst Naval Air Station (floating object)
!----------------------------------------
Object "Lakehurst Naval Air Station"
with
  name 'lakehurst' 'naval' 'air' 'station' 'ground',
  description CAN_SEE_LAKEHURST,
  found_in room31 room32 room33,
has proper scenery;

!----------------------------------------
! Uniforms (floating object)
!----------------------------------------
Object "uniforms"
with
  name 'uniform' 'uniforms',
  description "Each of the officers and crew wear the uniform of Deutsche Zeppelin-Reederei (DZR) with a name tag that allows you to identify them.",
  found_in room31 room32 room33,
has pluralname scenery;

!----------------------------------------
! Name tags (floating object)
!----------------------------------------
Object "name tags"
with
  name 'name' 'tag' 'tags',
  description "The name tags on the officers' and crew's uniforms allow you to identify them.",
  found_in room31 room32 room33,
has pluralname scenery;

!----------------------------------------
! Observation room
!----------------------------------------
Object "observation room" room31
with
  article AN,
  name 'observation' 'room' 'stern' 'sparsely-furnished' 'sparsely' 'furnished',
  description "The observation room is very confined. Apart from flight-related functions, it looks like it might be used for meetings or relaxation by the crew.",
has scenery;

!----------------------------------------
! Ladder
!----------------------------------------
Object "ladder" room31
with
  name 'ladder',
  description "The ladder leads up to a strange mist. You presume that the hull of the airship lies beyond the mist.",
  before
  [;
    Climb:
      <<Go FAKE_U_OBJ>>;
  ],
has scenery;

!----------------------------------------
! Radio
!----------------------------------------
Object "radio" room31
with
  name 'radio' 'telefunken' '200-watt' '200' 'watt' 'transmitters',
  description "You're no expert, but it looks like a radio with two Telefunken 200-watt transmitters, one for long wave transmissions and one for shortwave.",
has static;

!----------------------------------------
! Photo
!----------------------------------------
Object "photo" room31
with
  name 'framed' 'photo' 'photograph' 'of' 'adolf' 'hitler',
  description "It's a framed photo of Adolf Hitler. He has an unusually long black fringe that's in danger of poking him in the eyes. It also looks like he had an accident when he was trimming his moustache, as the outer halves are missing.",
  before
  [;
    Take:
      print_ret (string)FIRMLY_ATTACHED;
  ],
has static;

!----------------------------------------
! Sign
!----------------------------------------
Object "sign" room31
with
  name 'sign',
  description
  [;
    print "It's a large sign painted in red lettering on a white background.";
    if (self hasnt general)
      print " You should probably read it, in case it's important.";
    "";
  ],
  before
  [;
    Read:
      give self general;
      "It says, 'RAUCHEN VERBOTEN'.";
    Take:
      print_ret (string)FIRMLY_ATTACHED;
  ],
has static;

!----------------------------------------
! Plaque
!----------------------------------------
Object plaque "plaque" room31
with
  name 'brass' 'plaque',
  description
  [;
    print "It's a brass plaque screwed to the aluminium framework of the airship.";
    if (self hasnt general)
      print " It wouldn't hurt to read it.";
    "";
  ],
  before
  [;
    Read:
      give self general;
      print "An inscription on the plaque reads, 'LZ-129 Hindenburg'.^^Aha! This must be the airship that caught fire and was destroyed in seconds when attempting to dock with its mooring mast at Lakehurst Naval Air Station. You check your watch. Today is the day that the disaster occurred. You'll need to get off the airship before 7:25 p.m. or you'll be engulfed in the flames.^";
      ShowTutorial(TUT_TIME_LEFT);
      rtrue;
    Take:
      print_ret (string)FIRMLY_ATTACHED;
  ],
has static;

!----------------------------------------
! Willy Speck
!----------------------------------------
Object "Willy Speck" room31
with
  parse_name
  [ nw i flag;
    nw = NextWord();
    while (nw == 'willy' or 'speck' or 'chief' or 'radio' or 'officer' or 'man')
    {
      i++;
      if (nw == 'radio')
        flag++;
      nw = NextWord();
    }
    if (i == flag)
      return 0;
    return i;
  ],
  description
  [;
    print "Willy Speck is the chief radio officer. He's huddled over the radio listening intently to the radio transmissions from the control tower.^";
    ShowTutorial(TUT_TALK);
    rtrue;
  ],
  life
  [;
    Ask:
      "He doesn't seem to hear you over the radio. Either that, or he's ignoring you.";
    Talk:
      if (note notin nothing)
        "He's clearly occupied with the radio and waves to you to go away.";
      move note to location;
      "He places a note beside the radio. ~Here's the latest weather report from the control tower. Can you give it to the captain?~";
  ],
has animate proper;

!----------------------------------------
! Note
!----------------------------------------
Object note "note"
with
  name 'note' 'weather' 'report',
  description
  [;
    if (self in pruss)
      "You can't see it clearly now that Captain Pruss is holding it.";
    print "It's a hand-written note, in German of course.";
    if (self hasnt general)
      print " As you're quite fluent in many languages, you can read it if you want to.";
    "";
  ],
  before
  [;
    Drop:
      if (location == room33)
        "Don't drop it here. Give it to Captain Pruss.";
    Read:
      if (self in pruss)
      {
        print "It's a bit hard to read the note while Captain Pruss is holding it.";
        if (self hasnt general)
          print " You should have read it before you gave it to him.";
        "";
      }
      give self general;
      "Willy's hand-writing is near illegible. As best as you can make out, when translated from German, it says, 'Weather conditions have improved. Now suitable for landing. Wind direction anticipated to change from east to southwest.'";
  ],
has;

!========================================
! Room 32: Navigation Room
!========================================
Object room32 "Navigation Room"
with
  description "This room contains lots of navigation equipment that's no doubt used by the navigators. There are windows to port and starboard and other rooms to fore and aft.",
  n_to
  [;
    if (room33 has visited)
      return room33;
    if (note notin player)
    {
      give zabel general;
      print_ret (string)MAX_ZABEL_STOPS_YOU;
    }
    print (string)MAX_ZABEL_STOPS_YOU, "^^You explain that you have to deliver the note from Willy Speck to the captain. After briefly looking at the note, he says, ~Okay, go ahead.~^^";
    return room33;
  ],
  s_to room31,
  before
  [;
    Hint:
      if (room33 hasnt visited && zabel hasnt general)
        print_ret (string)YOU_HAVENT_BEEN, "fore yet.";
      if (room33 hasnt visited && note in nothing)
        "Do the navigators stop you going fore? ", (string)COME_BACK_WHEN, "you have permission to go there. Willy may help with that.";
      if (note notin pruss)
        print_ret (string)DO_WHAT_WILLY_ASKED;
    Listen:
      if (noun == nothing)
        print_ret (string)YOU_HEAR_DULL_DRONE;
  ],
has light;

!----------------------------------------
! Navigation room
!----------------------------------------
Object "navigation room" room32
with
  name 'navigation' 'room',
  description "This is where the navigation is carried out. Don't touch anything.",
has scenery;

!----------------------------------------
! Navigation equipment
!----------------------------------------
Object "navigation equipment" room32
with
  article SOME,
  name 'navigation' 'equipment' 'gyro' 'compass' 'repeater' 'repeaters' 'optical' 'drift' 'indicator' 'radio' 'direction' 'finding' 'altimeter' 'clock' 'stop' 'watch' 'watches',
  description "The navigation equipment includes gyro compass repeaters, drift measuring equipment, radio direction finding equipment, altimeter, clock and stop watches. Don't touch any of it.",
has scenery;

!----------------------------------------
! Work table
!----------------------------------------
Object work_table "work table" room32
class OpenContainer
with
  name 'work' 'table',
  description
  [;
    print "It's a plain metal, somewhat utilitarian, work table. ";
    <<Search self>>;
  ],
has static supporter;

!----------------------------------------
! Charts and maps
!----------------------------------------
Object "charts and maps" work_table
with
  name 'case' 'cases' 'chart' 'charts' 'map' 'maps',
  description "The most prominent charts map a route from Frankfurt, Germany to New Jersey, USA passing over Cologne, The Netherlands, the south of England, then across the North Atlantic, the southern tip of Greenland and Newfoundland.",
  before
  [;
    Take:
      "Christian Nielsen spins around. ~Hands off the maps. We need those.~";
  ],
has pluralname static;

!----------------------------------------
! Calendar
!----------------------------------------
Object calendar "calendar" work_table
with
  name 'calendar',
  description
  [;
    print "The date is 6 May 1937. ";
    if (plaque hasnt general)
      "That date rings a bell for some reason.";
    else
      "That's the day that the Hindenburg was destroyed in the largest airship disaster in history. You'd better get off the airship before 7:25 p.m., as that's when it catches fire.";
  ],
  before
  [;
    Read:
      <<Examine self>>;
  ],
has static;

!----------------------------------------
! Telephone
!----------------------------------------
Object "telephone" work_table
with
  name 'telephone' 'phone' '14-station' '14' 'station',
  description "It's a 14-station telephone with connections to various stations around the ship. It's for the crew's use only, so don't even think about using it.",
has static;

!----------------------------------------
! Max Zabel
!----------------------------------------
Object zabel "Max Zabel" room32
with
  name 'max' 'zabel' 'navigator',
  description "He's one of the navigators.",
  life
  [;
    Ask:
      "~I don't have time to talk to passengers.~";
    Talk:
      "~Who are you? Passengers shouldn't be down here. Go back upstairs.~";
  ],
has animate proper;

!----------------------------------------
! Christian Nielsen
!----------------------------------------
Object "Christian Nielsen" room32
with
  name 'christian' 'nielsen' 'navigator',
  description "He's one of the navigators.",
  life
  [;
    Ask:
      "~Go away. We're busy with the landing sequence.~";
    Talk:
      "~Why are you down here? This area is for crew only.~";
  ],
has animate proper;

!========================================
! Room 33: Control Room
!========================================
Object room33 "Control Room"
with
  description "You're in the control room at the bow of the airship's gondola. It's surrounded by windows and various control instruments. It's also full of officers and crew. You can identify them by the name tags on their uniforms. A low humming can be heard from the airship's engines. The only exit is to aft.",
  s_to room32,
  before
  [;
    Hint:
      if (binoculars in pruss && pruss hasnt general)
        "Examine Captain Pruss.";
      if (binoculars in pruss)
        print_ret (string)DO_WHAT_WILLY_ASKED;
    Listen:
      if (noun == nothing)
        print_ret (string)YOU_HEAR_DULL_DRONE;
  ],
has light;

!----------------------------------------
! Control room
!----------------------------------------
Object "control room" room33
with
  name 'control' 'room' 'bow',
  description "The control room is a hive of activity. This is where the captain and crew control the ship.",
has scenery;

!----------------------------------------
! Officers and crew
!----------------------------------------
Object "officers and crew" room33
with
  name 'crew' 'officers',
  description "The officers consist of Pruss, Sammt, Bauer and Ziegler. Lehmann and Wittemann are also officers, but they're only here as observers. The crew consists of Schoenherr, Herzog and Boetius.",
  life
  [;
    "If you want to interact with the officers or crew, you'll have to address them by name, e.g. TALK TO PRUSS.";
  ],
has animate pluralname scenery;

!----------------------------------------
! Instruments and controls
!----------------------------------------
Object "instruments and controls" room33
with
  name 'instruments' 'controls',
  description "The instruments and controls are many and varied. Rather than list them all, examine each of the officers and crew to see what instruments and controls they're using.",
has scenery;

!----------------------------------------
! Engine telegraph
!----------------------------------------
Object "engine telegraph" room33
with
  article AN,
  name 'engine' 'telegraph',
  description "The engine telegraph is located on the starboard side of the gondola. It's used to transmit orders to the mechanics stationed in each of the four engine cars. Adjacent to the engine telegraph is a tachometer, altimeter, Echolot, variometer and speaking tube.",
has scenery;

!----------------------------------------
! Tachometer
!----------------------------------------
Object "tachometer" room33
with
  name 'tachometer' 'tacho',
  description "The tachometer indicates the horizontal speed.",
has scenery;

!----------------------------------------
! Altimeter
!----------------------------------------
Object "altimeter" room33
with
  article AN,
  name 'altimeter',
  description "The altimeter indicates the altitude.",
has scenery;

!----------------------------------------
! Echolot (sonar altimeter)
!----------------------------------------
Object "Echolot" room33
with
  article AN,
  parse_name
  [ nw i flag;
    nw = NextWord();
    while (nw == 'echolot' or 'echo' or 'sounder' or 'sonic' or 'altimeter' or 'sonar')
    {
      i++;
      if (nw == 'altimeter')
        flag++;
      nw = NextWord();
    }
    if (i == flag)
      return 0;
    return i;
  ],
  description "Echolot is the German word for echo sounder. It's a sonic altimeter that uses sonar to measure the ship's height above the ground.",
has scenery;

!----------------------------------------
! Variometer
!----------------------------------------
Object "variometer" room33
with
  name 'variometer',
  description "The variometer indicates the vertical speed.",
has scenery;

!----------------------------------------
! Speaking tube
!----------------------------------------
Object "speaking tube" room33
with
  name 'speaking' 'tube',
  description "The speaking tube is used to communicate with the riggers along the axial catwalk. Communication throughout the ship is normally by telephone, but no electrical equipment is placed along the axial catwalk in order to avoid the risk of sparks.",
has scenery;

!----------------------------------------
! Rudder wheel
!----------------------------------------
Object "rudder wheel" room33
with
  name 'rudder' 'wheel',
  description "The rudder wheel is located at the bow of the gondola and controls the heading. There's also a gyro compass repeater in front of the wheel and the automatic pilot to one side.",
has scenery;

!----------------------------------------
! Gyro compass repeater
!----------------------------------------
Object "gyro compass repeater" room33
with
  name 'gyro' 'compass' 'repeater',
  description "The gyro compass repeater is controlled by the master gyroscopic compass located in the ship's electrical room.",
has scenery;

!----------------------------------------
! Elevator wheel
!----------------------------------------
Object "elevator wheel" room33
with
  article AN,
  name 'elevator' 'wheel',
  description "The elevator wheel is located adjacent to the elevator panel on the port side of the ship. This controls the pitch.",
has scenery;

!----------------------------------------
! Elevator panel
!----------------------------------------
Object "elevator panel" room33
with
  article AN,
  name 'elevator' 'panel',
  description "The elevator panel contains various instruments to keep the elevatorman aware of the position of the elevators, the pitch of the ship and the factors influencing pitch and altitude.",
has scenery;

!----------------------------------------
! Automatic pilot
!----------------------------------------
Object "automatic pilot" room33
with
  article AN,
  name 'automatic' 'pilot',
  description "You can see that the automatic pilot is made by the Anschutz Company of Kiel. It utilises servo motors to control the rudder and elevators, but it's only used in calm conditions. It's not in use now.",
has scenery;

!----------------------------------------
! Ballast control board
!----------------------------------------
Object "ballast control board" room33
with
  name 'ballast' 'control' 'board',
  description "The ballast control board is located on the port side of the gondola. It's used to reduce the static weight of the ship by releasing water ballast.",
has scenery;

!----------------------------------------
! Gas valve control board
!----------------------------------------
Object "gas control board" room33
with
  name 'gas' 'valve' 'control' 'board' 'hydrogen',
  description "The gas valve control board is located on the stern wall. It's used to release hydrogen to increase the static weight of the ship.",
has scenery;

!----------------------------------------
! Captain Max Pruss
!----------------------------------------
Object pruss "Captain Max Pruss" room33
with
  name 'captain' 'max' 'pruss' 'commander',
  description
  [;
    give self general;
    print "Max Pruss is the commander of the airship and clearly in control. This is a little unusual, as the watch officers normally control the ship.";
    if (binoculars in self)
      print " You notice that he's carrying a pair of binoculars.";
    if (note in self)
      print " You notice that he's holding a note in his hand.";
    "";
  ],
  life
  [;
    Ask:
      "Captain Pruss ignores you. You shouldn't disturb him while he's trying to land the airship, unless you have something important for him.";
    Give:
      if (noun ~= note)
        "I don't think Captain Pruss would be interested in ", (ThatOrThose)noun, ".";
      move note to pruss;
      move binoculars to player;
      "You tap the captain on the shoulder and tell him, ~Willy Speck told me to give you this.~^^The captain says, ~Hold this for a moment, will you?~ He gives you his binoculars and takes the note. He reads it and smiles. He looks at the clouds in the sky and forgets to take the binoculars back. This is your chance. If you need a pair of binoculars, you'd better get out of here before the captain needs them again.";
    Show:
      if (noun ~= note)
        "Captain Pruss looks too busy to look at anything you may have to show him.";
      else
        "He's got his back to you. You'll have to give it to him.";
    Talk:
      "Pruss says, ~Who are you?~ He turns to no one in particular. ~Will someone escort this passenger back upstairs!~ Fortunately for you, everyone seems preoccupied with their own concerns and no one escorts you out.";
  ],
has animate proper transparent;

!----------------------------------------
! Albert Sammt
!----------------------------------------
Object "Albert Sammt" room33
with
  name 'albert' 'sammt' 'watch' 'officer',
  description "Albert Sammt is one of the watch officers. He's stationed at the elevator panel and is also directing the ballast and gas.",
  life
  [;
    Ask:
      print_ret (string)DONT_DISTURB_HIM_WHILE_HES, "occupied with the elevator panel and other controls.";
    Talk:
      "Sammt keeps his back to you and merely says, ~Go away, I'm busy.~";
  ],
has animate proper;

!----------------------------------------
! Heinrich Bauer
!----------------------------------------
Object "Heinrich Bauer" room33
with
  name 'heinrich' 'bauer' 'watch' 'officer',
  description "Heinrich Bauer is one of the watch officers. He's stationed at the ballast control board and is carefully monitoring the controls.",
  life
  [;
    Ask:
      "Don't disturb him.";
    Talk:
      "Bauer turns around to look at you briefly, says nothing, and turns back to the ballast control board.";
  ],
has animate proper;

!----------------------------------------
! Walter Ziegler
!----------------------------------------
Object "Walter Ziegler" room33
with
  name 'walter' 'ziegler' 'watch' 'officer',
  description "Walter Ziegler is one of the watch officers. He's stationed at the gas valve control board and looks very busy.",
  life
  [;
    Ask:
      "Ziegler ignores you, as he's keeping a close eye on the gas valve control board.";
    Talk:
      "~Can't you see I'm busy? Go and disturb someone else.~";
  ],
has animate proper;

!----------------------------------------
! Ernst Lehmann
!----------------------------------------
Object "Ernst Lehmann" room33
with
  name 'ernst' 'lehmann' 'director' 'observer',
  description "Ernst Lehmann is the director of the Deutsche Zeppelin-Reederei (DZR). He appears to be here as an observer, as he's not taking an active part in the landing.",
  life
  [;
    Ask:
      "Lehmann says, ~I'm only here as an observer, so I'm not the one to answer any of your questions.~";
    Talk:
      "~The crew is doing a fine job under the circumstances.~";
  ],
has animate proper;

!----------------------------------------
! Anton Wittemann
!----------------------------------------
Object "Anton Wittemann" room33
with
  name 'anton' 'wittemann' 'observer',
  description "Anton Wittemann appears to be here as an observer, as he's not taking an active part in the landing.",
  life
  [;
    Ask:
      "Wittemann says, ~I'm here as an observer, but I can't observe when passengers keep interupting me.~";
    Talk:
      "~I'll be happy to talk to you after we've landed.~";
  ],
has animate proper;

!----------------------------------------
! Kurt Schoenherr
!----------------------------------------
Object "Kurt Schoenherr" room33
with
  name 'kurt' 'schoenherr' 'helmsman',
  description "Kurt Schoenherr is the helmsman. He's stationed at the rudder wheel.",
  life
  [;
    Ask:
      print_ret (string)DONT_DISTURB_HIM_WHILE_HES, "steering the airship.";
    Talk:
      "Schoenherr looks at you briefly, then turns back to the rudder wheel to make an adjustment. ~Not now, we're coming in to land.~";
  ],
has animate proper;

!----------------------------------------
! Franz Herzog
!----------------------------------------
Object "Franz Herzog" room33
with
  name 'franz' 'herzog' 'navigator',
  description "Franz Herzog is one of the navigators. He's stationed at the engine telegraph.",
  life
  [;
    Ask:
      "~I can't answer any of your questions right now. Come back after we've landed.~";
    Talk:
      "Herzog ignores you, as he concentrates on the engine telegraph.";
  ],
has animate proper;

!----------------------------------------
! Eduard Boetius
!----------------------------------------
Object "Eduard Boetius" room33
with
  name 'eduard' 'boetius' 'elevatorman',
  description "Eduard Boetius is the elevatorman. He's stationed at the elevator wheel.",
  life
  [;
    Ask:
      "~Not now, we're trying to land the airship.~";
    Talk:
      "~Good evening. Passengers shouldn't be down here. Go back upstairs.~";
  ],
has animate proper;

!----------------------------------------
! Pair of binoculars
!----------------------------------------
Object binoculars "binoculars" pruss
with
  article "a pair of",
  name 'pair' 'of' 'black' 'binoculars' 'zeiss',
  description "They're black binoculars made by Zeiss. They have a cord attached to them so that you can wear them around your neck. Obviously, you can look through them to see things in the distance.",
  before
  [;
    LookThrough:
      if (self notin player)
        "You'll need to get them first.";
      print "When you look through the binoculars, everything looks much bigger";
      if (location == room06 or room07 or room13)
        ". You see lifeboats floating in the ocean and a huge iceberg in the distance.";
      if (location == room31 or room32 or room33)
        "You can see the lights of Lakehurst Naval Air Station on the ground below.";
      if (location ~= room34 or room35 or room36 or room37 or room39 or room40)
        ", but you don't see anything of interest.";
      give self general;
      print ". You aim them towards the east and twiddle with the focus until a small ship comes into view through the smoke.";
      if (room41 hasnt visited)
        print " ", (string)YOU_NOW_HAVE_REASON_TO_VENTURE_OUT, "risky as that may be.";
      "";
  ],
has clothing pluralname;

!========================================
! Room 34: Southern End of Beach
!========================================
Object room34 "Southern End of Beach"
with
  description
  [;
    if (self hasnt visited)
      print "It's very early in the morning, so it's quite dark and hard to see. There's a black cloud of acrid smoke covering the sky and the air burns your throat as you breathe. You can feel a rumbling beneath your feet. Something is very, very wrong here.^^";
    "You're at the southern end of a sandy beach that's covered in a thick layer of ash. The sky overhead is obscured by smoke and it's difficult to breathe in the acrid atmosphere. All the trees in the jungle to the west are burnt black and the bay to the east of the beach is also covered in ash. You can't see what's further to the south due to a strange mist. The beach continues to the north.";
  ],
  n_to room35,
  s_to
  [;
    date = TIME_TOWER;
    SetTime(save_time, 1);
    StopDaemon(self);
    print (string)TIME_WARP;
    return room02;
  ],
  e_to
  [;
    if (log notin self)
      print_ret (string)NOT_STRONG_SWIMMER;
    if (binoculars hasnt general)
      print_ret (string)BAY_COVERED_IN_SMOKE;
    if (~~HandsFree())
      print_ret (string)NEED_HANDS_FREE, (string)PUSH_LOG;
    print (string)PUSH_LOG_AND_STRADDLE;
    return room41;
  ],
  before
  [;
    Hint:
      if (sign hasnt general)
        print_ret (string)NEED_TO_WORK_OUT_WHERE, "Examine the sign and do what it suggests.";
      if (bay hasnt general)
        print_ret (string)EXAMINE_BAY;
      if (binoculars in pruss)
        print_ret (string)GET_BINOCULARS;
      if (binoculars hasnt general)
        print_ret (string)LOOK_THROUGH_BINOCULARS;
      if (log in nothing)
        print_ret (string)YOU_NOW_HAVE_REASON_TO_VENTURE_OUT, (string)BUT_NEED_SOMETHING_TO_FLOAT_ON;
      if (room41 hasnt visited)
        print_ret (string)GET_ON_LOG;
    Swim:
      <<Go FAKE_E_OBJ>>;
  ],
  daemon
  [;
    if (the_time < 310)
      rfalse;
    if (the_time == 310)
      "^The ashfall is steadily increasing. You'd better not hang around for too long.";
    if (the_time < 330)
      "^The ash and smoke is getting worse. ", (string)YOUD_BETTER_GET_BACK;
    if (the_time == 330)
    {
      deadflag = 1;
      "^With an ear-splitting explosion, the volcano at Perboewatan blows up. Although it's a couple of kilometres further to the north, the combination of acrid smoke, volcanic gases, ash and raining lava get the better of you and you collapse from the noxious gases.^^The explosion triggers a tsunami heading towards Telok Betong and the resultant 30 m high waves wash the area around the bay clean of all vegetation. They also wash away the unconscious body of a guardian of ", (string)THE_TIME_CRYSTALS_OF_CYTHII, " who should have heeded the warnings and escaped while he still had time.";
    }
  ],
has on_krakatoa light;

!----------------------------------------
! Beach (floating object)
!----------------------------------------
Object "beach"
with
  name 'arc' 'beach' 'pristine' 'sand' 'sandy' 'white' 'shoreline',
  description "The normally white sand is covered in a thick blanket of ash that's bunched up into ribbon-like mounds where the water laps against the shoreline.",
  before
  [;
    Dig:
      "You try digging a hole with your hands, but the fine dry sand and ash quickly falls back in on itself.";
  ],
  found_in room34 room35 room36,
has scenery;

!----------------------------------------
! Small bay (floating object)
!----------------------------------------
Object bay "small bay"
with
  name 'small' 'bay' 'water' 'sea' 'ocean',
  description
  [;
    give self general;
    "The water of the bay laps gently against the shoreline. The smoke over the water prevents you seeing if there's anything in the bay. You'd need to look through something like a telescope to see if there's anything there.";
  ],
  before
  [;
    Enter:
      <<Go FAKE_E_OBJ>>;
    Receive:
      "Don't put things in the water or you'll lose them.";
  ],
  found_in room34 room35 room36 room37,
has scenery;

!----------------------------------------
! Smoke (floating object)
!----------------------------------------
Object "smoke"
with
  name 'smoke' 'acrid',
  description "The smoke is very thick and covers the whole area, including the bay and everything on it.",
  found_in
  [;
    if (location has on_krakatoa)
      rtrue;
  ],
has scenery;

!----------------------------------------
! Blanket of ash (floating object)
!----------------------------------------
Object "blanket of ash"
with
  name 'blanket' 'layer' 'cloud' 'fine' 'grey' 'ash' 'mounds',
  description "There's a layer of fine grey ash settled on anything that doesn't move. It appears to be coming from beyond the jungle to the north.",
  found_in room34 room35 room36 room37,
has scenery;

!----------------------------------------
! Jungle (floating object)
!----------------------------------------
Object "jungle"
with
  name 'palm' 'palms' 'tree' 'trees' 'jungle' 'undergrowth' 'vine' 'vines' 'creeper' 'creepers',
  description "The jungle is very dense, but everything is burnt black. From what you can tell of the burnt remains, the trees are mainly palms and the undergrowth is tangled with burnt vines and creepers. It's too dense to venture into the jungle without a machete...or a bulldozer!",
  found_in room34 room35 room36,
has scenery;

!----------------------------------------
! Sign
!----------------------------------------
Object sign "sign" room34
with
  name 'sign' 'rough' 'wood' 'wooden',
  description
  [;
    print "It's a rough wooden sign that looks like it was erected in a hurry. It appears to be written in Indonesian";
    if (self hasnt general)
      print ", but you can probably read it";
    ".";
  ],
  before
  [;
    Read:
      give self general;
      print "When translated from Indonesian, it reads, 'Beach closed due to volcanic activity on Krakatoa - Lampung Provincial Government'.^^You know from your history lessons that Krakatoa had three volcanic cones at Perboewatan (in the north), Danan (in the centre) and Rakata (in the south). The first giant explosion occurred at Perboewatan at 5:30 a.m. on Monday, 27 August 1883. This triggered a tsunami heading toward Telok Betong. The second explosion occurred at Danan at 6:44 a.m. The third (and largest) explosion occurred at 10:02 a.m. The fourth and final explosion occurred at 10:41 a.m. and tore off half of Rakata, along with the remainder of the island to the north. So, you'll have to get out of here before the first explosion at 5:30 a.m.^";
      ShowTutorial(TUT_TIME_LEFT);
      rtrue;
  ],
has static;

!========================================
! Room 35: Ash-Covered Beach
!========================================
Object room35 "Ash-Covered Beach"
with
  description "You're on a sandy beach that runs in a gentle arc from north to south around a small bay to the east. The normally pristine white sand is covered in a thick blanket of ash. The jungle to the west consists of nothing but burnt trees.",
  n_to room36,
  s_to room34,
  e_to
  [;
    if (log notin self)
      print_ret (string)NOT_STRONG_SWIMMER;
    if (binoculars hasnt general)
      print_ret (string)BAY_COVERED_IN_SMOKE;
    if (~~HandsFree())
      print_ret (string)NEED_HANDS_FREE, (string)PUSH_LOG;
    print (string)PUSH_LOG_AND_STRADDLE;
    return room41;
  ],
  before
  [;
    Hint:
      if (bay hasnt general)
        print_ret (string)EXAMINE_BAY;
      if (binoculars in pruss)
        print_ret (string)GET_BINOCULARS;
      if (binoculars hasnt general)
        print_ret (string)LOOK_THROUGH_BINOCULARS;
      if (log in nothing)
        print_ret (string)YOU_NOW_HAVE_REASON_TO_VENTURE_OUT, (string)BUT_NEED_SOMETHING_TO_FLOAT_ON;
      if (room41 hasnt visited)
        print_ret (string)GET_ON_LOG;
    Swim:
      <<Go FAKE_E_OBJ>>;
  ],
has on_krakatoa light;

!========================================
! Room 36: Northern End of Beach
!========================================
Object room36 "Northern End of Beach"
with
  description "You're at the northern end of the beach, where the ash-covered sand gives way to an ash-covered rock platform further to the north. The jungle to the west is burnt beyond recognition and the gentle water of the bay to the east is covered in ash. The beach continues to the south.",
  n_to room37,
  s_to room35,
  e_to
  [;
    if (log notin self)
      print_ret (string)NOT_STRONG_SWIMMER;
    if (binoculars hasnt general)
      print_ret (string)BAY_COVERED_IN_SMOKE;
    if (~~HandsFree())
      print_ret (string)NEED_HANDS_FREE, (string)PUSH_LOG;
    print (string)PUSH_LOG_AND_STRADDLE;
    return room41;
  ],
  before
  [;
    Hint:
      if (bay hasnt general)
        print_ret (string)EXAMINE_BAY;
      if (binoculars in pruss)
        print_ret (string)GET_BINOCULARS;
      if (binoculars hasnt general)
        print_ret (string)LOOK_THROUGH_BINOCULARS;
      if (log in nothing)
        print_ret (string)YOU_NOW_HAVE_REASON_TO_VENTURE_OUT, (string)BUT_NEED_SOMETHING_TO_FLOAT_ON;
      if (room41 hasnt visited)
        print_ret (string)GET_ON_LOG;
    Swim:
      <<Go FAKE_E_OBJ>>;
  ],
has on_krakatoa light;

!----------------------------------------
! Rock platform (floating object)
!----------------------------------------
Object "rock platform"
with
  name 'rock' 'platform',
  found_in room36 room37,
has scenery;

!========================================
! Room 37: Rock Platform
!========================================
Object room37 "Rock Platform"
with
  description "You're on a rocky part of the coastline. The hardened volcanic lava underfoot would be uncomfortable to walk on if not for the thick carpet of ash. A narrow path leads up the cliffside to the north. You can see the entrance to a cave to the west of the rock platform and the beach is to the south. The ash-covered water of the bay is to the east.",
  n_to "The cliff is in the way, but you can go up the narrow path if you want to climb it.",
  s_to room36,
  e_to
  [;
    if (log notin self)
      print_ret (string)NOT_STRONG_SWIMMER;
    if (binoculars hasnt general)
      print_ret (string)BAY_COVERED_IN_SMOKE;
    if (~~HandsFree())
      print_ret (string)NEED_HANDS_FREE, (string)PUSH_LOG;
    print (string)PUSH_LOG_AND_STRADDLE;
    return room41;
  ],
  w_to room38,
  u_to room39,
  before
  [;
    Hint:
      if (bay hasnt general)
        print_ret (string)EXAMINE_BAY;
      if (binoculars in pruss)
        print_ret (string)GET_BINOCULARS;
      if (binoculars hasnt general)
        print_ret (string)LOOK_THROUGH_BINOCULARS;
      if (log in nothing)
        print_ret (string)YOU_NOW_HAVE_REASON_TO_VENTURE_OUT, (string)BUT_NEED_SOMETHING_TO_FLOAT_ON;
      if (room41 hasnt visited)
        print_ret (string)GET_ON_LOG;
    Swim:
      <<Go FAKE_E_OBJ>>;
  ],
has on_krakatoa light;

!----------------------------------------
! Path
!----------------------------------------
Object "path"
with
  name 'path' 'cliff' 'cliffside',
  description "The path up the cliff is quite steep, but it has plenty of hand holds and foot holds if you want to climb it.",
  before
  [;
    Climb:
      if (self in room37)
        <<Go FAKE_U_OBJ>>;
      else
        <<Go FAKE_D_OBJ>>;
  ],
  found_in room37 room39,
has scenery;

!========================================
! Room 38: Cave
!========================================
Object room38 "Cave"
with
  description "You're in a cave that has no doubt been carved out by the ocean waves over thousands of years. There's a small hole in the wall at the back of the cave. The dim light of the entrance is to the east.",
  e_to room37,
  before
  [;
    Hint:
      if (red_crystal in nothing && small_hole hasnt general)
        "Examine the hole and reach into it.";
      if (red_crystal in nothing)
        "You can't reach the glint yourself, so you'll need someone as small as a Cythiian possum to get it for you.";
      if (red_crystal hasnt moved)
        print_ret (string)DONT_FORGET_THE, "red crystal.";
  ],
has on_krakatoa light;

!----------------------------------------
! Cave
!----------------------------------------
Object "cave" room38
with
  name 'cave',
  description "It's pretty much like any ocean cave, except for the build-up of ash.",
has scenery;

!----------------------------------------
! Hole
!----------------------------------------
Object small_hole "small hole" room38
with
  name 'small' 'hole',
  description
  [;
    give self general;
    print "It's quite a small hole. A child or a Cythiian possum could enter it, but it's too small for you. When you peer inside the hole, you can ";
    if (red_crystal in nothing)
      "see a red glint from something glassy.";
    else
      "only see darkness.";
  ],
  before
  [;
    ReachIn:
      "You reach into the hole and feel around, but you can't feel anything out of the ordinary. Mind you, you can't reach the back of the hole, so there might be something that's out of your reach.";
    Search:
      <<Examine self>>;
  ],
has scenery;

!----------------------------------------
! Red glint
!----------------------------------------
Object glint "red glint" room38
with
  name 'red' 'glint' 'something' 'glassy',
  description "You can't see it in the darkness of the hole, but it could be the red crystal.",
  before
  [;
    if (action ~= ##Examine)
      "You can't reach it.";
  ],
has scenery;

!----------------------------------------
! Red crystal
!----------------------------------------
Object red_crystal "red crystal"
with
  name 'deep' 'red' 'crystal' 'crystals//p',
  description
  [;
    print "It's a deep red crystal that ";
    if (self notin green_plinth)
      print "belongs";
    else
      print "is now at home";
    " on the red", (string)PLINTH_IN_TIME_TOWER;
  ],
has;

!========================================
! Room 39: Stoney Headland
!========================================
Object room39 "Stoney Headland"
with
  description
  [;
    print "You're on a stoney headland surrounded by burnt palm trees swaying in a gentle breeze that carries the smell of smoke. ";
    if (tree in self)
      print "Only one tree has survived the carnage. ";
    "A rocky path leads down to the coastline. Looking east over the waters of the bay, you think you can see something through the smoke, but you can't be sure.";
  ],
  u_to
  [;
    if (tree in self)
    {
      if (HandsFree())
        return room40;
      else
        print_ret (string)NEED_HANDS_FREE, "climb up the palm tree.";
    }
  ],
  d_to room37,
  before
  [;
    Hint:
      if (tree in self && axe hasnt moved)
        "That tree is blocking the view. ", (string)COME_BACK_WHEN, "you've got a tool to remove it.";
      if (tree in self && coconut in room40)
        "Act like Paul Bunyan, but make sure it's safe to do so first.";
      if (tree in self)
        "Act like Paul Bunyan.";
      if (trunk in self)
        print_ret (string)HAVE_YOU_TRIED, "taking the trunk? Time to do some pruning.";
      if (log in self)
        print_ret (string)HAVE_YOU_TRIED, "taking the log?";
  ],
has on_krakatoa light;

!----------------------------------------
! Stoney headland
!----------------------------------------
Object "stoney headland" room39
with
  name 'stoney' 'stony' 'headland',
  description "The headland has an imposing view over the bay.",
has scenery;

!----------------------------------------
! Volcano (floating object)
!----------------------------------------
Object "volcano"
with
  name 'smoking' 'volcano' 'island' 'ash' 'lava',
  description "The volcano is already spurting smoke, ash and lava, but it looks like it's going to erupt at any moment.",
  found_in room39 room40 room43 room45,
has scenery;

!----------------------------------------
! Large palm tree
!----------------------------------------
Object tree "large palm tree" room39
with
  name 'large' 'palm' 'tree',
  description "It's just one of many palm trees on this island, but it's the only one growing on the stoney headland and the only one to have escaped the fires from the volcano.",
  before
  [;
    Climb:
      <<Go FAKE_U_OBJ>>;
    Cut:
      if (second == nothing && axe in player)
      {
        print "(with the axe)^";
        second = axe;
      }
      if (second == nothing)
        "You'll need something to chop it with.";
      if (second ~= axe)
        "Don't be silly. You can't chop down a tree with ", (a)second, ".";
      if (coconut in room40)
      {
        deadflag = 1;
        print "You take an almighty swing with the axe, the palm tree vibrates and a coconut falls on your head. BONK! It doesn't kill you, but it knocks you out. A short time later, Krakatoa erupts and you're incinerated, along with the coconut.^";
        ShowTutorial(TUT_UNDO);
        rtrue;
      }
      while (child(room40))
        move child(room40) to location;
      move stump to location;
      move trunk to location;
      move fronds to location;
      move self to limbo;
      "You chop into the tree like a madman. After a few minutes, there's a mighty creaking sound and the palm tree topples to the ground.";
  ],
has static;

!----------------------------------------
! Palm tree stump
!----------------------------------------
Object stump "palm tree stump"
class OpenContainer
with
  name 'palm' 'tree' 'stump',
  description
  [;
    print "This is the tree stump left behind after you chopped down the palm tree. ";
    <<Search self>>;
  ],
has static supporter;

!----------------------------------------
! Palm tree trunk
!----------------------------------------
Object trunk "palm tree trunk"
with
  name 'palm' 'tree' 'trunk',
  description "It's the palm tree you felled with your trusty axe. It would probably make a good floating device if not for all the fronds.",
  before
  [;
    Pull, Push, Take:
      "It's far too heavy with all those palm fronds attached.";
  ],
has static;

!----------------------------------------
! Palm fronds
!----------------------------------------
Object fronds "palm fronds"
with
  name 'palm' 'frond' 'fronds',
  description "The leafy fingers of the palm fronds are useful for weaving hats and baskets and things like that, but you don't have time to stop and learn native handcrafts.",
  before
  [;
    Cut:
      if (self hasnt scenery)
        "You've already done that.";
      if (second == nothing && axe in player)
      {
        print "(with the axe)^";
        second = axe;
      }
      if (second == nothing)
        print_ret (string)YOULL_HAVE_TO_TELL_ME_WHAT_TO, "cut them with.";
      if (second ~= axe)
        "Nice try.";
      give self ~scenery static;
      move trunk to limbo;
      move log to location;
      "You chop the fronds from the trunk of the palm tree, leaving nothing but a log and a pile of palm fronds.";
    Take:
      if (self has scenery)
        "You can't. They're attached to the palm tree. Maybe you could chop them off.";
      else
        "You have better things to do than start making things out of palm fronds. Stick to your mission.";
  ],
has pluralname scenery;

!----------------------------------------
! Palm tree log
!----------------------------------------
Object log "palm tree log"
with
  name 'palm' 'tree' 'log',
  description "It looks like a palm tree, but without the fronds.",
  before
  [;
    Attack:
      "The log wobbles under your brutal attack. Maybe you could push it.";
    Cut:
      "You've already chopped the fronds off. There's no need to turn it into firewood.";
    Enter:
      if (location == room39)
        "You sit on the log, like a cowboy mounted on a horse, and say, ~Giddy up!~ When the log refuses to move, you get off it and stand up again.";
      <<Go FAKE_E_OBJ>>;
    Pull:
      "It won't budge. Maybe you could push it.";
    Push:
      if (location ~= room39)
        <<Go FAKE_E_OBJ>>;
      move self to room37;
      "You roll the log over the edge of the cliff and out of sight. You hear a loud splash as it lands in the water below.";
    Take:
      "It's too heavy, but you could probably push it.";
  ],
has static;

!========================================
! Room 40: Top of Palm Tree
!========================================
Object room40 "Top of Palm Tree"
with
  description "You're at the top of the only palm tree that has survived the devastation. From here, you can see the cause of all the smoke and ash. It's an active volcano, probably Rakata, the southernmost of the three active volcanoes on Krakatoa. When you look east over the bay, you think you can see something through the smoke. The smell of sulphur is very strong.",
  d_to
  [;
    if (HandsFree())
      return room39;
    else
      print_ret (string)NEED_HANDS_FREE, "climb down the palm tree.";
  ],
  before
  [;
    Hint:
      if (coconut hasnt moved)
        "That coconut looks dangerous. Death by falling coconut is widely regarded to be an urban myth, but you don't want to be the one to prove that myth to be true.";
      if (silver_key hasnt moved)
        print_ret (string)DONT_FORGET_THE, "silver key.";
  ],
  after
  [;
    Drop:
      move noun to room39;
      print (The)noun," fall";
      if (noun hasnt pluralname)
        print "s";
      " to the ground below.";
  ],
has on_krakatoa light;

!----------------------------------------
! Top of palm tree
!----------------------------------------
Object "top of a palm tree" room40
with
  article THE,
  name 'top' 'of' 'palm' 'tree',
  description "Now that you're at the top of the palm tree, you can see that it's a coconut palm.",
  before
  [;
    Climb:
      <<Go FAKE_D_OBJ>>;
  ],
has scenery;

!----------------------------------------
! Coconut
!----------------------------------------
Object coconut "coconut" room40
with
  name 'coconut' 'hard' 'brown' 'shell',
  description "The coconut is a cultural icon of the tropics. This one is a mature specimen with a hairy outer layer on a hard brown shell. You wouldn't want to get hit on the head by one of these.",
  before
  [;
    Attack:
      "Ouch! It's got a hard shell. You'd need something sharp to cut it open.";
    Cut:
      if (second == nothing && axe in player)
      {
        print "(with the axe)^";
        second = axe;
      }
      if (second == nothing)
        print_ret (string)YOULL_HAVE_TO_TELL_ME_WHAT_TO, "break it with.";
      if (second ~= axe)
        "You can't break the coconut with ", (ThatOrThose)second, ".";
      if (coconut notin location)
        "You'll need to drop the coconut first.";
      move coconut to limbo;
      "You use the axe to take an almighty swing at the coconut and chop it into two neat halves. You manage to rescue most of the coconut milk before it spills, drink it down and throw the coconut shells away.";
  ],
has;

!----------------------------------------
! Bird's nest
!----------------------------------------
Object nest "bird's nest" room40
class OpenContainer
with
  name 'bird^s' 'nest',
  description
  [;
    print "The bird's nest is cleverly woven from sticks, dead grass and palm frond leaflets. You're not an ornithologist, so you can't tall what type of bird built it. ";
    <<Search self>>;
  ],
  before
  [;
    Take:
      "You think better of it. The bird's nest is the bird's home. How would you like it if someone took your home?";
  ],
has container open static;

!----------------------------------------
! Silver key
!----------------------------------------
Object silver_key "silver key" nest
with
  name 'small' 'silver' 'key' 'keys//p',
  description
  [;
    print "It's a small silver key. ";
    if (chest hasnt general)
      "It's too small for a door key, so it probably unlocks some sort of furniture, like a chest or a wardrobe.";
    else
      print_ret (string)YOU_KNOW_THAT_IT_UNLOCKS, "chest in the ship's hold.";
  ],
has;

!========================================
! Room 41: Floating on Palm Tree Log
!========================================
Object room41 "Floating on Palm Tree Log"
with
  description
  [;
    MoveFloatingObjects();
    print "You're floating on the log of a palm tree surrounded by the sea water of the bay. The water is very murky from all the ash floating on the surface. ";
    if (self.x == 1)
      print "The waves lap against the shore of the island to the west. ";
    else
    {
      print "The island is in the ";
      if (self.x == 3)
        print "far ";
      print "distance to the west. ";
    }
    print "You can see a ship through the smoke to the ";
    if (self.y < 3)
      print "south";
    if (self.y > 3)
      print "north";
    print "east.";
    if (self.x == 3 && self.y == 3)
      print " In fact, the waves lap against the side of the ship. You could clamber aboard by climbing up the ropes that hang down the side.";
    "";
  ],
  n_to
  [;
    if (self.y == 1)
      print_ret (string)YOU_CANT_PADDLE_ANY_FURTHER, "north, as the ocean currents are too strong.";
    self.y--;
    print (string)YOU_PADDLE_FURTHER_TO, "north.^^";
    <<Look>>;
  ],
  s_to
  [;
    if (self.y == 4)
      "You dare not paddle any further to the south or the ocean currents will carry you into the Sunda Strait.";
    self.y++;
    print (string)YOU_PADDLE_FURTHER_TO, "south.^^";
    <<Look>>;
  ],
  e_to
  [;
    if (self.x == 3)
    {
      print (string)YOU_CANT_PADDLE_ANY_FURTHER, "east, as the ";
      if (self.y == 3)
        "side of the ship blocks the way.";
      else
        "ocean currents are too strong.";
    }
    self.x++;
    print (string)YOU_PADDLE_FURTHER_TO, "east.^^";
    <<Look>>;
  ],
  w_to
  [;
    if (self.x == 1)
    {
      print "You get off the palm tree log and pull it onto the shore.^^";
      switch (self.y)
      {
        1: move log to room37;
           return room37;
        2: move log to room36;
           return room36;
        3: move log to room35;
           return room35;
        4: move log to room34;
           return room34;
      }
    }
    self.x--;
    print (string)YOU_PADDLE_FURTHER_TO, "west.^^";
    <<Look>>;
  ],
  u_to
  [;
    if (self.x == 3 && self.y == 3)
    {
      if (HandsFree())
      {
        print "You clamber up the side of the ship.^^";
        ship_directions_enabled = true;
        print (italic)"[Use nautical directions (F, A, P, S) on the ship.]^^";
        return room42;
      }
      else
        print_ret (string)NEED_HANDS_FREE, "climb up the ropes.";
    }
  ],
  x 1,
  y 1,
  before
  [;
    Hint:
      if (room42 hasnt visited)
        "Just keep paddling towards the ship.";
  ],
has on_krakatoa light;

!----------------------------------------
! Floating palm tree log
!----------------------------------------
Object "floating palm tree log" room41
with
  name 'floating' 'palm' 'tree' 'log',
  description "It's the palm tree that you felled and trimmed earlier. It's now floating in the ash-covered waters of the bay.",
  react_before
  [;
    Drop:
      "You have second thoughts when you realise that anything dropped here will be lost in the water and you'll never get it back again.";
  ],
has scenery;

!----------------------------------------
! Ocean (floating object)
!----------------------------------------
Object "ocean"
with
  article THE,
  name 'sea' 'water' 'bay' 'ocean',
  description "It's very murky from all the ash.",
  found_in room41 room42 room43 room44,
has scenery;

!----------------------------------------
! Side of ship
!----------------------------------------
Object ship "side of a ship"
with
  article THE,
  name 'side' 'of' 'ship' 'timber' 'panels' 'outside' 'hull' 'cargo' 'net',
  description "You see the timber panels on the outside hull of a ship. A cargo net draped over the side would allow you to climb aboard.",
  before
  [;
    Climb:
      <<Go FAKE_U_OBJ>>;
  ],
  found_in
  [;
    if (location == room41 && room41.x == 3 && room41.y == 3)
      rtrue;
  ],
has scenery;

!========================================
! Room 42: Main Deck
!========================================
Object room42 "Main Deck"
with
  description "You're on the main deck of the ship, where the main mast towers over you. There's a door to fore and a cabin to aft. The deck is covered in fine ash. You can also go down over the side of the ship.",
  n_to forecastle_door,
  s_to room45,
  u_to
  [;
    if (HandsFree())
      return room43;
    else
      print_ret (string)NEED_HANDS_FREE, "climb up the mast.";
  ],
  d_to
  [;
    if (HandsFree())
    {
      ship_directions_enabled = false;
      print (italic)"[Use compass directions (N, S, E, W) now that you're no longer on the ship.]^^";
      return room41;
    }
    else
      print_ret (string)NEED_HANDS_FREE, "climb over the side of the ship.";
  ],
  before
  [;
    Hint:
      if (room43 hasnt visited)
        "Have you examined the mast?";
      if (room45 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "aft yet.";
      if (forecastle_door has locked && crowbar hasnt moved)
        print_ret (string)HAVE_YOU_TRIED, "opening the door? ", (string)COME_BACK_WHEN_YOUVE_FOUND, "something to pry it open.";
      if (forecastle_door has locked)
        "Pry the door open with something you found earlier.";
      if (forecastle_door hasnt open && room44 hasnt visited)
        print_ret (string)OPEN_THE, "door.";
      if (room44 hasnt visited)
        print_ret (string)YOU_HAVENT_BEEN, "fore yet.";
  ],
has on_krakatoa light;

!----------------------------------------
! Main deck
!----------------------------------------
Object "main deck" room42
with
  article THE,
  name 'main' 'deck' 'ash',
  description "The main deck is covered in ash.",
has scenery;

!----------------------------------------
! Mast (floating object)
!----------------------------------------
Object "mast"
with
  name 'mast',
  description
  [;
    print "The mast is located on the main deck. You can climb it to ";
    if (self in room42)
      "get to the crow's nest.";
    else
      "return to the deck below.";
  ],
  before
  [;
    Climb:
      if (self in room42)
        <<Go FAKE_U_OBJ>>;
      else
        <<Go FAKE_D_OBJ>>;
  ],
  found_in room42 room43,
has scenery;

!----------------------------------------
! Forecastle door (floating object)
!----------------------------------------
Object forecastle_door "door"
with
  name 'door',
  description
  [;
    if (self has locked)
      "It's jammed shut.";
    if (self has open)
      "It's open.";
    "It's closed.";
  ],
  door_dir
  [;
    if (self in room42)
      return w_to;
    else
      return e_to;
  ],
  door_to
  [;
    if (self in room42)
      return room44;
    else
      return room42;
  ],
  before
  [;
    Attack:
      if (self hasnt locked)
        "You've already unjammed the door.";
      if (second == nothing && crowbar in player)
      {
        print "(with the crowbar)^";
        second = crowbar;
      }
      if (second == nothing)
        print_ret (string)NEED_TO_PRY_IT_OPEN;
      if (second ~= crowbar)
        "You can't ", (address)verb_word, " the door with ", (ThatOrThose)second, ".";
      give self ~locked open;
      "You pry the door open with the crowbar.";
    Open:
      if (second ~= nothing)
        <<Attack self second>>;
      if (self has locked)
        "It's jammed shut. ", (string)NEED_TO_PRY_IT_OPEN;
    Unlock:
      if (self has locked)
        "It's not locked, it's jammed shut. ", (string)NEED_TO_PRY_IT_OPEN;
  ],
  with_key dummy_key,
  found_in room42 room44,
has door lockable locked openable scenery;

!========================================
! Room 43: Crow's Nest
!========================================
Object room43 "Crow's Nest"
with
  description "You're in the crow's nest. From here you can see the volcano spewing out fire and ash over the island. Now that you can see it from a distance, you believe it to be Rakata, the southernmost volcano on Krakatoa. When you've finished admiring the view, you can climb down from the crow's nest.",
  d_to
  [;
    if (HandsFree())
      return room42;
    else
      print_ret (string)NEED_HANDS_FREE, "climb down the mast.";
  ],
  before
  [;
    Hint:
      if (monkey hasnt general && banana in nothing)
        print_ret (string)HAVE_YOU_EXAMINED_MONKEY, " ", (string)COME_BACK_WHEN, "you've found some monkey food.";
      if (monkey hasnt general)
        print_ret (string)HAVE_YOU_EXAMINED_MONKEY;
      if (monkey in self)
        "The monkey will follow you now.";
  ],
has on_krakatoa light;

!----------------------------------------
! Crow's nest
!----------------------------------------
Object "crow's nest" room43
with
  article THE,
  name 'crow^s' 'nest',
  description "This is where crows nest, or they would, if not for the ash falling from the sky.",
has scenery;

!----------------------------------------
! Monkey
!----------------------------------------
Object monkey "monkey" room43
with
  name 'monkey',
  description
  [;
    print "He's a scrawny-looking monkey. He looks ";
    if (self hasnt general)
      "hungry.";
    else
      "friendly.";
  ],
  before
  [;
    Take:
      if (self hasnt general)
        "He won't let you pick him up. He looks hungry.";
      "You pick him up, but he's quite fidgetty and jumps out of your arms.";
    Touch:
      if (self hasnt general)
        "He won't let you touch him.";
      "You gently stroke the monkey and he gives you a monkey smile.";
  ],
  life
  [;
    Give:
      if (noun == banana)
      {
        remove banana;
        print "He takes the banana, eats it and throws the skin ";
        if (self has general)
          "away.";
        give self general;
        "in the sea. I think you've made a friend.";
      }
      if (noun ~= coconut)
        "The monkey sniffs your gift and throws it back to you. I think he wants something edible.";
      print "The monkey takes the coconut and tries to bite into it, but he breaks a tooth, screeches and throws the coconut at you. There's a hollow thud as the coconut bounces off your head and falls ";
      if (self in room43)
      {
        move coconut to room42;
        "to the deck below.";
      }
      if (self in room41)
      {
        move coconut to limbo;
        "into the sea, never to be seen again.";
      }
      move coconut to location;
      "to the ground.";
    Show:
      if (noun == banana)
        "~Eek, eek, eek!~ The monkey sounds excited. I think he likes bananas.";
      "The monkey shows no interest in ", (the)noun, ".";
    Ask, Talk:
      "The monkey just looks at you strangely and scratches his head. You may know a lot of languages, but you're certainly not fluent in monkey talk.";
  ],
  each_turn
  [;
    if (location == room38)
    {
      move red_crystal to location;
      move glint to limbo;
      move monkey to limbo;
      "^The monkey disappears into the hole. A few moments later, he reappears clutching a red crystal. He drops it at your feet, then, his debt to you repaid, he scampers out of the cave and out of your life forever.";
    }
  ],
has animate;

!========================================
! Room 44: Fo'c'sle
!========================================
Object room44 "Fo'c'sle"
with
  description "You're in the fo'c'sle, where it's quite dark. A dim light filters in through small windows in the ship's hull. The doorway is aft.",
  s_to forecastle_door,
  before
  [;
    Hint:
      if (lamp hasnt moved)
        print_ret (string)DONT_FORGET_THE, "oil lamp.";
  ],
has on_krakatoa light;

!----------------------------------------
! Fo'c'sle
!----------------------------------------
Object "fo'c'sle" room44
with
  name 'fo^c^sle' 'forecastle',
  description "The name fo'c'sle is an abbreviation of forecastle. It's an elevated platform or deck (the castle) at the front end of the ship (the fore or bow). Other than that, I can't think what to tell you about it.",
has scenery;

!----------------------------------------
! Windows
!----------------------------------------
Object "windows" room44
with
  name 'light' 'small' 'windows' 'ship^s' 'hull',
  description
  [;
    print_ret "The small windows are mounted high in the ship's hull. ", (string)CAN_SEE_SMOKE;
  ],
  before
  [;
    LookThrough:
      print_ret (string)CAN_SEE_SMOKE;
  ],
has scenery;

!----------------------------------------
! Oil lamp
!----------------------------------------
Object lamp "oil lamp" room44
with
  article AN,
  name 'oil' 'lamp',
  description
  [;
    print "It's a rusty old oil lamp that's ";
    if (self hasnt light)
      print "not ";
    print "currently lit";
    if (self has light)
      print " and emitting a dull yellow glow";
    ".";
  ],
  before
  [;
    Burn:
      if (self has light)
        "It's already lit.";
      if (second == nothing && matches in player)
      {
        print "(with the matches)^";
        second = matches;
      }
      if (second == nothing)
        print_ret (string)YOULL_HAVE_TO_TELL_ME_WHAT_TO, "light it with.";
      if (second ~= matches)
        "You can't light the candle with ", (ThatOrThose)second, ".";
      give self light;
      print "You light the oil lamp with ", (the)second, ".^";
      if (location == thedark)
        new_line;
      rtrue;
    Extinguish:
      if (self hasnt light)
        "It's not lit.";
      give self ~light;
      print "You blow out the lamp.^";
      if (real_location hasnt light)
      {
        new_line;
        PlayerTo(location, 2);
      }
      rtrue;
  ],
has;

!========================================
! Room 45: Ship's Cabin
!========================================
Object room45 "Ship's Cabin"
with
  description "You're in the ship's cabin. There's very little light, so it's hard to see what's inside. Through a porthole you can occasionally see glimpses of the smoking volcano. The exit is to fore.",
  n_to room42,
  d_to trapdoor,
  before
  [;
    Hint:
      if (table hasnt general)
        "Examine the table and follow the clues.";
      if (trapdoor has locked)
        "Have you examined the trapdoor? Just slide the bolt.";
      if (trapdoor hasnt open && room46 hasnt visited)
        print_ret (string)OPEN_THE,"trapdoor.";
      if (wine has open)
        "Have you examined the flagon of wine? You'll need to seal it before you can carry it around.";
      if (wine hasnt moved)
        print_ret (string)DONT_FORGET_THE,"flagon of wine.";
  ],
has on_krakatoa light;

!----------------------------------------
! Ship's cabin
!----------------------------------------
Object "ship's cabin" room45
with
  name 'ship^s' 'cabin' 'captain^s',
  description "Well, it's a cabin on the ship, so it must be the ship's cabin. It's probably safe to assume that it's the captain's cabin, but you've seen no sign of the captain or crew and assume that the ship was abandoned long ago.",
has scenery;

!----------------------------------------
! Porthole
!----------------------------------------
Object "porthole" room45
with
  name 'porthole',
  description "The porthole on the port side of the ship has a clear view of the volcano on the island.",
has scenery;

!----------------------------------------
! Table
!----------------------------------------
Object table "table" room45
class OpenContainer
with
  name 'table' 'battered' 'stained' 'wood' 'wooden',
  description
  [;
    print "It's a somewhat battered and stained wooden table that's seen many years of use. ";
    if (self hasnt general)
      "You notice some scratches on the floor under the table that make you wonder what might be under there. ";
    <<Search self>>;
  ],
  before
  [;
    LookUnder:
      if (self hasnt general)
        "You can see a trapdoor under the table, but you'll need to move the table to get to it.";
    Pull:
      if (self has general)
      {
        give self ~general;
        give trapdoor absent;
        MoveFloatingObjects();
        "You pull the table back over the trapdoor in the floor.";
      }
      "You can't pull it, but you can push it.";
    Push:
      if (self hasnt general)
      {
        give self general;
        give trapdoor ~absent;
        MoveFloatingObjects();
        "You push the table aside to expose a trapdoor in the floor.";
      }
      "There's no need to push it any further.";
  ],
has static supporter;

!----------------------------------------
! Scratches on floor
!----------------------------------------
Object "scratches" room45
with
  name 'scratches' 'scratch' 'marks' 'floor',
  description "The scratches on the floor look like they've been created by someone moving the table.",
has scenery;

!----------------------------------------
! Flagon of wine
!----------------------------------------
Object wine "flagon of wine" table
with
  name 'flagon' 'of' 'fortified' 'wine' 'port' 'sherry',
  description
  [;
    print "It's a flagon of fortified wine, possibly port or sherry, as these were very popular with sailors. It's ";
    if (self has open)
      "not sealed.";
    else
      "crudely sealed with the cork from the champagne bottle.";
  ],
  before
  [;
    Drink:
      if (self hasnt open)
        print_ret (string)YOUD_HAVE_TO_REMOVE_CORK_FIRST;
      print_ret (string)NEED_TO_STAY_SOBER;
    Eat:
      print_ret (string)CAN_DRINK_BUT_CANT_EAT;
    Receive:
      if (self hasnt open)
        print_ret (string)YOU_CANT_PUT_ANYTHING_IN_THE, "flagon of wine when it's sealed. ", (string)YOUD_HAVE_TO_REMOVE_CORK_FIRST;
      if (noun ~= cork)
        "Don't be silly. You can't put ", (a)noun, " in a flagon of wine.";
      give self ~open;
      give cork scenery;
      move cork to self;
      "It's a tight fit, but you manage to push the champagne cork into the flagon. You can now carry it around without any risk of spilling the contents.";
    Open:
      if (self has open)
        "It's already open.";
      "Now that the flagon is sealed, you'd better leave it that way, or you might spill the contents.";
    Take:
      if (self has open)
        "You'd better seal it first, otherwise you might spill the contents.";
  ],
has edible open transparent;

!----------------------------------------
! Trapdoor (floating object)
!----------------------------------------
Object trapdoor "trapdoor"
with
  name 'trapdoor' 'trap' 'door',
  description
  [;
    print "It's a timber trapdoor set into the ";
    if (self in room45)
      print "floor of the cabin.";
    else
      print "ceiling of the hold.";
    print " It's currently ";
    if (self has open)
      print "open.";
    else
      print "closed.";
    if (self in room45)
    {
      print " It has a sliding bolt that's currently ";
      if (self has locked)
        print "locked.";
      else
        print "unlocked.";
    }
    "";
  ],
  door_dir
  [;
    if (self in room45)
      return d_to;
    else
      return u_to;
  ],
  door_to
  [;
    if (self in room45)
      return room46;
    else
      return room45;
  ],
  before
  [;
    Lock:
      if (self has locked)
        "It's already locked.";
      if (location == room46)
        "You can't lock it from this side.";
      if (self has open)
        "You'll have to close the trapdoor first.";
      give self locked;
      "You slide the bolt to lock the trapdoors.";
    Unlock:
      if(self hasnt locked)
        "It's already unlocked.";
      if (location == room46)
        "You can't unlock it from this side.";
      if (second ~= nothing)
        "You don't need ", (the)second, " to unlock it. Just slide the bolt.";
      give self ~locked;
      "You slide the bolt to unlock the trapdoor.";
  ],
  after
  [;
    Open:
      give self moved;
  ],
  add_to_scope bolt,
  found_in room45 room46,
has absent door lockable locked openable static;

!----------------------------------------
! Bolt
!----------------------------------------
Object bolt "bolt"
with
  name 'bolt' 'sliding',
  description
  [;
    print "It's a sliding bolt that locks the trapdoor. It's currently in the ";
    if (trapdoor hasnt locked)
      print "un";
    print "locked position, but you only need to slide it to ";
    if (trapdoor has locked)
      print "un";
    "lock it.";
  ],
  before
  [;
    Lock:
      <<Lock trapdoor>>;
    Pull, Push:
      "I'm not sure which direction you mean. Try LOCK, UNLOCK or SLIDE.";
    Slide:
      if (trapdoor has locked)
        <<Unlock trapdoor>>;
      else
        <<Lock trapdoor>>;
    Unlock:
      <<Unlock trapdoor>>;
  ],
has scenery;

!========================================
! Room 46: Cargo Hold
!========================================
Object room46 "Cargo Hold"
with
  description "You're in the cargo hold of the ship. It smells of salted beef. There's a stair leading up to the trapdoor overhead.",
  u_to trapdoor,
  before
  [;
    Hint:
      if (location ~= real_location)
      {
        if (lamp hasnt moved)
          "You'll need a light source. ",(string)COME_BACK_WHEN_YOUVE_FOUND, "one.";
        if (~~TestScope(lamp))
          "Bring the light source here.";
        if (lamp hasnt light && matches in nothing)
          print_ret (string)COME_BACK_WHEN_YOUVE_FOUND, "something to light the lamp.";
        if (lamp hasnt light)
          "Light the lamp with the hobo's gift.";
      }
      if (chest has locked && silver_key hasnt moved)
        print_ret (string)HAVE_YOU_TRIED, "opening the chest? ", (string)COME_BACK_WHEN, "you've found the key.";
      if (chest has locked)
        print_ret (string)TRY_UNLOCKING_THE, "chest.";
      if (chest hasnt open && green_crystal hasnt moved)
        print_ret (string)OPEN_THE,"chest.";
      if (chest has open && green_crystal hasnt moved)
        print_ret (string)DONT_FORGET_THE, "green crystal.";
    Smell:
      if (noun == nothing)
        "The smell of salted beef is in the air, even though there's no longer any salted beef in the hold.";
  ],
has on_krakatoa;

!----------------------------------------
! Cargo hold
!----------------------------------------
Object "cargo hold" room46
with
  article THE,
  name 'hold' 'ship' 'cargo' 'stores' 'goods',
  description "The hold of the ship is used for holding things. (Isn't English amazing?) It would have held cargo being transported to or from the tropics, but it's currently empty of any goods.",
has scenery;

!----------------------------------------
! Chest
!----------------------------------------
Object chest "chest" room46
class OpenableContainer
with
  name 'chest',
  description
  [;
    print "It looks like a treasure chest. ";
    <<Search self>>;
  ],
  before
  [;
    Take:
      "It's too heavy to move.";
  ],
  after
  [;
    Unlock:
      give self general;
  ],
  with_key silver_key,
has container lockable locked openable static;

!----------------------------------------
! Green crystal
!----------------------------------------
Object green_crystal "green crystal" chest
with
  name 'dark' 'green' 'crystal' 'crystals//p',
  description
  [;
    print "It's a dark green crystal that ";
    if (self notin green_plinth)
      print "belongs";
    else
      print "is now at home";
    " on the green", (string)PLINTH_IN_TIME_TOWER;
  ],
has;

!========================================
! Limbo
!========================================
Object limbo;

Object dummy_key "key";

!========================================
! Printing rules
!========================================
[ consultWord word i;
  for (i=0:i<WordLength(word):i++)
    print (char)LowerCase(WordAddress(word)->i);
];

[ DoesntOrDont obj;
  if (obj has pluralname)
    print "don't";
  else
    print "doesn't";
];

[ firstConsultWord word i;
  for (i=0:i<WordLength(word):i++)
    if (i == 0)
      print (char)UpperCase(WordAddress(word)->i);
    else
      print (char)LowerCase(WordAddress(word)->i);
];

[ italic text;
  style underline;
  print (string)text;
  style roman;
];

!========================================
! Other routines
!========================================
[ CheckCrystals;
  if (red_crystal in red_plinth && green_crystal in green_plinth && blue_crystal in blue_plinth)
  {
    deadflag = 2;
    "^There's a flash of bright light and a loud bang that sounds like a clap of thunder!^^You've restored ", (string)THE_TIME_CRYSTALS_OF_CYTHII, " to their rightful place in the time tower. In doing so, the time distortions have been rectified and you've saved the universe from any further major disasters...at least for the time being. Well done! If the inscription on the wall is correct, then you'll be blessed for eternity.^^Fortunately for you, your parents haven't arrived home yet, so they won't know anything about your escape from some of the most famous disasters in history or the disaster of the time crystals being stolen in the first place! You're looking a bit bedraggled after your adventures in time, so get yourself cleaned up before they get home.";
  }
  rfalse;
];

[ DirectionsParseName _parse i _w;
  _parse = parse + 4 * wn - 2;
  _w = _parse-->0;
  @je _w 'out' ?matched_out;
  @je _w 'in' ?matched_in;
  @je _w 'd//' 'down' ?matched_d;
  @je _w 'floor' 'ground' ?matched_d;
  @je _w 'u//' 'up' ?matched_u;
  #Ifdef OPTIONAL_SHIP_DIRECTIONS;
  if (ship_directions_enabled)
  {
    @je _w 'p//' 'port' ?matched_w;
    @je _w 's//' 'sb' 'starboard' ?matched_e;
    @je _w 'a//' 'aft' ?matched_s;
    @je _w 'f//' 'fore' 'forward' ?matched_n;
    @je _w 'w//' 'west' ?matched_invalid;
    @je _w 'e//' 'east' ?matched_invalid;
    @je _w 'south' ?matched_invalid;
    @je _w 'n//' 'north' ?matched_invalid;
  }
  #Endif; !OPTIONAL_SHIP_DIRECTIONS
  #Ifdef OPTIONAL_FULL_DIRECTIONS;
  @je _w 'sw' 'southwest' ?matched_sw;
  @je _w 'se' 'southeast' ?matched_se;
  @je _w 'nw' 'northwest' ?matched_nw;
  @je _w 'ne' 'northeast' ?matched_ne;
  #Endif; !OPTIONAL_FULL_DIRECTIONS
  @je _w 'w//' 'west' ?matched_w;
  @je _w 'e//' 'east' ?matched_e;
  @je _w 's//' 'south' ?matched_s;
  @je _w 'n//' 'north' ?matched_n;
  #Ifdef OPTIONAL_SHIP_DIRECTIONS;
  @je _w 'p//' 'port' ?matched_invalid;
  @je _w 'sb' 'starboard' ?matched_invalid;
  @je _w 'a//' 'aft' ?matched_invalid;
  @je _w 'f//' 'fore' 'forward' ?matched_invalid;
  #Endif; !OPTIONAL_SHIP_DIRECTIONS
  return 0;
  .matched_invalid;
    @inc i;
  .matched_out;
    @inc i;
  .matched_in;
    @inc i;
  .matched_d;
    @inc i;
  .matched_u;
    @inc i;
  #Ifdef OPTIONAL_FULL_DIRECTIONS;
  .matched_sw;
    @inc i;
  .matched_se;
    @inc i;
  .matched_nw;
    @inc i;
  .matched_ne;
    @inc i;
  #Endif; !OPTIONAL_FULL_DIRECTIONS
  .matched_w;
    @inc i;
  .matched_e;
    @inc i;
  .matched_s;
    @inc i;
  .matched_n;
    @inc i;
  selected_direction_index = i;
  selected_direction = direction_properties_array -> selected_direction_index;
  return 1;
];

[ HandsFree obj count;
  count = 0;
  objectloop (obj in player)
    if (obj hasnt worn)
      count++;
  if (count == 0)
    rtrue;
  else
    rfalse;
];

[ LowerCase c; ! for ZSCII matching ISO 8859-1
  switch (c)
  {
    'A' to 'Z': c = c + 32;
    202, 204, 212, 214, 221: c--;
    217, 218: c = c - 2;
    158 to 160, 167, 168, 208 to 210: c = c - 3;
    186 to 190, 196 to 200: c = c - 5 ;
    175 to 180: c = c - 6;
  }
  return c;
];

[ ShowTutorial i;
  if (tutorial && tutorial_used->i == 0)
  {
    tutorial_used->i = 1;
    tutorial_shown = 1;
    switch (i)
    {
      TUT_LOOK:
        tutorial_shown = 0;
        print_ret (italic)"^[The description above tells you where you are and what you can see. The '>' below is the prompt. You type commands after the prompt. When the location description scrolls off the screen, you can refresh it by typing LOOK (or L). Try it now. Type L after the prompt.]";
      TUT_EXAMINE_ME:
        print_ret (italic)"^[When you start a new game, it's a good idea to EXAMINE or LOOK AT yourself. EXAMINE can be abbreviated to X. Try X ME.]";
      TUT_INVENTORY:
        print_ret (italic)"^[When you start a new game, it's also a good idea to take an inventory to see if you're carrying anything. Try INVENTORY (or I).]";
      TUT_EXAMINE_WATCH:
        print_ret (italic)"^[You can take a closer look at anything you're carrying or wearing using EXAMINE (or X). Try X WATCH.]";
      TUT_EXAMINE:
        print (italic)"^[Whenever you enter a new location, you should identify all the things mentioned in the description and EXAMINE (or X) each one. The responses may provide more details or important clues. Try it now.";
        if (location == room01)
          print (italic)" As you're in the domed room, try X ROOM, X INSCRIPTION, X STAIRWAY and X each of the plinths.";
        print_ret (italic)"]";
      TUT_READ:
        print_ret (italic)"^[The response will sometimes provide a clue for something else that you should try. In this case, try READ INSCRIPTION.]";
      TUT_TAKE:
        print_ret (italic)"^[When you find an object that appears to be portable, you can pick it up using GET or TAKE. Try GET CLOTH.]";
      TUT_DROP:
        print_ret (italic)"^[When you're finished with an object, you can drop it again. Try DROP CLOTH, as you won't need it again.]";
      TUT_DATE:
        print_ret (italic)"^[Your watch tells you the time, which is also shown in the status bar. Your watch also tells you the date. This will prove useful if you find yourself in another time period.]";
      TUT_PUT_CRYSTAL:
        print_ret (italic)"^[This is clearly where one of the crystals needs to be placed, but you'll have to find it first. When you've found one, use a command like PUT RED CRYSTAL ON RED PLINTH. This form of command works for any flat surfaces, like tables and chairs.]";
      TUT_MOVEMENT:
        print_ret (italic)"^[When you're on land, you can move around using the cardinal compass directions NORTH, SOUTH, EAST and WEST. These can be abbreviated to N, S, E and W. When you're on a ship or aircraft, you can move around using the nautical directions, FORE, AFT, PORT and STARBOARD (F, A, P and S). You can go up and down using UP and DOWN (U and D). The location description will tell you which directions you can go. You can also use verbs like IN, OUT, ENTER, EXIT and CLIMB when appropriate. When you've finished examining everything in this location, try a few of the directions to see what happens.]";
      TUT_SAVE:
        print_ret (italic)"[When you first enter a new time period, it may be a good idea to save the game in case you get killed or run out of time and need to restart this part of the game. To do that, enter SAVE. You can later restore the saved game using RESTORE.]^";
      TUT_TIME_LEFT:
        print_ret (italic)"^[After passing through a time warp, you'll need to work out where you are. Once you've done so, the game will tell you how much time you've got left in that time period, as it's done above. If you're running out of time, you can go back to the time tower and return later. Every time you enter a time period, the time for that time period is reset.]";
      TUT_TALK:
        print_ret (italic)"^[When you meet another character in the game, apart from examining them, you should also try talking to them. Try TALK TO <character>.]";
      TUT_ASK:
        print_ret (italic)"^[As well as talking to other characters, you can also ask them about various things. Try asking them about themselves and anything interesting that they mention. For example, ASK <character> ABOUT <topic>. If there's only one character present, you can omit the character from the command. For example, ASK ABOUT <topic>.]";
      TUT_UNDO:
        print_ret (italic)"^[Whoops, that was a mistake. If you get killed, you can always UNDO to go back one move. Try it now. Type UNDO when asked if you'd like to restart.]";
      TUT_HELP_HINT:
        print_ret (italic)"^[Type HELP for a quick reminder of the main commands or HINT if you get stuck. The tutorial will continue to offer occasional suggestions.]";
      TUT_INVENTORY_FULL:
        print_ret (italic)"^[You can only carry ten objects, not counting worn objects or objects in containers. Try dropping objects that you no longer need.]";
    }
  }
  rtrue;
];

[ TimeOfDay hours mins pm;
  hours = (the_time + 1) / 60;
  if (hours > 11)
  {
    hours = hours - 12;
    pm = true;
  }
  if (hours == 0)
    hours = 12;
  mins = (the_time + 1) % 60;
  print hours, ":", mins/10, mins%10, " ";
  if (pm)
    print "p.m.";
  else
    print "a.m.";
];

[ UpperCase c; ! for ZSCII matching ISO 8859-1
  switch (c)
  {
    'a' to 'z': c = c - 32;
    201, 203, 211, 213, 220: c++;
    215, 216: c = c + 2;
    155 to 157, 164, 165, 205 to 207: c = c + 3;
    181 to 185, 191 to 195: c = c + 5 ;
    169 to 174: c = c + 6;
  }
  return c;
];

!========================================
! Grammar
!========================================
Extend 'ask'
  * 'about' topic -> AskAbout;

Extend 'blow' replace
  * noun -> Blow
  * 'on'/'onto' noun -> Blow
  * 'out' noun -> Extinguish
  * noun 'out' -> Extinguish;

Extend 'cut' replace
  * noun -> Cut
  * 'off' noun -> Cut
  * noun 'off' -> Cut
  * noun 'with' held -> Cut
  * 'off' noun 'with' held -> Cut
  * noun 'off' 'with' held -> Cut;

Extend 'jump' replace
  * -> Jump
  * noun -> JumpOver
  * 'over'/'across' noun -> JumpOver
  * 'in'/'into' noun -> Enter
  * 'on'/'onto' noun -> JumpOn
  * 'out' 'of'/'from' noun -> Exit
  * 'off' noun -> Exit;

Extend 'lock' first
  * noun -> Lock;

Extend 'look'
  * 'behind' noun -> LookBehind
  * 'into' noun -> Search
  * 'out'/'through' noun -> LookThrough
  * 'under' noun -> LookUnder;

Extend 'open' replace
  * noun -> Open
  * noun 'with' held -> Open;

Extend 'pry' replace
  * noun -> Attack
  * 'apart'/'open' noun -> Attack
  * noun 'apart'/'open' -> Attack
  * noun 'with' held -> Attack
  * 'apart'/'open' noun 'with' held -> Attack
  * noun 'apart'/'open' 'with' held -> Attack;

Extend only 'put' first
  * noun 'over' noun -> PutOn
  * 'out' noun -> Extinguish
  * noun 'out' -> Extinguish;

Extend 'read' first
  * noun -> Read;

Extend only 'say' first
  * topic -> Say;

Extend only 'screw' replace
  * noun -> Screw
  * noun 'on'/'onto' -> Screw
  * noun 'on'/'onto' noun -> Screw
  * 'on' noun -> Screw
  * 'on' noun 'on'/'onto' noun -> Screw
  * noun 'off' -> Unscrew
  * noun 'off' noun -> Unscrew
  * 'off' noun -> Unscrew
  * 'off' noun 'off' noun -> Unscrew;

Extend only 'speak' replace
  * -> Talk
  * creature -> Talk
  * noun -> Talk
  * 'to'/'with' creature -> Talk
  * 'to'/'with' noun -> Talk
  * 'to'/'with' creature 'about' topic -> Ask
  * 'to'/'with' noun 'about' topic -> Ask;

Extend 'unlock' first
  * noun -> Unlock;

Extend only 'unscrew' replace
  * noun -> Unscrew
  * noun 'off'/'from' noun -> Unscrew;

Verb meta 'about' 'info'
  * -> About;

Verb 'count'
  * noun -> Count;

Verb meta 'credits'
  * -> Credits;

Verb 'extinguish' 'douse' 'unlight'
  * noun -> Extinguish;

Verb meta 'help' 'instructions'
  * -> Help;

Verb 'hint' 'clue'
  * -> Hint;

Verb 'inspect' = 'examine';

Verb 'melt' 'dissolve'
  * noun -> Melt
  * noun 'with' noun -> PutOn reverse;

Verb 'pat' 'pet' 'stroke' = 'touch';

Verb 'pour'
  * multiexcept 'in'/'inside'/'into' noun -> Insert
  * multiexcept 'on'/'onto' noun -> PutOn;

Verb 'reach' 'stretch'
  * -> Reach
  * noun -> Reach
  * 'for' noun -> Reach
  * noun 'with' held -> Reach
  * 'for' noun 'with' held -> Reach
  * 'in'/'into' noun -> ReachIn;

Verb 'roll' = 'push';

Verb 'slide'
  * noun -> Slide
  * noun 'open' -> Unlock
  * 'open'noun  -> Unlock
  * noun 'closed' -> Lock
  * 'closed' noun -> Lock;

Verb 'talk' 'babble' 'chat' 'communicate' 'converse' 'gab' 'gossip'
  * -> Talk
  * creature -> Talk
  * noun -> Talk
  * 'to'/'with' creature -> Talk
  * 'to'/'with' noun -> Talk
  * 'to'/'with' creature 'about' topic -> Ask
  * 'to'/'with' noun 'about' topic -> Ask;

Verb meta 'tutorial'
  * -> Tutorial
  * 'on' -> TutorialOn
  * 'off' -> TutorialOff;

Verb 'untie' 'disconnect' 'detach' 'unfasten'
  * noun -> Untie
  * noun 'from' noun -> Untie;

Verb 'use'
  * noun -> Use;

Verb 'xyzzy' 'plover' 'plugh' 'yoho'
  * -> MagicWord;

!========================================
! Actions
!========================================
[ AboutSub;
  print "This program was written for Text Adventure Literacy Jam 2025. The idea came from an unpublished AdventureWriter program called 'Time Tower' written by Ken Grassham for Atari 8-bit computers in 1986.^^";
  <<Credits>>;
];

[ AskAboutSub x count npc;
  objectloop (x in location && x has animate && x ~= player)
  {
    count++;
    npc = x;
  }
  if (count == 0)
    "There's no one here to answer your questions.";
  if (count == 1)
    <<Ask npc noun>>;
  "As there are multiple characters here, you'll have to specify who to ask, e.g. ASK MAN ABOUT DOG.";
];

[ CountSub;
  if (ObjectIsUntouchable(noun))
    return;
  if (noun has pluralname)
    "There's more than one.";
  "There's only one.";
];

[ CreditsSub;
  "Concept by Ken Grassham.^Game design and coding by Garry Francis.^Play testing by Charles Moore Jr, Christopher Merriner, Dark Star, Gianluca Girelli, Jade J Aincioa, Jeff Greer, Larry Horsfield and Phil Riley.";
];

[ ExtinguishSub;
  if (ObjectIsUntouchable(noun))
    return;
  "You can't extinguish ", (ThatOrThose)noun, ".";
];

[ HelpSub;
  "Tell me what to do using simple commands starting with a verb.^^Use LOOK (or L) to refresh the location description. Identify all the objects in the description and EXAMINE (or X) each one. Read responses carefully for hints.^^Use compass directions NORTH, SOUTH, EAST and WEST (or N, S, E and W) to move around when on land or nautical directions FORE, AFT, PORT and STARBOARD (or F, A, P and S) when on board a ship. You can also use UP and DOWN (or U and D). Draw a map as you go.^^Use GET or TAKE to take objects and DROP to drop them again. Use WEAR to wear things like clothing and REMOVE to remove anything that's currently worn. Use INVENTORY (or I) to see what you're carrying and wearing.^^Use AGAIN (or G) to repeat the last command.^^Use UNDO to undo the last command if you make a mistake or get killed.^^Use SAVE to save the game and RESTORE to restore it again.^^Use QUIT to end the game or RESTART to restart from the beginning.^^There are over 100 verbs that you can use, so if something doesn't work, try a different verb or a different way of doing things. Use HINT if you get stuck.^^For full instructions, see the game page at <https://warrigal.itch.io/time-crystals-of-cythii>.";
];

[ HintSub;
  "Make sure you've examined everything and draw a map so that you don't get lost.";
];

[ JumpOnSub;
  if (noun has animate)
    "Jumping on ", (the)noun, " would achieve nothing here.";
  if (noun has enterable && noun has supporter)
    <<Enter noun>>;
  "You decide that's not such a good idea.";
];

[ LockSub k;
  if (ObjectIsUntouchable(noun))
    return;
  if (noun hasnt lockable)
  {
    PrintMsg(MSG_LOCK_NOT_A_LOCK, 'lock');
    rtrue;
  }
  if (noun has locked)
  {
    PrintMsg(MSG_LOCK_ALREADY_LOCKED);
    rtrue;
  }
  if (noun has open)
  {
    PrintMsg(MSG_LOCK_CLOSE_FIRST);
    rtrue;
  }
  k = RunRoutines(noun, with_key);
  if (k == nothing)
    "You can't see how to lock ", (ItOrThem)noun, ".";
  if (second == nothing && k ~= nothing && k in player)
  {
    second = k;
    print "(with ", (the)second, ")^";
  }
  if (second == nothing)
    "You don't have the key.";
  if (second ~= k)
  {
    PrintMsg(MSG_LOCK_KEY_DOESNT_FIT);
    rtrue;
  }
  give noun locked;
  run_after_routines_msg = MSG_LOCK_DEFAULT;
  run_after_routines_arg_1 = 'lock';
];

[ LookBehindSub;
  if (ObjectIsUntouchable(noun))
    return;
  "There's no need to look behind anything in this game.";
];

[ LookThroughSub;
  if (ObjectIsUntouchable(noun))
    return;
  "You can't look through ", (ThatOrThose)noun, ".";
];

[ LookUnderSub;
  if (location == thedark)
    "But it's dark.";
  "You find nothing of interest.";
];

[ MagicWordSub;
  "A man with thick curly hair wearing a chestnut brown frock coat and a very long striped woollen scarf appears out of nowhere. He looks around as though he's lost something. ~Have you seen a blue police phone box around here somewhere? Oh, never mind, there it is.~ He steps into the phone box and a few moments later, it disappears with a sort of ~whoo, whoo, whoo~ grinding noise.";
];

[ MeltSub;
  "You'll have to tell me how.";
];

[ ReachSub;
  if (noun == nothing)
    "You have a good stretch.";
  if (ObjectIsUntouchable(noun))
    return;
  if (second == nothing)
    <<Touch noun>>;
  if (ObjectIsUntouchable(second))
    return;
  "You reach for ", (the)noun, " with ", (the)second, ", but it's all to no avail.";
];

[ ReachInSub;
  if (noun == nothing)
    "You'll have to tell me what you want to reach into.";
  if (ObjectIsUntouchable(noun))
    return;
  if (noun hasnt container)
    "You can't reach into ", (the)noun, ", because ", (ThatOrThose)noun, " ", (IsOrAre)noun, " not a container.";
  if (noun hasnt open)
    "You can't reach into ", (the)noun, ", because ", (ThatOrThose)noun, " ", (IsOrAre)noun, " not open.";
  <<Touch noun>>;
];

[ ReadSub;
  if (ObjectIsUntouchable(noun, true))
    "I suppose you read tea leaves, too";
  "There's nothing legible on ", (ThatOrThose)noun, ".";
];

[ SaySub i;
  if (consult_words == 0)
    "You have nothing to say.";
  print "~";
  i = consult_from;
  print (firstConsultWord)i++;
  while (i < consult_from + consult_words)
    print " ", (consultWord)i++;
  print ".~^^";
  wn = consult_from;
  if (consult_words == 1 && NextWord() == 'xyzzy' or 'plover' or 'plugh' or 'yoho')
    <<MagicWord>>;
  if (AfterRoutines())
    return;
  "Nothing happens.";
];

[ ScrewSub;
  "You can't screw ", (ThatOrThose)noun, " into anything or onto anything here.";
];

[ SlideSub;
  if (ObjectIsUntouchable(noun))
    return;
  "You can't slide ", (ThatOrThose)noun, ".";
];

[ TalkSub;
  if (noun == nothing)
    "You start talking to no one in particular.";
  if (noun == player)
    "You start talking to yourself, but it's a one-sided conversation.";
  if (RunLife(noun, ##Talk))
    rtrue;
  print_ret (The)noun, " ", (IsOrAre)noun, " not very talkative.";
];

[ TutorialOffSub;
  if (~~tutorial)
    "Tutorial mode is already off.";
  tutorial = false;
  "Tutorial mode is now off.";
];

[ TutorialOnSub;
  if (tutorial)
    "Tutorial mode is already on.";
  tutorial = true;
  "Tutorial mode is now on.";
];

[ TutorialSub;
  print "Tutorial mode is currently ";
  if (tutorial)
    "on.";
  else
    "off.";
];

[ UnlockSub k;
  if (ObjectIsUntouchable(noun))
    return;
  if (noun hasnt lockable)
  {
    PrintMsg(MSG_UNLOCK_NOT_A_LOCK, 'unlock');
    rtrue;
  }
  if (noun hasnt locked)
  {
    PrintMsg(MSG_UNLOCK_ALREADY_UNLOCKED, 'unlock');
    rtrue;
  }
  k = RunRoutines(noun, with_key);
  if (k == nothing)
    "You can't see how to unlock ", (ItOrThem)noun, ".";
  if (second == nothing && k ~= nothing && k in player)
  {
    second = k;
    print "(with ", (the)second, ")^";
  }
  if (second == nothing)
    "You don't have the key.";
  if (second ~= k)
  {
    PrintMsg(MSG_UNLOCK_KEY_DOESNT_FIT);
    rtrue;
  }
  give noun ~locked;
  run_after_routines_msg = MSG_UNLOCK_DEFAULT;
  run_after_routines_arg_1 = 'unlock';
];

[ UnscrewSub;
  "You can't unscrew ", (ThatOrThose)noun, " from anything here.";
];

[ UntieSub;
  if (ObjectIsUntouchable(noun))
    return;
  "You can't untie ", (ThatOrThose)noun, ".";
];

[ UseSub;
  if (ObjectIsUntouchable(noun))
    return;
  "You'll have to be more explicit than that.";
];

End;
