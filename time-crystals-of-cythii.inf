! Settee
!----------------------------------------
Object reading_settee "one of the settees" room11
has proper scenery supporter;

!----------------------------------------
! Bow
!----------------------------------------
Object bow "bow"
with
  name 'bow' 'very' 'pretty' 'pink' 'silk',
  description "It's a very pretty bow made of pink silk.",
has clothing;

