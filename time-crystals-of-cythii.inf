class OpenContainer
with
  name 'chair' 'chairs',
  description
  [;
    print "The chairs look very opulent. ";
    <<Search self>>;
  ],
  before
  [;
    Enter:
      print_ret (string)NO_TIME_TO_LOUNGE_ABOUT;
    Receive:
      <<PutOn noun lounge_chair>>;
    Search:
      if (child(lounge_chair) == 0)
